##grflangid 0x55
##plural 0
##gender m f

#Main grf title and description
STR_GRF_NAME                    :{TITLE}
STR_GRF_DESCRIPTION             :{SILVER}2cc Trains of the World in NML (Trenes del mundo 2cc, en NML){}{}(c)2ccts{}Licencia:GPL v2 o superior.{}Consulta el archivo Léeme para detalles.
STR_GRF_URL             :https://github.com/nemethviktor/2ccts_revival

#General error messages
str_used_with_dynamic_engines           :dynamic_engines = true (opción en archivo openttd.cfg)
str_error_region                                        :No hay regiones activadas, {STRING} se ha desactivado

#parameter strings
#cost parameters
STR_PARAM_PURCHASE_COST             :Multiplicador de costos de compra
STR_PARAM_PURCHASE_COST_DESC        :Esta opción aumenta o disminuye los costos de compra de los vehículos de esta colección.
STR_PARAM_RUNNING_COST              :Multiplicador de costos de operación
STR_PARAM_RUNNING_COST_DESC         :Esta opción aumenta o disminuye los costos de operación de los vehículos de esta colección.

STR_PARAM_DIVIDE_16                 :1/16
STR_PARAM_DIVIDE_8                  :1/8
STR_PARAM_DIVIDE_4                  :1/4
STR_PARAM_DIVIDE_2                  :1/2
STR_PARAM_NORMAL                    :1 (por defecto)
STR_PARAM_TIMES_2                   :2
STR_PARAM_TIMES_4                   :4
STR_PARAM_TIMES_8                   :8
STR_PARAM_TIMES_16                  :16

#region parameters
STR_PARAM_CONCEPT                                               :Vehículos conceptuales
STR_PARAM_CONCEPT_DESC                                  :Usar vehículos conceptuales
