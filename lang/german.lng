##grflangid 0x02
##plural 0
##gender m w n p

#Main grf title and description
STR_GRF_NAME                    :{TITLE}
STR_GRF_DESCRIPTION             :{SILVER}2cc Eisenbahnen der Welt in NML{}{}(c)2ccts{}Lizenz:GPLv2 oder höher.{}Einzelheiten sind in der Readme zu lesen.
STR_GRF_URL             :https://github.com/nemethviktor/2ccts_revival

#General error messages
str_error_region                                        :Es wurden keine Regionen aktiviert, {STRING} wurde deaktiviert.

#parameter strings
#cost parameters
STR_PARAM_PURCHASE_COST             :Multiplikator für Anschaffungskosten
STR_PARAM_PURCHASE_COST_DESC        :Du kannst diesen Parameter benutzen, um die Anschaffungskosten der Fahrzeuge dieses Sets zu erhöhen oder zu verringern.
STR_PARAM_RUNNING_COST              :Multiplikator für Betriebskosten
STR_PARAM_RUNNING_COST_DESC         :Du kannst diesen Parameter benutzen, um die Betriebskosten der Fahrzeuge dieses Sets zu erhöhen oder zu verringern.

