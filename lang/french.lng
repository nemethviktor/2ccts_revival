##grflangid 0x03
##plural 2
##gender m m2 f

#Main grf title and description
STR_GRF_NAME                    :{TITLE}
STR_GRF_DESCRIPTION             :{SILVER}2cc Trains du Monde en NML{}{}(c)2ccts{}Licence:GPLv2 or plus.{}Voir le readme pour plus de détails.
STR_GRF_URL             :https://github.com/nemethviktor/2ccts_revival

#General error messages
str_used_with_dynamic_engines           :dynamic_engines = true (réglage dans openttd.cfg)
str_error_region                                        :Aucune région activée, {STRING} a été désactivé

#parameter strings
#cost parameters
STR_PARAM_PURCHASE_COST             :Multiplicateur du prix d'achat
STR_PARAM_PURCHASE_COST_DESC        :Utiliser ce paramètre pour augmenter ou diminuer le prix d'achat des véhicules de ce Set.
STR_PARAM_RUNNING_COST              :Multiplicateur des coûts de fonctionnement
STR_PARAM_RUNNING_COST_DESC         :Utiliser ce paramètre pour augmenter ou diminuer les coûts de fonctionnement des véhicules de ce Set.

STR_PARAM_DIVIDE_16                 :1/16
STR_PARAM_DIVIDE_8                  :1/8
STR_PARAM_DIVIDE_4                  :1/4
STR_PARAM_DIVIDE_2                  :1/2
STR_PARAM_NORMAL                    :1 (par défaut)
STR_PARAM_TIMES_2                   :2
STR_PARAM_TIMES_4                   :4
STR_PARAM_TIMES_8                   :8
STR_PARAM_TIMES_16                  :16

#region parameters
STR_PARAM_CONCEPT                                               :Prototypes
STR_PARAM_CONCEPT_DESC                                  :Utiliser les prototypes
STR_PARAM_REGION_AFRICA                                 :Afrique
STR_PARAM_REGION_AFRICA_DESC                    :Utiliser les véhicules d'Afrique
STR_PARAM_REGION_NORTH_AMERICA                   :Amérique du Nord
STR_PARAM_REGION_NORTH_AMERICA_DESC              :Utiliser les véhicules d'Amérique du Nord
STR_PARAM_REGION_SOUTH_AMERICA                   :Amérique du Sud
STR_PARAM_REGION_SOUTH_AMERICA_DESC              :Utiliser les véhicules d'Amérique du Sud
STR_PARAM_REGION_ASIA                                   :Asie
STR_PARAM_REGION_ASIA_DESC                              :Utiliser les véhicules d'Asie
STR_PARAM_REGION_NORTHERN_EUROPE                 :Europe du Nord
STR_PARAM_REGION_NORTHERN_EUROPE_DESC    :Utiliser les véhicules d'Europe du Nord
STR_PARAM_REGION_EASTERN_EUROPE                  :Europe de l'Est
STR_PARAM_REGION_EASTERN_EUROPE_DESC             :Utiliser les véhicules d'Europe de l'Est
STR_PARAM_REGION_SOUTHERN_EUROPE                 :Europe du Sud
STR_PARAM_REGION_SOUTHERN_EUROPE_DESC    :Utiliser les véhicules d'Europe du Sud
STR_PARAM_REGION_WESTERN_EUROPE                  :Europe de l'Ouest
STR_PARAM_REGION_WESTERN_EUROPE_DESC             :Utiliser les véhicules d'Europe de l'Ouest
STR_PARAM_REGION_OCEANIA                                :Océanie
STR_PARAM_REGION_OCEANIA_DESC                   :Utiliser les véhicules d'Océanie

#loading speed parameter
STR_PARAM_LOADINGSPEED                                  :Vitesse de chargement
STR_PARAM_LOADINGSPEED_DESC                             :Définit la vitesse à laquelle les wagons peuvent être chargés
STR_PARAM_LOADINGSPEED_SLOW                             :Basse
STR_PARAM_LOADINGSPEED_NORMAL                   :Normale (par défaut)
STR_PARAM_LOADINGSPEED_FAST                             :Élevée
STR_PARAM_LOADINGSPEED_ULTRA                    :Maximale

