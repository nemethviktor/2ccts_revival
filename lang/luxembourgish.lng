##grflangid 0x23
##plural 0

#Main grf title and description
STR_GRF_NAME                    :{TITLE}
STR_GRF_DESCRIPTION             :{SILVER}2cc Zich aus aller Welt am NML codéiert{}{}(c)2ccts{}Lizenz:GPLv2 oder méi héich.{}Lies d'Readme fir méi Detailer.
STR_GRF_URL             :https://github.com/nemethviktor/2ccts_revival

#General error messages
str_used_with_dynamic_engines           :dynamic_engines = true (Astellung an der openttd.cfg)
str_error_region                                        :Keng Regiounen ausgewielt, {STRING} ass ausgeschalt

#parameter strings
#cost parameters
STR_PARAM_PURCHASE_COST             :Multiplikator fir d'Kafpräisser
STR_PARAM_PURCHASE_COST_DESC        :Dës Astellung kann benotzt ginn fir den Akafspräis erop oder erof ze setzen.
STR_PARAM_RUNNING_COST              :Multiplikator fir d'Betribskäschten
STR_PARAM_RUNNING_COST_DESC         :Dës Astellung kann benotzt ginn fir d'Betribskäschten erop oder erof ze setzen.

