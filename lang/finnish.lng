##grflangid 0x35
##plural 0

#Main grf title and description
STR_GRF_NAME                    :{TITLE}
STR_GRF_DESCRIPTION             :{SILVER}2cc Trains of the World in NML{}{}(c)2ccts{}Lisenssi:GPLv2 tai korkeampi.{}Yksityiskohdat readme:ssa.
STR_GRF_URL             :https://github.com/nemethviktor/2ccts_revival

#General error messages
str_used_with_dynamic_engines           :dynamic_engines = true (asetus openttd.cfg -tiedostossa)
str_error_region                                        :Yhtään aluetta ei ole sallittu, {STRING} on poistettu käytöstä

#parameter strings
#cost parameters
STR_PARAM_PURCHASE_COST             :Ostohinnan kerroin
STR_PARAM_PURCHASE_COST_DESC        :Voit käyttää tätä asetusta nostamaan tai laskemaan tämän valikoiman ajoneuvojen ostohintoja.
STR_PARAM_RUNNING_COST              :Käyttökustannusten kerroin
STR_PARAM_RUNNING_COST_DESC         :Voit käyttää tätä asetusta nostamaan tai laskemaan tämän valikoiman ajoneuvojen käyttökustannuksia.

STR_PARAM_DIVIDE_16                 :1/16
STR_PARAM_DIVIDE_8                  :1/8
STR_PARAM_DIVIDE_4                  :1/4
STR_PARAM_DIVIDE_2                  :1/2
STR_PARAM_NORMAL                    :1 (oletus)
STR_PARAM_TIMES_2                   :2
STR_PARAM_TIMES_4                   :4
STR_PARAM_TIMES_8                   :8
STR_PARAM_TIMES_16                  :16

#region parameters
STR_PARAM_CONCEPT                                               :Konseptiajoneuvot (suunniteltu ominaisuus, ei vielä käytössä)
