##grflangid 0x30
##plural 7
##gender n m f
##case c b d m n w

#Main grf title and description
STR_GRF_NAME                    :{TITLE}
STR_GRF_DESCRIPTION             :{SILVER}2cc Pociągi Świata, wersja NML{}{}(c)2ccts{}Licencja:GPLv2 lub wyższa.{}Szczegóły w pliku readme.txt.
STR_GRF_URL             :https://github.com/nemethviktor/2ccts_revival

#General error messages
str_used_with_dynamic_engines           :dynamic_engines = true (ustawienie w openttd.cfg)

#parameter strings
#cost parameters
STR_PARAM_PURCHASE_COST             :Mnożnik kosztów zakupu
STR_PARAM_PURCHASE_COST_DESC        :Do zmniejszania/zwiększania kosztów zakupu pojazdów (dotyczy tylko tego setu)
STR_PARAM_RUNNING_COST              :Mnożnik kosztów utrzymania
STR_PARAM_RUNNING_COST_DESC         :Do zmniejszania/zwiększania kosztów utrzymania/amortyzacji pojazdów (dotyczy tylko tego setu)

STR_PARAM_DIVIDE_16                 :1/16
STR_PARAM_DIVIDE_8                  :1/8
STR_PARAM_DIVIDE_4                  :1/4
STR_PARAM_DIVIDE_2                  :1/2
STR_PARAM_NORMAL                    :1 (default)
STR_PARAM_TIMES_2                   :2
STR_PARAM_TIMES_4                   :4
STR_PARAM_TIMES_8                   :8
STR_PARAM_TIMES_16                  :16

#region parameters
STR_PARAM_REGION_AFRICA                                 :Afryka
STR_PARAM_REGION_AFRICA_DESC                    :Użyj pojazdów z Afryki
STR_PARAM_REGION_NORTH_AMERICA                   :Ameryka Północna
STR_PARAM_REGION_NORTH_AMERICA_DESC              :Użyj pojazdów z Ameryki Północnej
STR_PARAM_REGION_SOUTH_AMERICA                   :Ameryka Południowa
STR_PARAM_REGION_SOUTH_AMERICA_DESC              :Użyj pojazdów z Ameryki Południowej
STR_PARAM_REGION_ASIA                                   :Azja
STR_PARAM_REGION_ASIA_DESC                              :Użyj pojazdów z Azji
STR_PARAM_REGION_NORTHERN_EUROPE                 :Europa Północna
STR_PARAM_REGION_NORTHERN_EUROPE_DESC    :Użyj pojazdów z Północnej Europy
STR_PARAM_REGION_EASTERN_EUROPE                  :Europa Wschodnia
STR_PARAM_REGION_EASTERN_EUROPE_DESC             :Użyj pojazdów ze Wschodniej Europy
STR_PARAM_REGION_SOUTHERN_EUROPE                 :Europa Południowa
STR_PARAM_REGION_SOUTHERN_EUROPE_DESC    :Użyj pojazdów z Południowej Europy
STR_PARAM_REGION_WESTERN_EUROPE                  :Europa Zachodnia
STR_PARAM_REGION_WESTERN_EUROPE_DESC             :Użyj pojazdów z Europy Zachodniej
STR_PARAM_REGION_OCEANIA                                :Oceania
STR_PARAM_REGION_OCEANIA_DESC                   :Użyj pojazdów z Oceanii

#loading speed parameter
STR_PARAM_LOADINGSPEED                                  :Szybkość za/wyładunku
STR_PARAM_LOADINGSPEED_DESC                             :Ustaw szybkość za/wyładunku towarów w tym secie
STR_PARAM_LOADINGSPEED_SLOW                             :Wolna
STR_PARAM_LOADINGSPEED_NORMAL                   :Standardowa (default)
STR_PARAM_LOADINGSPEED_FAST                             :Szybka
STR_PARAM_LOADINGSPEED_ULTRA                    :Prawie natychmiastowa

