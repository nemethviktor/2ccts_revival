##grflangid 0x1b
##plural 0
##gender male

#Main grf title and description
STR_GRF_NAME                    :{TITLE}
STR_GRF_DESCRIPTION             :{SILVER}2cc Treine van die Wêreld in NML{}{}(c)2ccts{}Lisensie:GPLv2 of hoër.{}Sien readme vir meer inligting.
STR_GRF_URL             :https://github.com/nemethviktor/2ccts_revival

#General error messages
str_used_with_dynamic_engines           :dynamic_engines = waar (stelling in openttd.cfg)
str_error_region                                        :Geen streke is geaktiveer, {STRING} is gedeaktiveer

#parameter strings
#cost parameters
STR_PARAM_PURCHASE_COST             :Koop Prys vermenigvuldiger
STR_PARAM_PURCHASE_COST_DESC        :Jy kan die stellling gebruik om die koop prys van die voertuie in die stel, te verhoog of te verlaag.
STR_PARAM_RUNNING_COST              :Lopende Koster vermenigvuldiger
STR_PARAM_RUNNING_COST_DESC         :Jy kan die stellling gebruik om die bedryfskoste van die voertuie in die stel, te verhoog of te verlaag.

STR_PARAM_DIVIDE_16                 :1/16
STR_PARAM_DIVIDE_8                  :1/8
STR_PARAM_DIVIDE_4                  :1/4
STR_PARAM_DIVIDE_2                  :1/2
STR_PARAM_NORMAL                    :1 (verstek)
STR_PARAM_TIMES_2                   :2
STR_PARAM_TIMES_4                   :4
STR_PARAM_TIMES_8                   :8
STR_PARAM_TIMES_16                  :16

#region parameters
STR_PARAM_CONCEPT                                               :Konsep voertuie (toekomstige gebruik, nog nie beskikbaar nie)
