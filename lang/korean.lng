##grflangid 0x3a
##plural 11
##gender m f

#Main grf title and description
STR_GRF_NAME                    :{TITLE}
STR_GRF_DESCRIPTION             :{SILVER}NML로 작성한 세계 2cc 열차입니다.{}{}(c)2ccts{}저작권:GPLv2 이상.{}자세한 정보는 "readme.txt" 파일을 참고하세요.
STR_GRF_URL             :https://github.com/nemethviktor/2ccts_revival

#General error messages
str_used_with_dynamic_engines           :dynamic_engines = true (openttd.cfg에 있는 설정)
str_error_region                                        :선택한 지역이 하나도 없어서, {STRING}의 사용이 해제되었습니다.

#parameter strings
#cost parameters
STR_PARAM_PURCHASE_COST             :구입 가격 배수
STR_PARAM_PURCHASE_COST_DESC        :이 NewGRF에 포함된 차량의 구입 비용을 증가시키거나 감소시키려면 이 설정을 변경하십시오. 이 설정은 기본 차량과 비교했을 때 차량의 구입 비용을 지나치게 불균형하게 만들 수 있음을 염두에 두십시오.
STR_PARAM_RUNNING_COST              :유지비 조정 배수
STR_PARAM_RUNNING_COST_DESC         :이 NewGRF에 포함된 차량의 유지 비용을 증가시키거나 감소시키려면 이 설정을 변경하십시오.

STR_PARAM_DIVIDE_16                 :1/16
STR_PARAM_DIVIDE_8                  :1/8
STR_PARAM_DIVIDE_4                  :1/4
STR_PARAM_DIVIDE_2                  :1/2
STR_PARAM_NORMAL                    :1 (기본)
STR_PARAM_TIMES_2                   :2
STR_PARAM_TIMES_4                   :4
STR_PARAM_TIMES_8                   :8
STR_PARAM_TIMES_16                  :16

#region parameters
STR_PARAM_CONCEPT                                               :콘셉트 차량
STR_PARAM_CONCEPT_DESC                                  :콘셉트 차량을 사용합니다.
STR_PARAM_REGION_AFRICA                                 :아프리카
STR_PARAM_REGION_AFRICA_DESC                    :아프리카 차량을 사용합니다.
STR_PARAM_REGION_NORTH_AMERICA                   :북아메리카
STR_PARAM_REGION_NORTH_AMERICA_DESC              :북아메리카 차량을 사용합니다.
STR_PARAM_REGION_SOUTH_AMERICA                   :남아메리카
STR_PARAM_REGION_SOUTH_AMERICA_DESC              :남아메리카 차량을 사용합니다.
STR_PARAM_REGION_ASIA                                   :아시아
STR_PARAM_REGION_ASIA_DESC                              :아시아 차량을 사용합니다.
STR_PARAM_REGION_NORTHERN_EUROPE                 :북유럽
STR_PARAM_REGION_NORTHERN_EUROPE_DESC    :북유럽 차량을 사용합니다.
STR_PARAM_REGION_EASTERN_EUROPE                  :동유럽
STR_PARAM_REGION_EASTERN_EUROPE_DESC             :동유럽 차량을 사용합니다.
STR_PARAM_REGION_SOUTHERN_EUROPE                 :남유럽
STR_PARAM_REGION_SOUTHERN_EUROPE_DESC    :남유럽 차량을 사용합니다.
STR_PARAM_REGION_WESTERN_EUROPE                  :서유럽
STR_PARAM_REGION_WESTERN_EUROPE_DESC             :서유럽 차량을 사용합니다.
STR_PARAM_REGION_OCEANIA                                :오세아니아
STR_PARAM_REGION_OCEANIA_DESC                   :오세아니아 차량을 사용합니다.

#loading speed parameter
STR_PARAM_LOADINGSPEED                                  :적재 속도
STR_PARAM_LOADINGSPEED_DESC                             :이 세트의 적재 속도를 설정합니다.
STR_PARAM_LOADINGSPEED_SLOW                             :느리게
STR_PARAM_LOADINGSPEED_NORMAL                   :보통 (기본)
STR_PARAM_LOADINGSPEED_FAST                             :빠름
STR_PARAM_LOADINGSPEED_ULTRA                    :가능한 한 빠르게

