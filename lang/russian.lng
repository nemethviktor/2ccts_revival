##grflangid 0x07
##plural 6
##gender m f n p
##case abl acc dat f gen m n nom p pre

#Main grf title and description
STR_GRF_NAME                    :{TITLE}
STR_GRF_DESCRIPTION             :{SILVER}2cc Поезда Мира в NML{}{}(c)2ccts{}Лицензия:GPLv2 или выше.{}Смотрите readme с описанием детальной работы данного NewGRF.
STR_GRF_URL             :https://github.com/nemethviktor/2ccts_revival

#General error messages
str_used_with_dynamic_engines           :dynamic_engines = true (настройка в openttd.cfg)

#parameter strings
#cost parameters
STR_PARAM_PURCHASE_COST             :Множитель цены покупки
STR_PARAM_PURCHASE_COST_DESC        :Эта настройка позволяет увеличивать или понижать стоимость покупки поездов и вагонов для данного набора.
STR_PARAM_RUNNING_COST_DESC         :Эта настройка позволяет увеличивать или понижать стоимость использования поездов и вагонов для данного набора.

STR_PARAM_DIVIDE_16                 :1/16
STR_PARAM_DIVIDE_8                  :1/8
STR_PARAM_DIVIDE_4                  :1/4
STR_PARAM_DIVIDE_2                  :1/2
STR_PARAM_NORMAL                    :1 (по умолчанию)
STR_PARAM_TIMES_2                   :2
STR_PARAM_TIMES_4                   :4
STR_PARAM_TIMES_16                  :16

#region parameters
STR_PARAM_CONCEPT                                               :Консептуальные поезда (из будущего, на данный момент не существующие)
STR_PARAM_CONCEPT_DESC                                  :Использовать консептуальные поезда (этот параметер на данный момент ничего не делает)
STR_PARAM_REGION_AFRICA                                 :Африка
STR_PARAM_REGION_AFRICA_DESC                    :Использовать поезда из Африки
STR_PARAM_REGION_NORTH_AMERICA                   :Северная Америка
STR_PARAM_REGION_NORTH_AMERICA_DESC              :Использовать поезда из Северной Америки
STR_PARAM_REGION_SOUTH_AMERICA                   :Южная Америка
STR_PARAM_REGION_SOUTH_AMERICA_DESC              :Использовать поезда из Южной Америки
STR_PARAM_REGION_ASIA                                   :Азия
STR_PARAM_REGION_ASIA_DESC                              :Использовать поезда из Азии
STR_PARAM_REGION_NORTHERN_EUROPE                 :Северная Европа
