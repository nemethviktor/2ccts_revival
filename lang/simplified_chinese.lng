##grflangid 0x56
##plural 1

#Main grf title and description
STR_GRF_NAME                    :{TITLE}
STR_GRF_DESCRIPTION             :{SILVER}2cc世界列车扩展包(NML版){}{}(c)2ccts{}License:GPLv2 or higher.{}参见readme获取更多信息.
STR_GRF_URL             :https://github.com/nemethviktor/2ccts_revival

#General error messages
str_used_with_dynamic_engines           :dynamic_engines = true (在openttd.cfg内设置)
str_error_region                                        :未激活地区分区, {STRING} 已禁用

#parameter strings
#cost parameters
STR_PARAM_PURCHASE_COST             :采购费用加倍
STR_PARAM_PURCHASE_COST_DESC        :此参数可以提高或降低车辆采购费用。
STR_PARAM_RUNNING_COST              :营运费用加倍
STR_PARAM_RUNNING_COST_DESC         :此参数可以提高或降低车辆营运费用。

STR_PARAM_DIVIDE_16                 :1/16
STR_PARAM_DIVIDE_8                  :1/8
STR_PARAM_DIVIDE_4                  :1/4
STR_PARAM_DIVIDE_2                  :1/2
STR_PARAM_NORMAL                    :1 (默认)
STR_PARAM_TIMES_2                   :2
STR_PARAM_TIMES_4                   :4
STR_PARAM_TIMES_8                   :8
STR_PARAM_TIMES_16                  :16

#region parameters
STR_PARAM_CONCEPT                                               :概念车型
STR_PARAM_CONCEPT_DESC                                  :使用概念车型
STR_PARAM_REGION_AFRICA                                 :非洲
STR_PARAM_REGION_AFRICA_DESC                    :使用非洲车辆
STR_PARAM_REGION_NORTH_AMERICA                   :北美
STR_PARAM_REGION_NORTH_AMERICA_DESC              :使用北美车辆
STR_PARAM_REGION_SOUTH_AMERICA                   :南美
STR_PARAM_REGION_SOUTH_AMERICA_DESC              :使用南美车辆
STR_PARAM_REGION_ASIA                                   :亚洲
STR_PARAM_REGION_ASIA_DESC                              :使用亚洲车辆
STR_PARAM_REGION_NORTHERN_EUROPE                 :北欧
STR_PARAM_REGION_NORTHERN_EUROPE_DESC    :使用北欧车辆
STR_PARAM_REGION_EASTERN_EUROPE                  :东欧
STR_PARAM_REGION_EASTERN_EUROPE_DESC             :使用东欧车辆
STR_PARAM_REGION_SOUTHERN_EUROPE                 :南欧
STR_PARAM_REGION_SOUTHERN_EUROPE_DESC    :使用南欧车辆
STR_PARAM_REGION_WESTERN_EUROPE                  :西欧
STR_PARAM_REGION_WESTERN_EUROPE_DESC             :使用西欧车辆
STR_PARAM_REGION_OCEANIA                                :大洋洲
STR_PARAM_REGION_OCEANIA_DESC                   :使用大洋洲车辆

#loading speed parameter
STR_PARAM_LOADINGSPEED                                  :装载速度
STR_PARAM_LOADINGSPEED_DESC                             :设置该套机组的装载速度
STR_PARAM_LOADINGSPEED_SLOW                             :慢
STR_PARAM_LOADINGSPEED_NORMAL                   :正常 (默认)
STR_PARAM_LOADINGSPEED_FAST                             :快
STR_PARAM_LOADINGSPEED_ULTRA                    :尽可能快

