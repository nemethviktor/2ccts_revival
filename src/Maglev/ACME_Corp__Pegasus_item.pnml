item(FEAT_TRAINS, item_mglv_acme_corp__pegasus) {
    property {
        name: string(str_mglv_acme_corp__pegasus);
        climates_available: (((param_region_africa || (param_region_north_america || param_region_south_america) || param_region_asia || (param_region_northern_europe || param_region_eastern_europe || param_region_southern_europe || param_region_western_europe) || param_region_oceania) || 0) && param_concept) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2010,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 136.57;
        running_cost_factor: 114.63;
        speed: 480 km/h;
        power: 15000 hp;
        cargo_capacity: 0;
        weight: 130 ton;
        tractive_effort_coefficient: 0.627;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [MGLV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/africa", "region/asia", "region/america/northern", "region/america/south", "region/europe/southern", "region/europe/western", "region/europe/eastern", "region/europe/northern", "region/oceania", "power/maglev", "role/ultra_high_speed__universal_"];

    }
    graphics {
        purchase: spriteset_mglv_acme_corp__pegasus_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: spriteset_mglv_acme_corp__pegasus;
    }
}
