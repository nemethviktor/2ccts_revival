/*
* PURCHASE
*/

spriteset(spriteset_mglv_Japan_MLX01_901_purchase, "gfx/Maglev/Japan_MLX01_901.png") {
	template_purchase_dualheaded(1, 128)
}

/*
* VEHICLE
*/

//Front
spriteset(spriteset_mglv_Japan_MLX01_901_front, "gfx/Maglev/Japan_MLX01_901.png") {
	template_2cc_engines_general(1, 1)
}

//Back
spriteset(spriteset_mglv_Japan_MLX01_901_back, "gfx/Maglev/Japan_MLX01_901.png") {
	template_2cc_engines_general(1, 32)
}

//Middle - PAX
spriteset(spriteset_mglv_Japan_MLX01_901_middlepass, "gfx/Maglev/Japan_MLX01_901.png") {
	template_2cc_engines_general(1, 64)
}
//Middle - MAIL
spriteset(spriteset_mglv_Japan_MLX01_901_middlemail, "gfx/Maglev/Japan_MLX01_901.png") {
	template_2cc_engines_general(1, 96)
}

//Dualheaded engines
switch(FEAT_TRAINS, SELF, switch_mglv_Japan_MLX01_901_reversed, var[0xC8]) {
	0xFE: spriteset_mglv_Japan_MLX01_901_back;
    0xFF: spriteset_mglv_Japan_MLX01_901_back; 
    spriteset_mglv_Japan_MLX01_901_front;
}

/*
* Cargo capacity
*/

ENGINECAPACITYSWITCH(VEHIDCODE)

WAGONCAPACITYSWITCH(VEHIDCODE)

//Graphics for the unit wagon based on cargo class
switch(FEAT_TRAINS, SELF, switch_mglv_Japan_MLX01_901_cargo_selection, cargo_classes){
	bitmask(CC_PASSENGERS): spriteset_mglv_Japan_MLX01_901_middlepass;
	spriteset_mglv_Japan_MLX01_901_middlemail;
}

//Add defined switches

RUNNINGCOSTENGINESWITCH

PURCHASETEXTSWITCH