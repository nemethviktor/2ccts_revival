// =========================================================================
// 1. SUB-SWITCHES: EVALUATING WHAT WAGON IS IN THE HAND (PARENT CONTEXT)
// =========================================================================

/// Filter for what can attach to traditional Steam/Diesel/Electric Locomotives
switch(FEAT_TRAINS, PARENT, switch_attach_to_traditional, [STORE_TEMP(position_in_consist_from_end, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
	ID_RANGE_STEAM: 					CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
	ID_RANGE_DIESEL: 					CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
	ID_RANGE_ELECTRIC: 					CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
	ID_RANGE_MAGLEV: 					CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
	ID_RANGE_COACHES:          			CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
    ID_RANGE_WAGONS:           			CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;

    CB_RESULT_ATTACH_DISALLOW; 
}

/// Filter for what can attach behind passenger DMUs / EMUs
switch(FEAT_TRAINS, PARENT, switch_attach_to_passenger_mu, [STORE_TEMP(position_in_consist_from_end, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
	ID_RANGE_DMU: 		                CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
    ID_RANGE_EMU: 		                CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
    ID_RANGE_UNIT_WAGONS_RAIL: 			CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;

    CB_RESULT_ATTACH_DISALLOW; 
}

/// Filter for what can attach behind Metro consists
switch(FEAT_TRAINS, PARENT, switch_attach_to_metro, [STORE_TEMP(position_in_consist_from_end, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
	ID_RANGE_MULTIMETRO: 				CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
    ID_RANGE_UNIT_WAGONS_MTRO: 			CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;

    CB_RESULT_ATTACH_DISALLOW; 
}

/// Filter for what can attach behind Maglev MU sets (e.g., Chimaera)
switch(FEAT_TRAINS, PARENT, switch_attach_to_maglev_mu, [STORE_TEMP(position_in_consist_from_end, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
	ID_RANGE_MMU: 						CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
    ID_RANGE_UNIT_WAGONS_MGLV: 			CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;

    CB_RESULT_ATTACH_DISALLOW;
}

/// Filter for what can attach behind standard Maglev engines
switch(FEAT_TRAINS, PARENT, switch_attach_to_maglev_loco, [STORE_TEMP(position_in_consist_from_end, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
    ID_RANGE_MAGLEV:           CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
	ID_RANGE_COACHES_MGLV:     CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
    ID_RANGE_WAGONS_MGLV:      CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
    CB_RESULT_ATTACH_DISALLOW;
}

/// Filter for what can attach behind high-speed Freight MUs (CargoSprinter/M250)
switch(FEAT_TRAINS, PARENT, switch_attach_to_cargo_mu, [STORE_TEMP(position_in_consist_from_end, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
    ID_RANGE_UNIT_WAGONS_RAIL_CARGO: CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
    CB_RESULT_ATTACH_DISALLOW;
}


// =========================================================================
// 2. MASTER ENTRY SWITCH: EVALUATING THE TRAIN ON THE RAILS (SELF CONTEXT)
// =========================================================================

switch(FEAT_TRAINS, SELF, switch_can_attach_vehicle, vehicle_type_id) {
    // If the trailing vehicle on the tracks is a standard locomotive or standard wagon:
    ID_RANGE_STEAM:            switch_attach_to_traditional;
    ID_RANGE_DIESEL:           switch_attach_to_traditional;
    ID_RANGE_ELECTRIC:         switch_attach_to_traditional;
    ID_RANGE_COACHES:          switch_attach_to_traditional;
    ID_RANGE_WAGONS:           switch_attach_to_traditional;

    // If the trailing vehicle on the tracks is a Passenger MU:
    ID_RANGE_DMU:              switch_attach_to_passenger_mu;
    ID_RANGE_EMU:              switch_attach_to_passenger_mu;
    ID_RANGE_UNIT_WAGONS_RAIL: switch_attach_to_passenger_mu;

    // If the trailing vehicle on the tracks is a Metro set:
    ID_RANGE_MULTIMETRO:       switch_attach_to_metro;
    ID_RANGE_UNIT_WAGONS_MTRO: switch_attach_to_metro;

    // If the trailing vehicle on the tracks is a Maglev Engine or Maglev Coach/Wagon:
    ID_RANGE_MAGLEV:           switch_attach_to_maglev_loco;
    ID_RANGE_COACHES_MGLV:     switch_attach_to_maglev_loco;
    ID_RANGE_WAGONS_MGLV:      switch_attach_to_maglev_loco;

    // If the trailing vehicle on the tracks is a Maglev MU:
    ID_RANGE_MMU:              switch_attach_to_maglev_mu;
    ID_RANGE_UNIT_WAGONS_MGLV: switch_attach_to_maglev_mu;

    // If the trailing vehicle on the tracks is a Cargo MU:
    ID_RANGE_CARGODMU:               switch_attach_to_cargo_mu;
    ID_RANGE_CARGOEMU:               switch_attach_to_cargo_mu;
    ID_RANGE_UNIT_WAGONS_RAIL_CARGO: switch_attach_to_cargo_mu;

    // Direct Locomotive Stacking Rules (If dropping a standalone engine onto another engine)
    ID_RANGE_RBS:         CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
    ID_RANGE_RBD:         CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
    ID_RANGE_RBE:         CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
    ID_RANGE_RBM:         CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
    ID_RANGE_SINGLEMETRO: CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;

    // Default fallback
    CB_RESULT_ATTACH_ALLOW_IF_RAILTYPES;
}