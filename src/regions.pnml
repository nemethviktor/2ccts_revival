//this file is used to define the region availability of vehicles.

//Define regions and their matching parameters
#define AFRICA param_region_africa

#define NORTH_AMERICA param_region_north_america
#define SOUTH_AMERICA param_region_south_america

#define ASIA param_region_asia

#define NORTHERN_EUROPE param_region_northern_europe
#define EASTERN_EUROPE param_region_eastern_europe
#define WESTERN_EUROPE param_region_western_europe
#define SOUTHERN_EUROPE param_region_southern_europe

#define OCEANIA param_region_oceania

//Helper regions, which can be used as short hand notation for multiple regions
#define ALL_EUROPE ( NORTHERN_EUROPE || EASTERN_EUROPE || SOUTHERN_EUROPE || WESTERN_EUROPE )
#define ALL_AMERICA ( NORTH_AMERICA || SOUTH_AMERICA )

#define REGIONTYPE1 ( ALL_EUROPE || ASIA || AFRICA )
#define REGIONTYPE2 ( ALL_AMERICA || ASIA || OCEANIA || AFRICA )
#define REGIONTYPE3 ( ASIA || OCEANIA )

#define NO_REGION 0
#define ALL_REGION ( AFRICA || ALL_AMERICA || ASIA || ALL_EUROPE || OCEANIA )

//Also allow to disable concept vehicles
#define IS_CONCEPT param_concept

#define NO_CONCEPT 1
