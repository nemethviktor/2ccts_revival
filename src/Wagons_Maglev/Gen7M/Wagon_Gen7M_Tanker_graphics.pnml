}

switch(FEAT_TRAINS, SELF, switch_mglv_wagon_gen7m_tanker_cargo_selection, cargo_type_in_veh) {
	OIL_: switch_mglv_wagon_gen7m_tanker_oil_livery_selection;
	PETR: switch_mglv_wagon_gen7m_tanker_oil_livery_selection;
	RFPR: switch_mglv_wagon_gen7m_tanker_oil_livery_selection;
    // GOOD, RUBR, WATR, COLA, PLST, BEER, DYES, MILK, PLAS
	switch_mglv_wagon_gen7m_tanker_standard_livery;
}
