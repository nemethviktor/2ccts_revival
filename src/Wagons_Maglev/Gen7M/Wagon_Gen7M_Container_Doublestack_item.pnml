// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_mglv_Wagon_Gen7M_Container_Doublestack_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 75/2; \
        bitmask(CC_ARMOURED): 75/4; \
        75; \
    }


    switch(FEAT_TRAINS, SELF, switch_mglv_Wagon_Gen7M_Container_Doublestack_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

item(FEAT_TRAINS, item_mglv_Wagon_Gen7M_Container_Doublestack) {
    property {
        name: string(str_mglv_Wagon_Gen7M_Container_Doublestack);
        climates_available: (((param_region_africa || (param_region_north_america || param_region_south_america) || param_region_asia || (param_region_northern_europe || param_region_eastern_europe || param_region_southern_europe || param_region_western_europe) || param_region_oceania) || 0) && param_concept) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2000,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 39.06957;
        running_cost_factor: 37.56391;
        speed: 160 km/h;
        power: 0 hp;
        cargo_capacity: 75;
        weight: 25 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PIECE_GOODS, CC_EXPRESS, CC_REFRIGERATED);non_refittable_cargo_classes: 0;cargo_allow_refit: [GOOD, PAPR, FOOD, FRUT, TOYS, BATT, SWET, BUBL, FZDR, BDMT, BRCK, CERA, CERE, COPR, ENSP, FERT, FICR, FISH, FMSP, GLAS, JAVA, MNSP, RCYC, VPTS, WDPR, WOOL, URAN];cargo_disallow_refit: [PASS, MAIL, TOUR, COAL, OIL_, LVST, GRAI, WOOD, IORE, STEL, VALU, WHEA, GOLD, RUBR, MAIZ, CORE, WATR, DIAM, SUGR, TOFF, COLA, CTCD, PLST, AORE, BEER, CLAY, CMNT, DYES, GRVL, LIME, MILK, OLSD, PETR, PLAS, POTA, RFPR, SAND, SCMT, SGBT, SGCN, SULP, VEHI, YETI, YETY];
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_AUTOREFIT);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_CARGO;
        track_type: [MGLV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_mglv_Wagon_Gen7M_Container_Doublestack_purchase;
        cargo_capacity: switch_mglv_Wagon_Gen7M_Container_Doublestack_capacity_engine;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        // no 'can_attach'
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_mglv_Wagon_Gen7M_Container_Doublestack_cargo_selection;
    }
}
