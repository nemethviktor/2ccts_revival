/*
* PURCHASE
*/

spriteset(spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_purchase, "gfx/Wagons_Maglev/Gen7M/Wagon_Gen7M_Superheavy_Flatcar_Purchase.png") {
	template_purchase_wagon(1, 1)
}

/*
* VEHICLE
*/

//Front
spriteset(spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_front, "gfx/Wagons_Maglev/Gen7M/Wagon_Gen7M_Superheavy_Flatcar.png") {
	template_2cc_wagons(1, 1)
}

//Back
spriteset(spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_back, "gfx/Wagons_Maglev/Gen7M/Wagon_Gen7M_Superheavy_Flatcar.png") {
	template_2cc_wagons(1, 64)
}

//Middle - Empty
spriteset(spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_empty, "gfx/Wagons_Maglev/Gen7M/Wagon_Gen7M_Superheavy_Flatcar.png") {
	template_2cc_wagons(1, 32)
}

//Middle - L1
spriteset(spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L1, "gfx/Wagons_Maglev/Gen7M/Wagon_Gen7M_Superheavy_Flatcar.png") {
	template_2cc_wagons(1, 126)
}

spritegroup spritegroup_wagon_Gen7M_Superheavy_Flatcar_middle_L1 {
	loading: [spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_empty, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L1, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L1];
	loaded: [spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_empty, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L1, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L1];
}

//Middle - L2
spriteset(spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L2, "gfx/Wagons_Maglev/Gen7M/Wagon_Gen7M_Superheavy_Flatcar.png") {
	template_2cc_wagons(179,126)
}

spritegroup spritegroup_wagon_Gen7M_Superheavy_Flatcar_middle_L2 {
	loading: [spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_empty, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L2, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L2];
	loaded: [spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_empty, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L2, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L2];
}

//Middle - L3
spriteset(spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L3, "gfx/Wagons_Maglev/Gen7M/Wagon_Gen7M_Superheavy_Flatcar.png") {
	template_2cc_wagons(357,126)
}

spritegroup spritegroup_wagon_Gen7M_Superheavy_Flatcar_middle_L3 {
	loading: [spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_empty, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L3, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L3];
	loaded: [spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_empty, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L3, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L3];
}

//Middle - L4
spriteset(spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L4, "gfx/Wagons_Maglev/Gen7M/Wagon_Gen7M_Superheavy_Flatcar.png") {
	template_2cc_wagons(535,126)
}

spritegroup spritegroup_wagon_Gen7M_Superheavy_Flatcar_middle_L4 {
	loading: [spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_empty, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L4, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L4];
	loaded: [spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_empty, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L4, spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_L4];
}

random_switch(FEAT_TRAINS, SELF, switch_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_livery) {
	7: spritegroup_wagon_Gen7M_Superheavy_Flatcar_middle_L1;
	1: spritegroup_wagon_Gen7M_Superheavy_Flatcar_middle_L2;
	1: spritegroup_wagon_Gen7M_Superheavy_Flatcar_middle_L3;
	1: spritegroup_wagon_Gen7M_Superheavy_Flatcar_middle_L4;
}

switch(FEAT_TRAINS, SELF, switch_mglv_Wagon_Gen7M_Superheavy_Flatcar, position_in_vehid_chain % 3) {
	1: switch_mglv_Wagon_Gen7M_Superheavy_Flatcar_middle_livery;
	2: spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_back;
	spriteset_mglv_Wagon_Gen7M_Superheavy_Flatcar_front;
}

/*
* Articulated part
*/

switch(FEAT_TRAINS, SELF, switch_mglv_Wagon_Gen7M_Superheavy_Flatcar_articulated, extra_callback_info1) {
	1..2: return item_mglv_Wagon_Gen7M_Superheavy_Flatcar;
	CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

