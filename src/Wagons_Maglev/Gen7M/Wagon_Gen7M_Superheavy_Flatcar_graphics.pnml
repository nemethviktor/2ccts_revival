/// Graphics routing switch for articulated parts
switch (FEAT_TRAINS, SELF, switch_mglv_wagon_gen7m_superheavy_flatcar, position_in_articulated_veh) {
    0: switch_mglv_wagon_gen7m_superheavy_flatcar_front_livery;
    1: switch_mglv_wagon_gen7m_superheavy_flatcar_middle_livery;
    2: switch_mglv_wagon_gen7m_superheavy_flatcar_back_livery;
    switch_mglv_wagon_gen7m_superheavy_flatcar_front_livery;
}


/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_mglv_wagon_gen7m_superheavy_flatcar_articulated, extra_callback_info1) {
    1..2: return item_mglv_wagon_gen7m_superheavy_flatcar;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
