// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_mu_mu_cargo_wagon_powered_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 1/2; \
        bitmask(CC_ARMOURED): 1/4; \
        1; \
    }


    switch(FEAT_TRAINS, SELF, switch_mu_mu_cargo_wagon_powered_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

item(FEAT_TRAINS, item_mu_mu_cargo_wagon_powered) {
    property {
        name: string(str_mu_mu_cargo_wagon_powered);
        climates_available: (((param_region_africa || (param_region_north_america || param_region_south_america) || param_region_asia || (param_region_northern_europe || param_region_eastern_europe || param_region_southern_europe || param_region_western_europe) || param_region_oceania) || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1992,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 60;
