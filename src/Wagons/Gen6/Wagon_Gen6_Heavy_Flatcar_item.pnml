// Template: TPL_04O.
// Data from: nan

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_mu_wagon_gen6_heavy_flatcar_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 96/2; \
        bitmask(CC_ARMOURED): 96/4; \
        96; \
    }


    switch(FEAT_TRAINS, SELF, switch_mu_wagon_gen6_heavy_flatcar_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

item(FEAT_TRAINS, item_mu_wagon_gen6_heavy_flatcar) {
    property {
        name: string(str_mu_wagon_gen6_heavy_flatcar);
        climates_available: (((param_region_africa || (param_region_north_america || param_region_south_america) || param_region_asia || (param_region_northern_europe || param_region_eastern_europe || param_region_southern_europe || param_region_western_europe) || param_region_oceania) || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2020,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 50.40025;
        running_cost_factor: 48.06005;
        speed: 140 km/h;
        power: 0 hp;
        cargo_capacity: 96;
        weight: 42 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: HEAVYFLAT;
        refittable_cargo_classes: bitmask(CC_PIECE_GOODS, CC_FLATBED);
        non_refittable_cargo_classes: 0;
        cargo_allow_refit: [];
        cargo_disallow_refit: [];
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_AUTOREFIT);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE, NARROW_GAUGE_RAILTYPE_NONE, BROAD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/africa", "region/asia", "region/america/northern", "region/america/south", "region/europe/southern", "region/europe/western", "region/europe/eastern", "region/europe/northern", "region/oceania", "role/wagon"];

    }
    graphics {
        purchase: spriteset_mu_wagon_gen6_heavy_flatcar_purchase;
        cargo_capacity: switch_mu_wagon_gen6_heavy_flatcar_capacity_engine;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        // no 'can_attach'
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_mu_wagon_gen6_heavy_flatcar_cargo_selection;
    }
}
