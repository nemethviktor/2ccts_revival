	GOOD: switch_mu_wagon_gen6_flatcar_goods_livery;
	WOOD: switch_mu_wagon_gen6_flatcar_wood_livery;
	STEL: switch_mu_wagon_gen6_flatcar_steel_livery;
	BDMT: switch_mu_wagon_gen6_flatcar_building_materials_livery;
	ENSP: switch_mu_wagon_gen6_flatcar_goods_livery;
	WDPR: switch_mu_wagon_gen6_flatcar_planks_livery;
