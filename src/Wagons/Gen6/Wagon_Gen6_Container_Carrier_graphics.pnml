//Goods have multiple liveries
random_switch(FEAT_TRAINS, SELF, switch_mu_Wagon_Gen6_Container_Carrier_Goods_livery) {
	7: switch_mu_Wagon_Gen6_Container_Carrier_Container_livery;
	2: switch_mu_Wagon_Gen6_Container_Carrier_Refrigerated_livery;
	1: switch_mu_Wagon_Gen6_Container_Carrier_Tanktainer_livery;
}

switch(FEAT_TRAINS, SELF, switch_mu_Wagon_Gen6_Container_Carrier_cargo_selection, cargo_type_in_veh) {
	GOOD: switch_mu_Wagon_Gen6_Container_Carrier_Goods_livery;
	FOOD: switch_mu_Wagon_Gen6_Container_Carrier_Refrigerated_livery;
	RUBR: switch_mu_Wagon_Gen6_Container_Carrier_Tanktainer_livery;
	FRUT: switch_mu_Wagon_Gen6_Container_Carrier_Refrigerated_livery;
	WATR: switch_mu_Wagon_Gen6_Container_Carrier_Tanktainer_livery;
	COLA: switch_mu_Wagon_Gen6_Container_Carrier_Tanktainer_livery;
	PLST: switch_mu_Wagon_Gen6_Container_Carrier_Tanktainer_livery;
	FZDR: switch_mu_Wagon_Gen6_Container_Carrier_Refrigerated_livery;
	BEER: switch_mu_Wagon_Gen6_Container_Carrier_Tanktainer_livery;
	DYES: switch_mu_Wagon_Gen6_Container_Carrier_Tanktainer_livery;
	FISH: switch_mu_Wagon_Gen6_Container_Carrier_Refrigerated_livery;
	PETR: switch_mu_Wagon_Gen6_Container_Carrier_Tanktainer_livery;
	PLAS: switch_mu_Wagon_Gen6_Container_Carrier_Tanktainer_livery;
	RFPR: switch_mu_Wagon_Gen6_Container_Carrier_Tanktainer_livery;
	switch_mu_Wagon_Gen6_Container_Carrier_Container_livery;
}

