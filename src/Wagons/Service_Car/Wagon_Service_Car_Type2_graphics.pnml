random_switch(FEAT_TRAINS, SELF, switch_mu_Wagon_Service_Car_Type2_livery) {
	7: spriteset_mu_Wagon_Service_Car_Type2_L1;
	1: spriteset_mu_Wagon_Service_Car_Type2_L2;
	1: spriteset_mu_Wagon_Service_Car_Type2_L3;
