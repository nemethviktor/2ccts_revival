// Template: TPL_25A

// PURCHASE
spriteset(spriteset_mu_wagon_gen5_superheavy_flatcar_purchase, "gfx/wagons/gen5/wagon_gen5_superheavy_flatcar_purchase.png") {template_purchase_wagon(1, 1)}


/// Front
spriteset(spriteset_mu_wagon_gen5_superheavy_flatcar_front, "gfx/wagons/gen5/wagon_gen5_superheavy_flatcar.png") {template_2cc_wagons(1, 1)}


/// Back
spriteset(spriteset_mu_wagon_gen5_superheavy_flatcar_back, "gfx/wagons/gen5/wagon_gen5_superheavy_flatcar.png") {template_2cc_wagons(1, 64)}


/// Middle Empty
spriteset(spriteset_mu_wagon_gen5_superheavy_flatcar_middle_empty, "gfx/wagons/gen5/wagon_gen5_superheavy_flatcar.png") {template_2cc_wagons(1, 32)}


/// Middle L1
spriteset(spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l1, "gfx/wagons/gen5/wagon_gen5_superheavy_flatcar.png") {template_2cc_wagons(1, 126)}


/// LIVERY 1 SPRITEGROUP - MIDDLE
spritegroup spritegroup_mu_wagon_gen5_superheavy_flatcar_middle_l1 {
    loading: [spriteset_mu_wagon_gen5_superheavy_flatcar_middle_empty, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l1, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l1];
    loaded: [spriteset_mu_wagon_gen5_superheavy_flatcar_middle_empty, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l1, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l1];
}

/// Middle L2
spriteset(spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l2, "gfx/wagons/gen5/wagon_gen5_superheavy_flatcar.png") {template_2cc_wagons(179, 126)}


/// LIVERY 2 SPRITEGROUP - MIDDLE
spritegroup spritegroup_mu_wagon_gen5_superheavy_flatcar_middle_l2 {
    loading: [spriteset_mu_wagon_gen5_superheavy_flatcar_middle_empty, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l2, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l2];
    loaded: [spriteset_mu_wagon_gen5_superheavy_flatcar_middle_empty, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l2, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l2];
}

/// Middle L3
spriteset(spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l3, "gfx/wagons/gen5/wagon_gen5_superheavy_flatcar.png") {template_2cc_wagons(357, 126)}


/// LIVERY 3 SPRITEGROUP - MIDDLE
spritegroup spritegroup_mu_wagon_gen5_superheavy_flatcar_middle_l3 {
    loading: [spriteset_mu_wagon_gen5_superheavy_flatcar_middle_empty, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l3, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l3];
    loaded: [spriteset_mu_wagon_gen5_superheavy_flatcar_middle_empty, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l3, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l3];
}

/// Middle L4
spriteset(spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l4, "gfx/wagons/gen5/wagon_gen5_superheavy_flatcar.png") {template_2cc_wagons(535, 126)}


/// LIVERY 4 SPRITEGROUP - MIDDLE
spritegroup spritegroup_mu_wagon_gen5_superheavy_flatcar_middle_l4 {
    loading: [spriteset_mu_wagon_gen5_superheavy_flatcar_middle_empty, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l4, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l4];
    loaded: [spriteset_mu_wagon_gen5_superheavy_flatcar_middle_empty, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l4, spriteset_mu_wagon_gen5_superheavy_flatcar_middle_l4];
}

// Random Livery Selector for middle
random_switch(FEAT_TRAINS, SELF, switch_mu_wagon_gen5_superheavy_flatcar_middle_livery) {
	7: spritegroup_mu_wagon_gen5_superheavy_flatcar_middle_l1;
	1: spritegroup_mu_wagon_gen5_superheavy_flatcar_middle_l2;
	1: spritegroup_mu_wagon_gen5_superheavy_flatcar_middle_l3;
	1: spritegroup_mu_wagon_gen5_superheavy_flatcar_middle_l4;
}
switch(FEAT_TRAINS, SELF, switch_mu_wagon_gen5_superheavy_flatcar, position_in_vehid_chain % 3) {
	1: switch_mu_wagon_gen5_superheavy_flatcar_middle_livery;
	2: spriteset_mu_wagon_gen5_superheavy_flatcar_back;
	spriteset_mu_wagon_gen5_superheavy_flatcar_front;
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_mu_wagon_gen5_superheavy_flatcar_articulated, extra_callback_info1) {
    1..2: return item_mu_wagon_gen5_superheavy_flatcar;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
