	7: spritegroup_mu_wagon_gen5_hopper_type2_gray_l1;
	1: spritegroup_mu_wagon_gen5_hopper_type2_gray_l2;
	1: spritegroup_mu_wagon_gen5_hopper_type2_gray_l3;
	1: spritegroup_mu_wagon_gen5_hopper_type2_gray_l4;
}

        switch(FEAT_TRAINS, SELF, switch_mu_wagon_gen5_hopper_type2_cargo_selection, cargo_type_in_veh) {
	COAL: switch_mu_wagon_gen5_hopper_type2_coal_livery;
	CLAY: switch_mu_wagon_gen5_hopper_type2_gray_livery;
	CMNT: switch_mu_wagon_gen5_hopper_type2_gray_livery;
	GRVL: switch_mu_wagon_gen5_hopper_type2_sand_livery;
	LIME: switch_mu_wagon_gen5_hopper_type2_sand_livery;
	SAND: switch_mu_wagon_gen5_hopper_type2_sand_livery;
	SGBT: switch_mu_wagon_gen5_hopper_type2_sand_livery; // Use Sand livery for Sugar Beets
	switch_mu_wagon_gen5_hopper_type2_ore_livery; // IORE, CORE, AORE
}