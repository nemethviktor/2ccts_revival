	COAL: switch_mu_wagon_gen3_open_wagon_coal_livery;
	IORE: switch_mu_wagon_gen3_open_wagon_ore_livery;
	FRUT: switch_mu_wagon_gen3_open_wagon_crates_livery;
	CORE: switch_mu_wagon_gen3_open_wagon_ore_livery;
	WOOD: switch_mu_wagon_gen3_open_wagon_wood_livery;
	SUGR: switch_mu_wagon_gen3_open_wagon_crates_livery;
	CTCD: switch_mu_wagon_gen3_open_wagon_crates_livery;
	BUBL: switch_mu_wagon_gen3_open_wagon_gray_livery;
	AORE: switch_mu_wagon_gen3_open_wagon_ore_livery;
	CERE: switch_mu_wagon_gen3_open_wagon_crates_livery;
	CLAY: switch_mu_wagon_gen3_open_wagon_gray_livery;
	CMNT: switch_mu_wagon_gen3_open_wagon_gray_livery;
	GRVL: switch_mu_wagon_gen3_open_wagon_sand_livery;
	LIME: switch_mu_wagon_gen3_open_wagon_sand_livery;
	OLSD: switch_mu_wagon_gen3_open_wagon_crates_livery;
	POTA: switch_mu_wagon_gen3_open_wagon_wood_livery; // Potash is light brown-ish, so uses the Wood livery
	SAND: switch_mu_wagon_gen3_open_wagon_sand_livery;
	SCMT: switch_mu_wagon_gen3_open_wagon_gray_livery;
