}

switch(FEAT_TRAINS, SELF, switch_mu_wagon_gen2_tanker_cargo_selection, cargo_type_in_veh) {
	OIL_: switch_mu_wagon_gen2_tanker_oil_livery;
	GOOD: switch_mu_wagon_gen2_tanker_goods_livery;
	RUBR: switch_mu_wagon_gen2_tanker_rubber_livery;
	PLST: switch_mu_wagon_gen2_tanker_plastic_livery;
	PETR: switch_mu_wagon_gen2_tanker_oil_livery;
	PLAS: switch_mu_wagon_gen2_tanker_plastic_livery;
	RFPR: switch_mu_wagon_gen2_tanker_oil_livery;
	switch_mu_wagon_gen2_tanker_water_livery; // WATR, COLA, BEER, DYES, MILK
}
