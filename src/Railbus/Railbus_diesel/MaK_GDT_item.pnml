// Template: TPL_01B.
// Data from: https://de.wikipedia.org/wiki/MaK_GDT

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_rbd_mak_gdt_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 108/2; \
        bitmask(CC_ARMOURED): 108/4; \
        108; \
    }


    switch(FEAT_TRAINS, SELF, switch_rbd_mak_gdt_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

item(FEAT_TRAINS, item_rbd_mak_gdt) {
    property {
        name: string(str_rbd_mak_gdt);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1959,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 30.49;
        running_cost_factor: 31.39;
        speed: 70 km/h;
        power: 440 hp;
        cargo_capacity: 108;
        weight: 39 ton;
        tractive_effort_coefficient: 0.25;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -3, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "power/diesel", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_rbd_mak_gdt_purchase;
        cargo_capacity: switch_rbd_mak_gdt_capacity_engine;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: spriteset_rbd_mak_gdt;
    }
}
