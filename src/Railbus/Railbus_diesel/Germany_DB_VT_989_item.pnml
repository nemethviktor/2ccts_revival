// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_rbd_germany_db_vt_989_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 56/2; \
        bitmask(CC_ARMOURED): 56/4; \
        56; \
    }


    switch(FEAT_TRAINS, SELF, switch_rbd_germany_db_vt_989_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

item(FEAT_TRAINS, item_rbd_germany_db_vt_989) {
    property {
        name: string(str_rbd_germany_db_vt_989);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1953,1,1);
        model_life: 45;
        vehicle_life: 15;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 24.02692;
        running_cost_factor: 21.53207;
        speed: 90 km/h;
        power: 300 hp;
        cargo_capacity: 56;
        weight: 21 ton;
        tractive_effort_coefficient: 0.2;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -3, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 6;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "flag/DE", "power/diesel"];

    }
    graphics {
        purchase: spriteset_rbd_germany_db_vt_989_purchase;
        cargo_capacity: switch_rbd_germany_db_vt_989_capacity_engine;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: spriteset_rbd_germany_db_vt_989;
    }
}
