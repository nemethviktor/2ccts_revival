// Data from: https://fr.wikipedia.org/wiki/CP_s%C3%A9rie_9050

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_rbd_portugal_cp_usd_9050_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 25/2; \
        bitmask(CC_ARMOURED): 25/4; \
        25; \
    }


    switch(FEAT_TRAINS, SELF, switch_rbd_portugal_cp_usd_9050_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

item(FEAT_TRAINS, item_rbd_portugal_cp_usd_9050) {
    property {
        name: string(str_rbd_portugal_cp_usd_9050);
        climates_available: ((param_region_southern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1941,1,1);
        model_life: 45;
        vehicle_life: 39;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 14.31815;
        running_cost_factor: 13.12516;
        speed: 89 km/h;
        power: 90 hp;
        cargo_capacity: 25;
        weight: 8 ton;
        tractive_effort_coefficient: 0.2;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [NARROW_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 5;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/southern", "flag/PT", "power/diesel", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_rbd_portugal_cp_usd_9050_purchase;
        cargo_capacity: switch_rbd_portugal_cp_usd_9050_capacity_engine;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: spriteset_rbd_portugal_cp_usd_9050;
    }
}
