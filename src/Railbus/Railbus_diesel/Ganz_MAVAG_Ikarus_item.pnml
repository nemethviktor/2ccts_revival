// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_rbd_ganz_mavag_ikarus_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 43/2; \
        bitmask(CC_ARMOURED): 43/4; \
        43; \
    }


    switch(FEAT_TRAINS, SELF, switch_rbd_ganz_mavag_ikarus_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

item(FEAT_TRAINS, item_rbd_ganz_mavag_ikarus) {
    property {
        name: string(str_rbd_ganz_mavag_ikarus);
        climates_available: (((param_region_asia || param_region_eastern_europe) || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1983,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 22.79;
        running_cost_factor: 27.44;
        speed: 100 km/h;
        power: 250 hp;
        cargo_capacity: 43;
        weight: 32 ton;
        tractive_effort_coefficient: 0.2;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE, NARROW_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "region/europe/eastern", "power/diesel", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_rbd_ganz_mavag_ikarus_purchase;
        cargo_capacity: switch_rbd_ganz_mavag_ikarus_capacity_engine;
        visual_effect_and_powered: switch_rbd_ganz_mavag_ikarus_visual_effect;
        length: switch_rbd_ganz_mavag_ikarus_length;
        articulated_part: switch_rbd_ganz_mavag_ikarus_articulated;
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_rbd_ganz_mavag_ikarus_position;
    }
}
