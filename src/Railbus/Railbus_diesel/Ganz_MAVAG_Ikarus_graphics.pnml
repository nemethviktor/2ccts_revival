// Template: TPL_03D

// PURCHASE
spriteset(spriteset_rbd_ganz_mavag_ikarus_purchase, "gfx/railbus/railbus_diesel/ganz_mavag_ikarus.png") {template_purchase(1, 64)}


// VEHICLE
/// Engine
spriteset(spriteset_rbd_ganz_mavag_ikarus_engine, "gfx/railbus/railbus_diesel/ganz_mavag_ikarus.png") {template_2cc_engines_general(1, 1)}


/// Tender
spriteset(spriteset_rbd_ganz_mavag_ikarus_tender, "gfx/railbus/railbus_diesel/ganz_mavag_ikarus.png") {template_2cc_engines_general(1, 32)}

switch(FEAT_TRAINS, SELF, switch_rbd_ganz_mavag_ikarus_position, position_in_vehid_chain % 2) {
	0: spriteset_rbd_ganz_mavag_ikarus_engine;
	spriteset_rbd_ganz_mavag_ikarus_tender;
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_rbd_ganz_mavag_ikarus_visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/// Length
switch(FEAT_TRAINS, SELF, switch_rbd_ganz_mavag_ikarus_length, position_in_vehid_chain % 2) {
    0: 7;
	7;
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_rbd_ganz_mavag_ikarus_articulated, extra_callback_info1) {
    1: return item_rbd_ganz_mavag_ikarus;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
