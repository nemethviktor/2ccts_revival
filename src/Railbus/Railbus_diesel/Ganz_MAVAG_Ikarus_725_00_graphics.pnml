// Template: TPL_03E
// CargoDef: PASSENGERS_ONLY
// ID: 2048

// PURCHASE
spriteset(spriteset_rbd_ganz_mavag_ikarus_725_00_purchase, "gfx/railbus/railbus_diesel/ganz_mavag_ikarus_725_00.png") {template_purchase(1, 128)}


// VEHICLE
/// Engine
spriteset(spriteset_rbd_ganz_mavag_ikarus_725_00_engine, "gfx/railbus/railbus_diesel/ganz_mavag_ikarus_725_00.png") {template_2cc_engines_general(1, 1)}


/// B Unit
spriteset(spriteset_rbd_ganz_mavag_ikarus_725_00_b_unit, "gfx/railbus/railbus_diesel/ganz_mavag_ikarus_725_00.png") {template_2cc_engines_general(1, 32)}


/// Engine Reverse
spriteset(spriteset_rbd_ganz_mavag_ikarus_725_00_engine_reverse, "gfx/railbus/railbus_diesel/ganz_mavag_ikarus_725_00.png") {template_2cc_engines_general(1, 64)}


/// B Unit Reverse
spriteset(spriteset_rbd_ganz_mavag_ikarus_725_00_b_unit_reverse, "gfx/railbus/railbus_diesel/ganz_mavag_ikarus_725_00.png") {template_2cc_engines_general(1, 96)}


// Driving backwards switch - engine
switch(FEAT_TRAINS, PARENT, switch_rbd_ganz_mavag_ikarus_725_00_engine_direction, train_is_driving_backwards) {
    1: spriteset_rbd_ganz_mavag_ikarus_725_00_engine_reverse;
    spriteset_rbd_ganz_mavag_ikarus_725_00_engine;
}


// Driving backwards switch - b_unit
switch(FEAT_TRAINS, PARENT, switch_rbd_ganz_mavag_ikarus_725_00_b_unit_direction, train_is_driving_backwards) {
    1: spriteset_rbd_ganz_mavag_ikarus_725_00_b_unit_reverse;
    spriteset_rbd_ganz_mavag_ikarus_725_00_b_unit;
}

switch(FEAT_TRAINS, SELF, switch_rbd_ganz_mavag_ikarus_725_00_position, position_in_vehid_chain % 2) {
	0: switch_rbd_ganz_mavag_ikarus_725_00_engine_direction;
	switch_rbd_ganz_mavag_ikarus_725_00_b_unit_direction;
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_rbd_ganz_mavag_ikarus_725_00_visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/// Length
switch(FEAT_TRAINS, SELF, switch_rbd_ganz_mavag_ikarus_725_00_length, position_in_vehid_chain % 2) {
    0: 7;
	7;
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_rbd_ganz_mavag_ikarus_725_00_articulated, extra_callback_info1) {
    1: return item_rbd_ganz_mavag_ikarus_725_00;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
