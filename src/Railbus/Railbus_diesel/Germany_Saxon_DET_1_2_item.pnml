// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_rbd_germany_saxon_det_1_2_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 79/2; \
        bitmask(CC_ARMOURED): 79/4; \
        79; \
    }


    switch(FEAT_TRAINS, SELF, switch_rbd_germany_saxon_det_1_2_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

switch(FEAT_TRAINS, SELF, switch_rbd_germany_saxon_det_1_2_capacity_position, position_in_vehid_chain % 2) {
                0: switch_rbd_germany_saxon_det_1_2_capacity_engine;
                0;
            }

item(FEAT_TRAINS, item_rbd_germany_saxon_det_1_2) {
    property {
