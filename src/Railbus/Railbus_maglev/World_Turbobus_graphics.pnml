// Template: TPL_16B

// PURCHASE
spriteset(spriteset_rbm_world_turbobus_purchase, "gfx/railbus/railbus_maglev/world_turbobus.png") {template_purchase(1, 64)}


// VEHICLE

//// This vehicle uses the template for length 12.
//// The vehicle is built with 3 pieces of length 8+4
//// The middle part gets the graphics, the other parts are left blank

/// Engine
spriteset(spriteset_rbm_world_turbobus_engine, "gfx/railbus/railbus_maglev/world_turbobus.png") {template_2cc_l12(1, 1)}

switch(FEAT_TRAINS, SELF, switch_rbm_world_turbobus_position, position_in_vehid_chain % 2) {
	0: spriteset_rbm_world_turbobus_engine;
	EMPTY_SPRITESET
}

/// Length
switch(FEAT_TRAINS, SELF, switch_rbm_world_turbobus_length, position_in_vehid_chain % 2) {
    0: 8;
	2;
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_rbm_world_turbobus_articulated, extra_callback_info1) {
    1: return item_rbm_world_turbobus;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
