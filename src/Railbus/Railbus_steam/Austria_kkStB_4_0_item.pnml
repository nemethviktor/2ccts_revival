// Template: TPL_03B.
// Data from: https://de.wikipedia.org/wiki/KkStB_4

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_rbs_austria_kkstb_4_0_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 14/2; \
        bitmask(CC_ARMOURED): 14/4; \
        14; \
    }


    switch(FEAT_TRAINS, SELF, switch_rbs_austria_kkstb_4_0_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

item(FEAT_TRAINS, item_rbs_austria_kkstb_4_0) {
    property {
        name: string(str_rbs_austria_kkstb_4_0);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1880,1,1);
        model_life: 45;
        vehicle_life: 15;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 11.99447;
        running_cost_factor: 9.31852;
        speed: 80 km/h;
        power: 28 hp;
        cargo_capacity: 14;
        weight: 23 ton;
        tractive_effort_coefficient: 0.07;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: GOODS_RAILBUS;
        refittable_cargo_classes: bitmask(CC_PIECE_GOODS, CC_EXPRESS, CC_REFRIGERATED);
        non_refittable_cargo_classes: 0;
        cargo_allow_refit:[];
        cargo_disallow_refit: [];
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_STEAM;
        engine_class: ENGINE_CLASS_STEAM;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 5;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "flag/AT", "power/steam", "role/light_freight"];

    }
    graphics {
        purchase: spriteset_rbs_austria_kkstb_4_0_purchase;
        cargo_capacity: switch_rbs_austria_kkstb_4_0_capacity_engine;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_rbs_austria_kkstb_4_0_animation;
    }
}
