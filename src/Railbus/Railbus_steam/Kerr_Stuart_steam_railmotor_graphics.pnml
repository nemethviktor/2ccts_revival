// Template: TPL_03B

// PURCHASE
spriteset(spriteset_rbs_kerr_stuart_steam_railmotor_purchase, "gfx/railbus/railbus_steam/kerr_stuart_steam_railmotor.png") {template_purchase(1, 64)}


// VEHICLE
/// Engine1
spriteset(spriteset_rbs_kerr_stuart_steam_railmotor_engine1, "gfx/railbus/railbus_steam/kerr_stuart_steam_railmotor.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_rbs_kerr_stuart_steam_railmotor_engine2, "gfx/railbus/railbus_steam/kerr_stuart_steam_railmotor.png") {template_2cc_engines_general(1, 32)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_rbs_kerr_stuart_steam_railmotor_animation, motion_counter % 2){
	0: spriteset_rbs_kerr_stuart_steam_railmotor_engine1;
	spriteset_rbs_kerr_stuart_steam_railmotor_engine2;
}