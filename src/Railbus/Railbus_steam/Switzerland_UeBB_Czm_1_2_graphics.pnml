/*
* PURCHASE
*/

spriteset(spriteset_rbs_Switzerland_UeBB_Czm_1_2_purchase, "gfx/Railbus/Railbus_steam/Switzerland_UeBB_Czm_1_2.png") {
	template_purchase(1, 64)
}

/*
* VEHICLE
*/

//Engine
spriteset(spriteset_rbs_Switzerland_UeBB_Czm_1_2_engine1, "gfx/Railbus/Railbus_steam/Switzerland_UeBB_Czm_1_2.png") {
	template_2cc_engines_general(1, 1)
}

spriteset(spriteset_rbs_Switzerland_UeBB_Czm_1_2_engine2, "gfx/Railbus/Railbus_steam/Switzerland_UeBB_Czm_1_2.png") {
	template_2cc_engines_general(1, 32)
}

//Animation states
switch(FEAT_TRAINS, SELF, switch_rbs_Switzerland_UeBB_Czm_1_2_animation, motion_counter % 2){
	0: spriteset_rbs_Switzerland_UeBB_Czm_1_2_engine1;
	spriteset_rbs_Switzerland_UeBB_Czm_1_2_engine2;
}

/*
* Cargo capacity
*/

ENGINECAPACITYSWITCH(VEHIDCODE)

//Add defined switches

RUNNINGCOSTENGINESWITCH

PURCHASETEXTSWITCH