// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_rbs_Australia_Victorian_Railways_Rowan_Railmotor_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 42/2; \
        bitmask(CC_ARMOURED): 42/4; \
        42; \
    }


    switch(FEAT_TRAINS, SELF, switch_rbs_Australia_Victorian_Railways_Rowan_Railmotor_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

item(FEAT_TRAINS, item_rbs_Australia_Victorian_Railways_Rowan_Railmotor) {
    property {
        name: string(str_rbs_Australia_Victorian_Railways_Rowan_Railmotor);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1883,1,1);
        model_life: 45;
        vehicle_life: 15;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 12.86335;
        running_cost_factor: 11.05371;
        speed: 48 km/h;
        power: 40 hp;
        cargo_capacity: 42;
        weight: 15 ton;
        tractive_effort_coefficient: 0.34;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [NARROW_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_STEAM;
        engine_class: ENGINE_CLASS_STEAM;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 6;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_rbs_Australia_Victorian_Railways_Rowan_Railmotor_purchase;
        cargo_capacity: switch_rbs_Australia_Victorian_Railways_Rowan_Railmotor_capacity_engine;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_rbs_Australia_Victorian_Railways_Rowan_Railmotor_animation;
    }
}
