// Template: TPL_01B.
// Data from: https://de.wikipedia.org/wiki/N%C3%96LB_1%E2%80%933

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_rbs_austria_nolb_1_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 22/2; \
        bitmask(CC_ARMOURED): 22/4; \
        22; \
    }


    switch(FEAT_TRAINS, SELF, switch_rbs_austria_nolb_1_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

item(FEAT_TRAINS, item_rbs_austria_nolb_1) {
    property {
        name: string(str_rbs_austria_nolb_1);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1903,1,1);
        model_life: 45;
        vehicle_life: 30;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 11.41284;
        running_cost_factor: 10.3339;
        speed: 35 km/h;
        power: 39 hp;
        cargo_capacity: 22;
        weight: 8 ton;
        tractive_effort_coefficient: 0.18;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [NARROW_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_STEAM;
        engine_class: ENGINE_CLASS_STEAM;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 5;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "flag/AT", "power/steam", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_rbs_austria_nolb_1_purchase;
        cargo_capacity: switch_rbs_austria_nolb_1_capacity_engine;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: spriteset_rbs_austria_nolb_1;
    }
}
