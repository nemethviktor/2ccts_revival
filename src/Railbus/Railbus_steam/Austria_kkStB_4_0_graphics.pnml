// Template: TPL_03B

// PURCHASE
spriteset(spriteset_rbs_austria_kkstb_4_0_purchase, "gfx/railbus/railbus_steam/austria_kkstb_4_0.png") {template_purchase(1, 64)}


// VEHICLE
/// Engine1
spriteset(spriteset_rbs_austria_kkstb_4_0_engine1, "gfx/railbus/railbus_steam/austria_kkstb_4_0.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_rbs_austria_kkstb_4_0_engine2, "gfx/railbus/railbus_steam/austria_kkstb_4_0.png") {template_2cc_engines_general(1, 32)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_rbs_austria_kkstb_4_0_animation, motion_counter % 2){
	0: spriteset_rbs_austria_kkstb_4_0_engine1;
	spriteset_rbs_austria_kkstb_4_0_engine2;
}