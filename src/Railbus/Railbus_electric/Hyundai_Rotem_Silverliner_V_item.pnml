// Template: TPL_01B.
// Data from: https://en.wikipedia.org/wiki/Silverliner_V

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_rbe_hyundai_rotem_silverliner_v_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 110/2; \
        bitmask(CC_ARMOURED): 110/4; \
        110; \
    }


    switch(FEAT_TRAINS, SELF, switch_rbe_hyundai_rotem_silverliner_v_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

item(FEAT_TRAINS, item_rbe_hyundai_rotem_silverliner_v) {
    property {
        name: string(str_rbe_hyundai_rotem_silverliner_v);
        climates_available: ((param_region_north_america || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2010,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 38.59;
        running_cost_factor: 48.31;
        speed: 180 km/h;
        power: 680 hp;
        cargo_capacity: 110;
        weight: 66 ton;
        tractive_effort_coefficient: 0.17;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_25KV, STANDARD_GAUGE_RAILTYPE_15KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/northern", "power/electric/ac", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_rbe_hyundai_rotem_silverliner_v_purchase;
        cargo_capacity: switch_rbe_hyundai_rotem_silverliner_v_capacity_engine;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: spriteset_rbe_hyundai_rotem_silverliner_v;
    }
}
