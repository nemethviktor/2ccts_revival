// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_rbe_france_sncf_z_7100_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 70/2; \
        bitmask(CC_ARMOURED): 70/4; \
        70; \
    }


    switch(FEAT_TRAINS, SELF, switch_rbe_france_sncf_z_7100_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

item(FEAT_TRAINS, item_rbe_france_sncf_z_7100) {
    property {
        name: string(str_rbe_france_sncf_z_7100);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1960,1,1);
        model_life: 45;
        vehicle_life: 15;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 46.33042;
        running_cost_factor: 40.0661;
        speed: 130 km/h;
        power: 1260 hp;
        cargo_capacity: 70;
        weight: 58 ton;
        tractive_effort_coefficient: 0.21;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

badges: ["power/electric", "flag/FR"];

    }
    graphics {
        purchase: spriteset_rbe_france_sncf_z_7100_purchase;
        cargo_capacity: switch_rbe_france_sncf_z_7100_capacity_engine;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: spriteset_rbe_france_sncf_z_7100;
    }
}
