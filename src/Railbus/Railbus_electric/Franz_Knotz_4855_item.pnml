// Template: TPL_01B.
// Data from: https://de.wikipedia.org/wiki/%C3%96BB_4855

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_rbe_franz_knotz_4855_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 126/2; \
        bitmask(CC_ARMOURED): 126/4; \
        126; \
    }


    switch(FEAT_TRAINS, SELF, switch_rbe_franz_knotz_4855_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

item(FEAT_TRAINS, item_rbe_franz_knotz_4855) {
    property {
        name: string(str_rbe_franz_knotz_4855);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1989,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 35.71765;
        running_cost_factor: 31.07948;
        speed: 120 km/h;
        power: 643 hp;
        cargo_capacity: 126;
        weight: 42 ton;
        tractive_effort_coefficient: 0.21;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_15KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "power/electric/ac", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_rbe_franz_knotz_4855_purchase;
        cargo_capacity: switch_rbe_franz_knotz_4855_capacity_engine;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: spriteset_rbe_franz_knotz_4855;
    }
}
