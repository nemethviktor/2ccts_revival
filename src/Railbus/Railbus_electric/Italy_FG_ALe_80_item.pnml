// Template: TPL_01B.
// Data from: https://it.wikipedia.org/wiki/Automotrice_FG_ALe_80

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_rbe_italy_fg_ale_80_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 80/2; \
        bitmask(CC_ARMOURED): 80/4; \
        80; \
    }


    switch(FEAT_TRAINS, SELF, switch_rbe_italy_fg_ale_80_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

item(FEAT_TRAINS, item_rbe_italy_fg_ale_80) {
    property {
        name: string(str_rbe_italy_fg_ale_80);
        climates_available: ((param_region_southern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1981,1,1);
        model_life: 45;
        vehicle_life: 15;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 37.88676;
        running_cost_factor: 32.55607;
        speed: 110 km/h;
        power: 770 hp;
        cargo_capacity: 80;
        weight: 49 ton;
        tractive_effort_coefficient: 0.17;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_3KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["power/electric/dc", "flag/IT"];

    }
    graphics {
        purchase: spriteset_rbe_italy_fg_ale_80_purchase;
        cargo_capacity: switch_rbe_italy_fg_ale_80_capacity_engine;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: spriteset_rbe_italy_fg_ale_80;
    }
}
