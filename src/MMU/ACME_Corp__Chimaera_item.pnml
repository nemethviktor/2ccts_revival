// Template: TPL_02A.
// Data from: https://wiki.openttd.org/en/Manual/Base%20Set/MagLev#:~:text=Lev4%20%27-,Chimaera%27,-There%20is%20only

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_mmu_acme_corp__chimaera_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 150/2; \
        bitmask(CC_ARMOURED): 150/4; \
        150; \
    }


    switch(FEAT_TRAINS, SELF, switch_mmu_acme_corp__chimaera_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 150/2; \
        bitmask(CC_ARMOURED): 150/4; \
        150; \
    }

item(FEAT_TRAINS, item_mmu_acme_corp__chimaera) {
    property {
        name: string(str_mmu_acme_corp__chimaera);
        climates_available: (((param_region_africa || (param_region_north_america || param_region_south_america) || param_region_asia || (param_region_northern_europe || param_region_eastern_europe || param_region_southern_europe || param_region_western_europe) || param_region_oceania) || 0) && param_concept) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2030,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 164.49295;
        running_cost_factor: 148.47866;
        speed: 643 km/h;
        power: 20000 hp;
        cargo_capacity: 150;
        weight: 150 ton;
        tractive_effort_coefficient: 0.68;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [MGLV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/africa", "region/asia", "region/america/northern", "region/america/south", "region/europe/southern", "region/europe/western", "region/europe/eastern", "region/europe/northern", "region/oceania", "power/maglev", "role/ultra_high_speed__pax_"];

    }
    graphics {
        purchase: spriteset_mmu_acme_corp__chimaera_purchase;
        cargo_capacity: switch_mmu_acme_corp__chimaera_capacity_engine;
        visual_effect_and_powered: switch_mmu_acme_corp__chimaera_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_mmu_acme_corp__chimaera_reversed;
    }
    livery_override (item_mglv_maglev_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(643/10);
        weight: int(150*1/2);
        cargo_capacity: 150;
        length: 7;
        default: switch_mmu_acme_corp__chimaera_cargo_selection;
    }
    livery_override (item_mglv_maglev_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: round(180.44213562373096);
        power: int(20000*1/2);
        weight: int(150*3/4);
        cargo_capacity: 150;
        tractive_effort_coefficient: int(0.68*10*150);
        length: 7;
        default: switch_mmu_acme_corp__chimaera_cargo_selection;
    }
}
