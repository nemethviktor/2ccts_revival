// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_Croatia_HZ_7022_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 66/2; \
        bitmask(CC_ARMOURED): 66/4; \
        66; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_Croatia_HZ_7022_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 66/2; \
        bitmask(CC_ARMOURED): 66/4; \
        66; \
    }

item(FEAT_TRAINS, item_dmu_Croatia_HZ_7022) {
    property {
        name: string(str_dmu_Croatia_HZ_7022);
        climates_available: ((param_region_eastern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2011,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 46.06373;
        running_cost_factor: 41.75241;
        speed: 160 km/h;
        power: 1350 hp;
        cargo_capacity: 66;
        weight: 38 ton;
        tractive_effort_coefficient: 0.53;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_dmu_Croatia_HZ_7022_purchase;
        cargo_capacity: switch_dmu_Croatia_HZ_7022_capacity_engine;
        visual_effect_and_powered: switch_dmu_Croatia_HZ_7022_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_Croatia_HZ_7022_reversed;
    }
    livery_override (item_mu_MU_Wagon_Unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(160/10);
        weight: int(38*1/2);
        cargo_capacity: 66;
        length: 8;
        default: switch_dmu_Croatia_HZ_7022_cargo_selection;
    }
    livery_override (item_mu_MU_Wagon_Powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(39.81423466811774));
        power: int(1350*1/2);
        weight: int(38*3/4);
        cargo_capacity: 66;
        tractive_effort_coefficient: int(0.53*10*38);
        length: 8;
        default: switch_dmu_Croatia_HZ_7022_cargo_selection;
    }
}
