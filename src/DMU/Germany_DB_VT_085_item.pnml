// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_Germany_DB_VT_085_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 45/2; \
        bitmask(CC_ARMOURED): 45/4; \
        45; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_Germany_DB_VT_085_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 45/2; \
        bitmask(CC_ARMOURED): 45/4; \
        45; \
    }

item(FEAT_TRAINS, item_dmu_Germany_DB_VT_085) {
    property {
        name: string(str_dmu_Germany_DB_VT_085);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1952,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 40.41643;
        running_cost_factor: 35.73602;
        speed: 140 km/h;
        power: 986 hp;
        cargo_capacity: 45;
        weight: 42 ton;
        tractive_effort_coefficient: 0.43;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_dmu_Germany_DB_VT_085_purchase;
        cargo_capacity: switch_dmu_Germany_DB_VT_085_capacity_engine;
        visual_effect_and_powered: switch_dmu_Germany_DB_VT_085_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_Germany_DB_VT_085_reversed;
    }
    livery_override (item_mu_MU_Wagon_Unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(140/10);
        weight: int(42*1/2);
        cargo_capacity: 45;
        length: 8;
        default: switch_dmu_Germany_DB_VT_085_cargo_selection;
    }
    livery_override (item_mu_MU_Wagon_Powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(35.20006626372373));
        power: int(986*1/2);
        weight: int(42*3/4);
        cargo_capacity: 45;
        tractive_effort_coefficient: int(0.43*10*42);
        length: 8;
        default: switch_dmu_Germany_DB_VT_085_cargo_selection;
    }
}
