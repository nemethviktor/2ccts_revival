// Template: TPL_02A.
// Data from: nan

// Notes:
//// HEAD_CAPACITY: 0 -- Power cars only
//// TE_STARTING_KN: =178/2 -- Gemini. Wikipedia kindof disagrees but unclear if that latter is per unit or whole


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_thailand_comeng_xpt_concept_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_thailand_comeng_xpt_concept_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 72/2; \
        bitmask(CC_ARMOURED): 72/4; \
        72; \
    }

item(FEAT_TRAINS, item_dmu_thailand_comeng_xpt_concept) {
    property {
        name: string(str_dmu_thailand_comeng_xpt_concept);
        climates_available: ((param_region_asia || 0) && param_concept) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1985,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 71.60483;
        running_cost_factor: 63.49351;
        speed: 160 km/h;
        power: 4000 hp;
        cargo_capacity: 0;
        weight: 76 ton;
        tractive_effort_coefficient: 0.119;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [NARROW_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "flag/TH", "power/diesel", "role/ultra_high_speed__universal_"];

    }
    graphics {
        purchase: spriteset_dmu_thailand_comeng_xpt_concept_purchase;
        cargo_capacity: switch_dmu_thailand_comeng_xpt_concept_capacity_engine;
        visual_effect_and_powered: switch_dmu_thailand_comeng_xpt_concept_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_thailand_comeng_xpt_concept_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(160/10);
        weight: int(76*1/2);
        cargo_capacity: 72;
        length: 8;
        default: switch_dmu_thailand_comeng_xpt_concept_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(31.368667936953354));
        power: int(4000*1/2);
        weight: int(76*3/4);
        cargo_capacity: 72;
        tractive_effort_coefficient: int(0.119*10*76);
        length: 8;
        default: switch_dmu_thailand_comeng_xpt_concept_cargo_selection;
    }
}
