// Template: TPL_02G.
// Data from: nan

// Notes:
//// WEB: NA -- from Dutch Train set


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_acme_corp__v200d_dmu_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 60/2; \
        bitmask(CC_ARMOURED): 60/4; \
        60; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_acme_corp__v200d_dmu_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 240/2; \
        bitmask(CC_ARMOURED): 240/4; \
        240; \
    }

item(FEAT_TRAINS, item_dmu_acme_corp__v200d_dmu) {
    property {
        name: string(str_dmu_acme_corp__v200d_dmu);
        climates_available: ((param_region_western_europe || 0) && param_concept) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2040,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 53.37;
        running_cost_factor: 57.69;
        speed: 200 km/h;
        power: 1900 hp;
        cargo_capacity: 60;
        weight: 50 ton;
        tractive_effort_coefficient: 0.2;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "power/diesel", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_dmu_acme_corp__v200d_dmu_purchase;
        cargo_capacity: switch_dmu_acme_corp__v200d_dmu_capacity_engine;
        visual_effect_and_powered: switch_dmu_acme_corp__v200d_dmu_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_dmu_acme_corp__v200d_dmu_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(200/10);
        weight: int(50*1/2);
        cargo_capacity: 240;
        length: 8;
        default: switch_dmu_acme_corp__v200d_dmu_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: round(34.35889894354067);
        power: int(1900*1/2);
        weight: int(50*3/4);
        cargo_capacity: 240;
        tractive_effort_coefficient: int(0.2*10*50);
        length: 8;
        default: switch_dmu_acme_corp__v200d_dmu_cargo_selection;
    }
}
