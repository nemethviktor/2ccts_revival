// Template: TPL_02A

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_iran_rai_141_pacer_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 47/2; \
        bitmask(CC_ARMOURED): 47/4; \
        47; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_iran_rai_141_pacer_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 47/2; \
        bitmask(CC_ARMOURED): 47/4; \
        47; \
    }

item(FEAT_TRAINS, item_dmu_iran_rai_141_pacer) {
    property {
        name: string(str_dmu_iran_rai_141_pacer);
        climates_available: ((param_region_asia || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1984,1,1);
        model_life: 45;
        vehicle_life: 20;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 23.17086;
        running_cost_factor: 18.52143;
        speed: 121 km/h;
        power: 204 hp;
        cargo_capacity: 47;
        weight: 42 ton;
        tractive_effort_coefficient: 0.21;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 6;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_dmu_iran_rai_141_pacer_purchase;
        cargo_capacity: switch_dmu_iran_rai_141_pacer_capacity_engine;
        visual_effect_and_powered: switch_dmu_iran_rai_141_pacer_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_iran_rai_141_pacer_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(121/10);
        weight: int(42*1/2);
        cargo_capacity: 47;
        length: 6;
        default: switch_dmu_iran_rai_141_pacer_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(22.355677290130956));
        power: int(204*1/2);
        weight: int(42*3/4);
        cargo_capacity: 47;
        tractive_effort_coefficient: int(0.21*10*42);
        length: 6;
        default: switch_dmu_iran_rai_141_pacer_cargo_selection;
    }
}
