// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/IC4

// Notes:
//// TE_STARTING_KN: =100/2 -- Gemini, stating this was limited on purpose


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_denmark_dsb_ic4_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 52/2; \
        bitmask(CC_ARMOURED): 52/4; \
        52; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_denmark_dsb_ic4_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 52/2; \
        bitmask(CC_ARMOURED): 52/4; \
        52; \
    }

item(FEAT_TRAINS, item_dmu_denmark_dsb_ic4) {
    property {
        name: string(str_dmu_denmark_dsb_ic4);
        climates_available: ((param_region_northern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2007,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 35.78597;
        running_cost_factor: 31.64525;
        speed: 180 km/h;
        power: 750 hp;
        cargo_capacity: 52;
        weight: 36 ton;
        tractive_effort_coefficient: 0.142;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["power/diesel", "flag/DK"];

    }
    graphics {
        purchase: spriteset_dmu_denmark_dsb_ic4_purchase;
        cargo_capacity: switch_dmu_denmark_dsb_ic4_capacity_engine;
        visual_effect_and_powered: switch_dmu_denmark_dsb_ic4_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_denmark_dsb_ic4_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(180/10);
        weight: int(36*1/2);
        cargo_capacity: 52;
        length: 8;
        default: switch_dmu_denmark_dsb_ic4_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(25.850633863002557));
        power: int(750*1/2);
        weight: int(36*3/4);
        cargo_capacity: 52;
        tractive_effort_coefficient: int(0.142*10*36);
        length: 8;
        default: switch_dmu_denmark_dsb_ic4_cargo_selection;
    }
}
