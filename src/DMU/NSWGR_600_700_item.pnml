// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/New_South_Wales_600/700_class_railcar

// Notes:
//// WEIGHT: 46 -- Guess


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_nswgr_600_700_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 32/2; \
        bitmask(CC_ARMOURED): 32/4; \
        32; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_nswgr_600_700_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 24/2; \
        bitmask(CC_ARMOURED): 24/4; \
        24; \
    }

item(FEAT_TRAINS, item_dmu_nswgr_600_700) {
    property {
        name: string(str_dmu_nswgr_600_700);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1949,1,1);
        model_life: 45;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 26.88982;
        running_cost_factor: 21.87675;
        speed: 100 km/h;
        power: 330 hp;
        cargo_capacity: 32;
        weight: 46 ton;
        tractive_effort_coefficient: 0.2;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "power/diesel", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_dmu_nswgr_600_700_purchase;
        cargo_capacity: switch_dmu_nswgr_600_700_capacity_engine;
        visual_effect_and_powered: switch_dmu_nswgr_600_700_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_nswgr_600_700_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(100/10);
        weight: int(46*1/2);
        cargo_capacity: 24;
        length: 8;
        default: switch_dmu_nswgr_600_700_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(21.018173425043187));
        power: int(330*1/2);
        weight: int(46*3/4);
        cargo_capacity: 24;
        tractive_effort_coefficient: int(0.2*10*46);
        length: 8;
        default: switch_dmu_nswgr_600_700_cargo_selection;
    }
}
