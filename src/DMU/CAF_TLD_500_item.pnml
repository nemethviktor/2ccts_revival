// Template: TPL_02A.
// Data from: https://es.wikipedia.org/wiki/Serie_593_de_Renfe

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_caf_tld_500_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 72/2; \
        bitmask(CC_ARMOURED): 72/4; \
        72; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_caf_tld_500_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 72/2; \
        bitmask(CC_ARMOURED): 72/4; \
        72; \
    }

item(FEAT_TRAINS, item_dmu_caf_tld_500) {
    property {
        name: string(str_dmu_caf_tld_500);
        climates_available: ((param_region_south_america || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1982,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 41.98887;
        running_cost_factor: 34.75069;
        speed: 120 km/h;
        power: 920 hp;
        cargo_capacity: 72;
        weight: 68 ton;
        tractive_effort_coefficient: 0.067;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [BROAD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/south", "power/diesel", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_dmu_caf_tld_500_purchase;
        cargo_capacity: switch_dmu_caf_tld_500_capacity_engine;
        visual_effect_and_powered: switch_dmu_caf_tld_500_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_dmu_caf_tld_500_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(120/10);
        weight: int(68*1/2);
        cargo_capacity: 72;
        length: 8;
        default: switch_dmu_caf_tld_500_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(19.58915017762062);
        power: int(920*1/2);
        weight: int(68*3/4);
        cargo_capacity: 72;
        tractive_effort_coefficient: int(0.067*10*68);
        length: 8;
        default: switch_dmu_caf_tld_500_cargo_selection;
    }
}
