// Template: TPL_02A

// PURCHASE
spriteset(spriteset_dmu_lhb_vt_04_0_flying_hamburger_purchase, "gfx/dmu/lhb_vt_04_0_flying_hamburger.png") {template_purchase_dualheaded(1, 128)}


// VEHICLE
/// Front
spriteset(spriteset_dmu_lhb_vt_04_0_flying_hamburger_front, "gfx/dmu/lhb_vt_04_0_flying_hamburger.png") {template_2cc_engines_general(1, 1)}


// VEHICLE
/// Back
spriteset(spriteset_dmu_lhb_vt_04_0_flying_hamburger_back, "gfx/dmu/lhb_vt_04_0_flying_hamburger.png") {template_2cc_engines_general(1, 32)}


/// MIDDLEPASS
spriteset(spriteset_dmu_lhb_vt_04_0_flying_hamburger_middlepass, "gfx/dmu/lhb_vt_04_0_flying_hamburger.png") {template_2cc_engines_general(1, 64)}


/// MIDDLEMAIL
spriteset(spriteset_dmu_lhb_vt_04_0_flying_hamburger_middlemail, "gfx/dmu/lhb_vt_04_0_flying_hamburger.png") {template_2cc_engines_general(1, 96)}


/// Dualheaded (reverse switch)
/// In the context of var[0xC8] (which is the variable for "position in consist"):
/// 0xFE: The very first vehicle in the train (The Engine/Front).
/// 0xFF: The very last vehicle in the train (The Caboose/End).
switch(FEAT_TRAINS, SELF, switch_dmu_lhb_vt_04_0_flying_hamburger_reversed, var[0xC8]) {
    0xFE: spriteset_dmu_lhb_vt_04_0_flying_hamburger_back;
    0xFF: spriteset_dmu_lhb_vt_04_0_flying_hamburger_back;
    spriteset_dmu_lhb_vt_04_0_flying_hamburger_front;
}

// Visual effect and power management
// Position-based logic: DIESEL
/// In the context of var[0xC8] (which is the variable for "position in consist"):
/// 0xFE: The very first vehicle in the train (The Engine/Front).
/// 0xFF: The very last vehicle in the train (The Caboose/End).
switch(FEAT_TRAINS, SELF, switch_dmu_lhb_vt_04_0_flying_hamburger_visual_effect_and_powered, var[0xC8]) {
    0xFE: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
    0xFF: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
    visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -3, DISABLE_WAGON_POWER);
}

/// Graphics for the unit wagon based on cargo class
switch(FEAT_TRAINS, SELF, switch_dmu_lhb_vt_04_0_flying_hamburger_cargo_selection, cargo_classes){
	bitmask(CC_PASSENGERS): spriteset_dmu_lhb_vt_04_0_flying_hamburger_middlepass;
	spriteset_dmu_lhb_vt_04_0_flying_hamburger_middlemail;
}