// Template: TPL_02A

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_australia_transadelaide_3100_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 53/2; \
        bitmask(CC_ARMOURED): 53/4; \
        53; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_australia_transadelaide_3100_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 53/2; \
        bitmask(CC_ARMOURED): 53/4; \
        53; \
    }

item(FEAT_TRAINS, item_dmu_australia_transadelaide_3100) {
    property {
        name: string(str_dmu_australia_transadelaide_3100);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1987,1,1);
        model_life: 45;
        vehicle_life: 20;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 31.32036;
        running_cost_factor: 26.12552;
        speed: 90 km/h;
        power: 475 hp;
        cargo_capacity: 53;
        weight: 48 ton;
        tractive_effort_coefficient: 0.22;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_dmu_australia_transadelaide_3100_purchase;
        cargo_capacity: switch_dmu_australia_transadelaide_3100_capacity_engine;
        visual_effect_and_powered: switch_dmu_australia_transadelaide_3100_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_australia_transadelaide_3100_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(90/10);
        weight: int(48*1/2);
        cargo_capacity: 53;
        length: 7;
        default: switch_dmu_australia_transadelaide_3100_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(21.73976861451189));
        power: int(475*1/2);
        weight: int(48*3/4);
        cargo_capacity: 53;
        tractive_effort_coefficient: int(0.22*10*48);
        length: 7;
        default: switch_dmu_australia_transadelaide_3100_cargo_selection;
    }
}
