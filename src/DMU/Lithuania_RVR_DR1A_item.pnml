// Template: TPL_02D.
// Data from: https://en.wikipedia.org/wiki/DR1_diesel_train

// Notes:
//// WEIGHT: 90 -- Apparently 90 each
//// WAGON_CAPACITY: 124 -- Ukrainian Wiki


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_lithuania_rvr_dr1a_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 68/2; \
        bitmask(CC_ARMOURED): 68/4; \
        68; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_lithuania_rvr_dr1a_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 124/2; \
        bitmask(CC_ARMOURED): 124/4; \
        124; \
    }

item(FEAT_TRAINS, item_dmu_lithuania_rvr_dr1a) {
    property {
        name: string(str_dmu_lithuania_rvr_dr1a);
        climates_available: ((((param_region_asia || param_region_eastern_europe) || param_region_south_america) || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1963,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 58.88417;
        running_cost_factor: 49.43642;
        speed: 120 km/h;
        power: 2000 hp;
        cargo_capacity: 68;
        weight: 90 ton;
        tractive_effort_coefficient: 0.2;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [BROAD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "region/america/south", "region/europe/eastern", "flag/LT", "power/diesel", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_dmu_lithuania_rvr_dr1a_purchase;
        cargo_capacity: switch_dmu_lithuania_rvr_dr1a_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_lithuania_rvr_dr1a_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(120/10);
        weight: int(90*1/2);
        cargo_capacity: 124;
        length: 8;
        default: switch_dmu_lithuania_rvr_dr1a_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(34.47213609148217));
        power: int(2000*1/2);
        weight: int(90*3/4);
        cargo_capacity: 124;
        tractive_effort_coefficient: int(0.2*10*90);
        length: 8;
        default: switch_dmu_lithuania_rvr_dr1a_cargo_selection;
    }
}
