// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_Spain_FEVE_2400_Apollos_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 50/2; \
        bitmask(CC_ARMOURED): 50/4; \
        50; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_Spain_FEVE_2400_Apollos_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 50/2; \
        bitmask(CC_ARMOURED): 50/4; \
        50; \
    }

item(FEAT_TRAINS, item_dmu_Spain_FEVE_2400_Apollos) {
    property {
        name: string(str_dmu_Spain_FEVE_2400_Apollos);
        climates_available: ((param_region_southern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1983,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 35.8759;
        running_cost_factor: 31.06283;
        speed: 100 km/h;
        power: 720 hp;
        cargo_capacity: 50;
        weight: 44 ton;
        tractive_effort_coefficient: 0.2;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_dmu_Spain_FEVE_2400_Apollos_purchase;
        cargo_capacity: switch_dmu_Spain_FEVE_2400_Apollos_capacity_engine;
        visual_effect_and_powered: switch_dmu_Spain_FEVE_2400_Apollos_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_Spain_FEVE_2400_Apollos_reversed;
    }
    livery_override (item_mu_MU_Wagon_Unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(100/10);
        weight: int(44*1/2);
        cargo_capacity: 50;
        length: 7;
        default: switch_dmu_Spain_FEVE_2400_Apollos_cargo_selection;
    }
    livery_override (item_mu_MU_Wagon_Powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(21.48330941475706));
        power: int(720*1/2);
        weight: int(44*3/4);
        cargo_capacity: 50;
        tractive_effort_coefficient: int(0.2*10*44);
        length: 7;
        default: switch_dmu_Spain_FEVE_2400_Apollos_cargo_selection;
    }
}
