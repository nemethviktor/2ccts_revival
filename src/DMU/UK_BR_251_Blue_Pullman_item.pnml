// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/Blue_Pullmans

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_uk_br_251_blue_pullman_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 27/2; \
        bitmask(CC_ARMOURED): 27/4; \
        27; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_uk_br_251_blue_pullman_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 42/2; \
        bitmask(CC_ARMOURED): 42/4; \
        42; \
    }

item(FEAT_TRAINS, item_dmu_uk_br_251_blue_pullman) {
    property {
        name: string(str_dmu_uk_br_251_blue_pullman);
        climates_available: ((param_region_northern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1960,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 55.35235;
        running_cost_factor: 48.16406;
        speed: 145 km/h;
        power: 2000 hp;
        cargo_capacity: 27;
        weight: 67 ton;
        tractive_effort_coefficient: 0.095;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/northern", "flag/GB", "power/diesel", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_dmu_uk_br_251_blue_pullman_purchase;
        cargo_capacity: switch_dmu_uk_br_251_blue_pullman_capacity_engine;
        visual_effect_and_powered: switch_dmu_uk_br_251_blue_pullman_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_uk_br_251_blue_pullman_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(145/10);
        weight: int(67*1/2);
        cargo_capacity: 42;
        length: 7;
        default: switch_dmu_uk_br_251_blue_pullman_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(25.337136091482165));
        power: int(2000*1/2);
        weight: int(67*3/4);
        cargo_capacity: 42;
        tractive_effort_coefficient: int(0.095*10*67);
        length: 7;
        default: switch_dmu_uk_br_251_blue_pullman_cargo_selection;
    }
}
