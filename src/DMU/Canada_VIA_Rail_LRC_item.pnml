// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/LRC_(train)

// Notes:
//// TE_STARTING_KN: =245/2 -- Gemini
//// TE_COEFFICIENT_MANUAL: 0.2 -- Can't find any info but .54 is way too high
//// WAGON_CAPACITY: 68 -- //corpo.viarail.ca/en/projects-infrastructure/train-fleet/lrc-coach


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_canada_via_rail_lrc_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_canada_via_rail_lrc_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 68/2; \
        bitmask(CC_ARMOURED): 68/4; \
        68; \
    }

item(FEAT_TRAINS, item_dmu_canada_via_rail_lrc) {
    property {
        name: string(str_dmu_canada_via_rail_lrc);
        climates_available: ((param_region_north_america || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1980,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 79.99089;
        running_cost_factor: 73.84021;
        speed: 153 km/h;
        power: 5400 hp;
        cargo_capacity: 0;
        weight: 56 ton;
        tractive_effort_coefficient: 0.221;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["power/diesel", "flag/CA"];

    }
    graphics {
        purchase: spriteset_dmu_canada_via_rail_lrc_purchase;
        cargo_capacity: switch_dmu_canada_via_rail_lrc_capacity_engine;
        purchase_cargo_capacity: 55;
        visual_effect_and_powered: switch_dmu_canada_via_rail_lrc_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_canada_via_rail_lrc_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(153/10);
        weight: int(56*1/2);
        cargo_capacity: 68;
        length: 8;
        default: switch_dmu_canada_via_rail_lrc_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(35.1359037772337));
        power: int(5400*1/2);
        weight: int(56*3/4);
        cargo_capacity: 68;
        tractive_effort_coefficient: int(0.221*10*56);
        length: 8;
        default: switch_dmu_canada_via_rail_lrc_cargo_selection;
    }
}
