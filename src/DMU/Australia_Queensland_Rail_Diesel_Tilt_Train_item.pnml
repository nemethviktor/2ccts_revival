// Template: TPL_02A.
// Data from: https://www.railtram.com.au/diesel-tilt-train

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_australia_queensland_rail_diesel_tilt_train_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_australia_queensland_rail_diesel_tilt_train_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 39/2; \
        bitmask(CC_ARMOURED): 39/4; \
        39; \
    }

item(FEAT_TRAINS, item_dmu_australia_queensland_rail_diesel_tilt_train) {
    property {
        name: string(str_dmu_australia_queensland_rail_diesel_tilt_train);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2003,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 91.93495;
        running_cost_factor: 85.42363;
        speed: 160 km/h;
        power: 7240 hp;
        cargo_capacity: 0;
        weight: 60 ton;
        tractive_effort_coefficient: 0.157;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [NARROW_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "flag/AU", "power/diesel"];

    }
    graphics {
        purchase: spriteset_dmu_australia_queensland_rail_diesel_tilt_train_purchase;
        cargo_capacity: switch_dmu_australia_queensland_rail_diesel_tilt_train_capacity_engine;
        visual_effect_and_powered: switch_dmu_australia_queensland_rail_diesel_tilt_train_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_australia_queensland_rail_diesel_tilt_train_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(160/10);
        weight: int(60*1/2);
        cargo_capacity: 39;
        length: 8;
        default: switch_dmu_australia_queensland_rail_diesel_tilt_train_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(33.933879728611814));
        power: int(7240*1/2);
        weight: int(60*3/4);
        cargo_capacity: 39;
        tractive_effort_coefficient: int(0.157*10*60);
        length: 8;
        default: switch_dmu_australia_queensland_rail_diesel_tilt_train_cargo_selection;
    }
}
