// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/KiHa_181_series

// Notes:
//// WAGON_CAPACITY: 76 -- JP wiki


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_fuji_kiha_181_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 52/2; \
        bitmask(CC_ARMOURED): 52/4; \
        52; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_fuji_kiha_181_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 76/2; \
        bitmask(CC_ARMOURED): 76/4; \
        76; \
    }

item(FEAT_TRAINS, item_dmu_fuji_kiha_181) {
    property {
        name: string(str_dmu_fuji_kiha_181);
        climates_available: ((param_region_asia || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1968,1,1);
        model_life: 45;
        vehicle_life: 43;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 31.42956;
        running_cost_factor: 26.5818;
        speed: 120 km/h;
        power: 500 hp;
        cargo_capacity: 52;
        weight: 44 ton;
        tractive_effort_coefficient: 0.125;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [NARROW_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "power/diesel", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_dmu_fuji_kiha_181_purchase;
        cargo_capacity: switch_dmu_fuji_kiha_181_capacity_engine;
        visual_effect_and_powered: switch_dmu_fuji_kiha_181_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_fuji_kiha_181_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(120/10);
        weight: int(44*1/2);
        cargo_capacity: 76;
        length: 8;
        default: switch_dmu_fuji_kiha_181_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(19.736313276997155));
        power: int(500*1/2);
        weight: int(44*3/4);
        cargo_capacity: 76;
        tractive_effort_coefficient: int(0.125*10*44);
        length: 8;
        default: switch_dmu_fuji_kiha_181_cargo_selection;
    }
}
