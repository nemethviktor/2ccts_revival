// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/British_Rail_Class_43_(HST)

// Notes:
//// HEAD_CAPACITY: 0 -- This didn't have any pax in the heads
//// TE_STARTING_KN: =178/2 -- Gemini. Wikipedia kindof disagrees but unclear if that latter is per unit or whole
//// WAGON_CAPACITY: 74 -- mk3 carriages


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_uk_br_43_ic125_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_uk_br_43_ic125_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 74/2; \
        bitmask(CC_ARMOURED): 74/4; \
        74; \
    }

item(FEAT_TRAINS, item_dmu_uk_br_43_ic125) {
    property {
        name: string(str_dmu_uk_br_43_ic125);
        climates_available: ((param_region_northern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1976,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 71.55647;
        running_cost_factor: 67.4863;
        speed: 201 km/h;
        power: 4500 hp;
        cargo_capacity: 0;
        weight: 35 ton;
        tractive_effort_coefficient: 0.259;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/northern", "flag/GB", "power/diesel"];

    }
    graphics {
        purchase: spriteset_dmu_uk_br_43_ic125_purchase;
        cargo_capacity: switch_dmu_uk_br_43_ic125_capacity_engine;
        visual_effect_and_powered: switch_dmu_uk_br_43_ic125_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_uk_br_43_ic125_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(201/10);
        weight: int(35*1/2);
        cargo_capacity: 74;
        length: 8;
        default: switch_dmu_uk_br_43_ic125_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(35.873475708951936));
        power: int(4500*1/2);
        weight: int(35*3/4);
        cargo_capacity: 74;
        tractive_effort_coefficient: int(0.259*10*35);
        length: 8;
        default: switch_dmu_uk_br_43_ic125_cargo_selection;
    }
}
