// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/New_South_Wales_Hunter_railcar

// Notes:
//// WAGON_CAPACITY: 70 -- Again, none, really, this doesn't take trailers IRL


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_ugl_hunter_railcar_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 70/2; \
        bitmask(CC_ARMOURED): 70/4; \
        70; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_ugl_hunter_railcar_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 70/2; \
        bitmask(CC_ARMOURED): 70/4; \
        70; \
    }

item(FEAT_TRAINS, item_dmu_ugl_hunter_railcar) {
    property {
        name: string(str_dmu_ugl_hunter_railcar);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2006,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 35.43988;
        running_cost_factor: 31.93392;
        speed: 160 km/h;
        power: 750 hp;
        cargo_capacity: 70;
        weight: 30 ton;
        tractive_effort_coefficient: 0.238;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "power/diesel", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_dmu_ugl_hunter_railcar_purchase;
        cargo_capacity: switch_dmu_ugl_hunter_railcar_capacity_engine;
        visual_effect_and_powered: switch_dmu_ugl_hunter_railcar_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_dmu_ugl_hunter_railcar_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(160/10);
        weight: int(30*1/2);
        cargo_capacity: 70;
        length: 8;
        default: switch_dmu_ugl_hunter_railcar_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(25.87861278752583);
        power: int(750*1/2);
        weight: int(30*3/4);
        cargo_capacity: 70;
        tractive_effort_coefficient: int(0.238*10*30);
        length: 8;
        default: switch_dmu_ugl_hunter_railcar_cargo_selection;
    }
}
