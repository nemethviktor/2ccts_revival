// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/British_Rail_Class_168

// Notes:
//// WAGON_CAPACITY: =INT(204/3) -- Wiki


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_adtranz_class_168_clubman_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 68/2; \
        bitmask(CC_ARMOURED): 68/4; \
        68; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_adtranz_class_168_clubman_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 68/2; \
        bitmask(CC_ARMOURED): 68/4; \
        68; \
    }

item(FEAT_TRAINS, item_dmu_adtranz_class_168_clubman) {
    property {
        name: string(str_dmu_adtranz_class_168_clubman);
        climates_available: ((param_region_northern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1997,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 38.92124;
        running_cost_factor: 33.41527;
        speed: 160 km/h;
        power: 844 hp;
        cargo_capacity: 68;
        weight: 50 ton;
        tractive_effort_coefficient: 0.114;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/northern", "power/diesel", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_dmu_adtranz_class_168_clubman_purchase;
        cargo_capacity: switch_dmu_adtranz_class_168_clubman_capacity_engine;
        visual_effect_and_powered: switch_dmu_adtranz_class_168_clubman_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_adtranz_class_168_clubman_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(160/10);
        weight: int(50*1/2);
        cargo_capacity: 68;
        length: 8;
        default: switch_dmu_adtranz_class_168_clubman_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(24.60516780926679);
        power: int(844*1/2);
        weight: int(50*3/4);
        cargo_capacity: 68;
        tractive_effort_coefficient: int(0.114*10*50);
        length: 8;
        default: switch_dmu_adtranz_class_168_clubman_cargo_selection;
    }
}
