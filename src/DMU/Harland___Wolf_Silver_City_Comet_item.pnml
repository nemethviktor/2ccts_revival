// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/Silver_City_Comet

// Notes:
//// WEB: https://en.wikipedia.org/wiki/Silver_City_Comet -- Not particularly useful
//// TE_STARTING_KN: =85/2 -- Gemini
//// WAGON_CAPACITY: 60 -- 2nd class, Gemini


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_harland___wolf_silver_city_comet_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_harland___wolf_silver_city_comet_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 60/2; \
        bitmask(CC_ARMOURED): 60/4; \
        60; \
    }

item(FEAT_TRAINS, item_dmu_harland___wolf_silver_city_comet) {
    property {
        name: string(str_dmu_harland___wolf_silver_city_comet);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1937,1,1);
        model_life: 45;
        vehicle_life: 52;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 29.66;
        running_cost_factor: 37.56;
        speed: 160 km/h;
        power: 660 hp;
        cargo_capacity: 0;
        weight: 32 ton;
        tractive_effort_coefficient: 0.135;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "power/diesel", "role/express"];

    }
    graphics {
        purchase: spriteset_dmu_harland___wolf_silver_city_comet_purchase;
        cargo_capacity: switch_dmu_harland___wolf_silver_city_comet_capacity_engine;
        visual_effect_and_powered: switch_dmu_harland___wolf_silver_city_comet_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_dmu_harland___wolf_silver_city_comet_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(160/10);
        weight: int(32*1/2);
        cargo_capacity: 60;
        length: 7;
        default: switch_dmu_harland___wolf_silver_city_comet_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(22.889046515733025);
        power: int(660*1/2);
        weight: int(32*3/4);
        cargo_capacity: 60;
        tractive_effort_coefficient: int(0.135*10*32);
        length: 7;
        default: switch_dmu_harland___wolf_silver_city_comet_cargo_selection;
    }
}
