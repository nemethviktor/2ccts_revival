// Template: TPL_02A.
// Data from: https://hu.wikipedia.org/wiki/M%C3%81V_Hargita_t%C3%ADpus

// Notes:
//// ENGLISH: Ganz 'Hargita' M440 -- aka DR VT 12.14, SZD series DP, Argentinan rilways Rosario, CSD  M 295.0
//// WITHDRAWAL_YEAR: 1975 -- withdrawn "in the 70s"
//// TE_STARTING_KN: 38 -- Guess (also remember this being a DMU means the game doubles the value)


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_hungary_mav_hargita_m440_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 54/2; \
        bitmask(CC_ARMOURED): 54/4; \
        54; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_hungary_mav_hargita_m440_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 54/2; \
        bitmask(CC_ARMOURED): 54/4; \
        54; \
    }

item(FEAT_TRAINS, item_dmu_hungary_mav_hargita_m440) {
    property {
        name: string(str_dmu_hungary_mav_hargita_m440);
        climates_available: ((param_region_eastern_europe || param_region_western_europe) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1944,1,1);
        model_life: 45;
        vehicle_life: 31;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 39.9941;
        running_cost_factor: 34.22134;
        speed: 120 km/h;
        power: 900 hp;
        cargo_capacity: 54;
        weight: 53 ton;
        tractive_effort_coefficient: 0.073;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "region/europe/eastern", "flag/HU", "power/diesel", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_dmu_hungary_mav_hargita_m440_purchase;
        cargo_capacity: switch_dmu_hungary_mav_hargita_m440_capacity_engine;
        visual_effect_and_powered: switch_dmu_hungary_mav_hargita_m440_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_hungary_mav_hargita_m440_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(120/10);
        weight: int(53*1/2);
        cargo_capacity: 54;
        length: 8;
        default: switch_dmu_hungary_mav_hargita_m440_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(18.88725549001284));
        power: int(900*1/2);
        weight: int(53*3/4);
        cargo_capacity: 54;
        tractive_effort_coefficient: int(0.073*10*53);
        length: 8;
        default: switch_dmu_hungary_mav_hargita_m440_cargo_selection;
    }
}
