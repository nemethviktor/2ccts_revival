// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/British_Rail_Class_150

// Notes:
//// TE_STARTING_KN: =65/2 -- Gemini


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_br_150_0_sprinter_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 80/2; \
        bitmask(CC_ARMOURED): 80/4; \
        80; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_br_150_0_sprinter_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 80/2; \
        bitmask(CC_ARMOURED): 80/4; \
        80; \
    }

item(FEAT_TRAINS, item_dmu_br_150_0_sprinter) {
    property {
        name: string(str_dmu_br_150_0_sprinter);
        climates_available: ((param_region_northern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1984,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 28.44;
        running_cost_factor: 32.78;
        speed: 121 km/h;
        power: 389 hp;
        cargo_capacity: 80;
        weight: 36 ton;
        tractive_effort_coefficient: 0.092;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/northern", "power/diesel", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_dmu_br_150_0_sprinter_purchase;
        cargo_capacity: switch_dmu_br_150_0_sprinter_capacity_engine;
        visual_effect_and_powered: switch_dmu_br_150_0_sprinter_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_dmu_br_150_0_sprinter_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(121/10);
        weight: int(36*1/2);
        cargo_capacity: 80;
        length: 7;
        default: switch_dmu_br_150_0_sprinter_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(17.384308292331603);
        power: int(389*1/2);
        weight: int(36*3/4);
        cargo_capacity: 80;
        tractive_effort_coefficient: int(0.092*10*36);
        length: 7;
        default: switch_dmu_br_150_0_sprinter_cargo_selection;
    }
}
