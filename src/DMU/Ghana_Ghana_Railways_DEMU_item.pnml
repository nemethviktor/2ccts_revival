// Template: TPL_02A

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_ghana_ghana_railways_demu_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 102/2; \
        bitmask(CC_ARMOURED): 102/4; \
        102; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_ghana_ghana_railways_demu_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 102/2; \
        bitmask(CC_ARMOURED): 102/4; \
        102; \
    }

item(FEAT_TRAINS, item_dmu_ghana_ghana_railways_demu) {
    property {
        name: string(str_dmu_ghana_ghana_railways_demu);
        climates_available: ((param_region_africa || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2009,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 51.49558;
        running_cost_factor: 46.30073;
        speed: 90 km/h;
        power: 1656 hp;
        cargo_capacity: 102;
        weight: 48 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [NARROW_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

badges: ["power/diesel", "flag/GH"];

    }
    graphics {
        purchase: spriteset_dmu_ghana_ghana_railways_demu_purchase;
        cargo_capacity: switch_dmu_ghana_ghana_railways_demu_capacity_engine;
        visual_effect_and_powered: switch_dmu_ghana_ghana_railways_demu_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_ghana_ghana_railways_demu_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(90/10);
        weight: int(48*1/2);
        cargo_capacity: 102;
        length: 7;
        default: switch_dmu_ghana_ghana_railways_demu_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(27.4693979909798));
        power: int(1656*1/2);
        weight: int(48*3/4);
        cargo_capacity: 102;
        tractive_effort_coefficient: int(0.3*10*48);
        length: 7;
        default: switch_dmu_ghana_ghana_railways_demu_cargo_selection;
    }
}
