// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/UAC_TurboTrain

// Notes:
//// WEIGHT: =INT(165/7) -- 165t over 7 cars
//// TE_STARTING_KN: =80/2 -- "Turbines are terrible at starting torque; high speed is where they live"
//// WAGON_CAPACITY: =INT((322-(PROPERTIES[[#This Row],[HEAD_CAPACITY]]*2))/5) -- 322 total over 7 cars so that's exc head cars. Wiki


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_uac_turbo_train_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 46/2; \
        bitmask(CC_ARMOURED): 46/4; \
        46; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_uac_turbo_train_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 46/2; \
        bitmask(CC_ARMOURED): 46/4; \
        46; \
    }

item(FEAT_TRAINS, item_dmu_uac_turbo_train) {
    property {
        name: string(str_dmu_uac_turbo_train);
        climates_available: ((param_region_north_america || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1967,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 51.71113;
        running_cost_factor: 48.85201;
        speed: 193 km/h;
        power: 2000 hp;
        cargo_capacity: 46;
        weight: 23 ton;
        tractive_effort_coefficient: 0.177;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/northern", "power/turbine", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_dmu_uac_turbo_train_purchase;
        cargo_capacity: switch_dmu_uac_turbo_train_capacity_engine;
        visual_effect_and_powered: switch_dmu_uac_turbo_train_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_uac_turbo_train_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(193/10);
        weight: int(23*1/2);
        cargo_capacity: 46;
        length: 8;
        default: switch_dmu_uac_turbo_train_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(27.843136091482165));
        power: int(2000*1/2);
        weight: int(23*3/4);
        cargo_capacity: 46;
        tractive_effort_coefficient: int(0.177*10*23);
        length: 8;
        default: switch_dmu_uac_turbo_train_cargo_selection;
    }
}
