// Template: TPL_02A

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_germany_db_vt_115_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_germany_db_vt_115_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 34/2; \
        bitmask(CC_ARMOURED): 34/4; \
        34; \
    }

item(FEAT_TRAINS, item_dmu_germany_db_vt_115) {
    property {
        name: string(str_dmu_germany_db_vt_115);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1957,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 43.11488;
        running_cost_factor: 39.30356;
        speed: 160 km/h;
        power: 1475 hp;
        cargo_capacity: 0;
        weight: 33 ton;
        tractive_effort_coefficient: 0.77;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

badges: ["power/diesel", "flag/DE"];

    }
    graphics {
        purchase: spriteset_dmu_germany_db_vt_115_purchase;
        cargo_capacity: switch_dmu_germany_db_vt_115_capacity_engine;
        visual_effect_and_powered: switch_dmu_germany_db_vt_115_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_germany_db_vt_115_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(160/10);
        weight: int(33*1/2);
        cargo_capacity: 34;
        length: 8;
        default: switch_dmu_germany_db_vt_115_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(45.25057288043254));
        power: int(1475*1/2);
        weight: int(33*3/4);
        cargo_capacity: 34;
        tractive_effort_coefficient: int(0.77*10*33);
        length: 8;
        default: switch_dmu_germany_db_vt_115_cargo_selection;
    }
}
