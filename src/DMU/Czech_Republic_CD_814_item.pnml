// Template: TPL_02A. Data from: https://cs.wikipedia.org/wiki/Motorov%C3%A1_jednotka_814

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_czech_republic_cd_814_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 95/2; \
        bitmask(CC_ARMOURED): 95/4; \
        95; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_czech_republic_cd_814_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 95/2; \
        bitmask(CC_ARMOURED): 95/4; \
        95; \
    }

item(FEAT_TRAINS, item_dmu_czech_republic_cd_814) {
    property {
        name: string(str_dmu_czech_republic_cd_814);
        climates_available: ((param_region_eastern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1973,1,1);
        model_life: 45;
        vehicle_life: 20;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 25.88997;
        running_cost_factor: 23.31402;
        speed: 80 km/h;
        power: 325 hp;
        cargo_capacity: 95;
        weight: 22 ton;
        tractive_effort_coefficient: 0.125;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 6;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

badges: ["power/diesel", "flag/CZ"];

    }
    graphics {
        purchase: spriteset_dmu_czech_republic_cd_814_purchase;
        cargo_capacity: switch_dmu_czech_republic_cd_814_capacity_engine;
        visual_effect_and_powered: switch_dmu_czech_republic_cd_814_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_czech_republic_cd_814_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(80/10);
        weight: int(22*1/2);
        cargo_capacity: 95;
        length: 6;
        default: switch_dmu_czech_republic_cd_814_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(12.55445326474844));
        power: int(325*1/2);
        weight: int(22*3/4);
        cargo_capacity: 95;
        tractive_effort_coefficient: int(0.125*10*22);
        length: 6;
        default: switch_dmu_czech_republic_cd_814_cargo_selection;
    }
}
