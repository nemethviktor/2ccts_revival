// Template: TPL_02A.
// Data from: https://es.wikipedia.org/wiki/Serie_594_de_Renfe

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_spain_renfe_594_trd_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 42/2; \
        bitmask(CC_ARMOURED): 42/4; \
        42; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_spain_renfe_594_trd_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 42/2; \
        bitmask(CC_ARMOURED): 42/4; \
        42; \
    }

item(FEAT_TRAINS, item_dmu_spain_renfe_594_trd) {
    property {
        name: string(str_dmu_spain_renfe_594_trd);
        climates_available: ((param_region_southern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1997,1,1);
        model_life: 45;
        vehicle_life: 20;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 65.93107;
        running_cost_factor: 60.51975;
        speed: 160 km/h;
        power: 3200 hp;
        cargo_capacity: 42;
        weight: 49 ton;
        tractive_effort_coefficient: 0.125;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [BROAD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/southern", "flag/ES", "power/diesel", "role/express__passenger_"];

    }
    graphics {
        purchase: spriteset_dmu_spain_renfe_594_trd_purchase;
        cargo_capacity: switch_dmu_spain_renfe_594_trd_capacity_engine;
        visual_effect_and_powered: switch_dmu_spain_renfe_594_trd_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_spain_renfe_594_trd_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(160/10);
        weight: int(49*1/2);
        cargo_capacity: 42;
        length: 8;
        default: switch_dmu_spain_renfe_594_trd_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(27.78187230638057));
        power: int(3200*1/2);
        weight: int(49*3/4);
        cargo_capacity: 42;
        tractive_effort_coefficient: int(0.125*10*49);
        length: 8;
        default: switch_dmu_spain_renfe_594_trd_cargo_selection;
    }
}
