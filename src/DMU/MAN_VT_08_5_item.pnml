// Template: TPL_02A.
// Data from: https://de.wikipedia.org/wiki/DB-Baureihe_VT_08

// Notes:
//// TE_STARTING_KN: =105/2 -- Gemini
//// WAGON_CAPACITY: =INT(108/3) -- Wikipedia


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_man_vt_08_5_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 54/2; \
        bitmask(CC_ARMOURED): 54/4; \
        54; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_man_vt_08_5_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 36/2; \
        bitmask(CC_ARMOURED): 36/4; \
        36; \
    }

item(FEAT_TRAINS, item_dmu_man_vt_08_5) {
    property {
        name: string(str_dmu_man_vt_08_5);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1952,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 39.83281;
        running_cost_factor: 35.32619;
        speed: 140 km/h;
        power: 986 hp;
        cargo_capacity: 54;
        weight: 40 ton;
        tractive_effort_coefficient: 0.133;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "power/diesel", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_dmu_man_vt_08_5_purchase;
        cargo_capacity: switch_dmu_man_vt_08_5_capacity_engine;
        visual_effect_and_powered: switch_dmu_man_vt_08_5_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_man_vt_08_5_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(140/10);
        weight: int(40*1/2);
        cargo_capacity: 36;
        length: 8;
        default: switch_dmu_man_vt_08_5_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(22.50439702695485);
        power: int(986*1/2);
        weight: int(40*3/4);
        cargo_capacity: 36;
        tractive_effort_coefficient: int(0.133*10*40);
        length: 8;
        default: switch_dmu_man_vt_08_5_cargo_selection;
    }
}
