// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_argentina_ganz_arpad_cmu_4701_transandino_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 55/2; \
        bitmask(CC_ARMOURED): 55/4; \
        55; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_argentina_ganz_arpad_cmu_4701_transandino_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 55/2; \
        bitmask(CC_ARMOURED): 55/4; \
        55; \
    }

item(FEAT_TRAINS, item_dmu_argentina_ganz_arpad_cmu_4701_transandino) {
    property {
        name: string(str_dmu_argentina_ganz_arpad_cmu_4701_transandino);
        climates_available: ((param_region_south_america || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1960,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 42.38362;
        running_cost_factor: 37.40767;
        speed: 80 km/h;
        power: 1100 hp;
        cargo_capacity: 55;
        weight: 46 ton;
        tractive_effort_coefficient: 0.084;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [NARROW_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/south", "flag/AR", "power/diesel", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_dmu_argentina_ganz_arpad_cmu_4701_transandino_purchase;
        cargo_capacity: switch_dmu_argentina_ganz_arpad_cmu_4701_transandino_capacity_engine;
        visual_effect_and_powered: switch_dmu_argentina_ganz_arpad_cmu_4701_transandino_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_argentina_ganz_arpad_cmu_4701_transandino_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(80/10);
        weight: int(46*1/2);
        cargo_capacity: 55;
        length: 8;
        default: switch_dmu_argentina_ganz_arpad_cmu_4701_transandino_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(15.180625696382158));
        power: int(1100*1/2);
        weight: int(46*3/4);
        cargo_capacity: 55;
        tractive_effort_coefficient: int(0.084*10*46);
        length: 8;
        default: switch_dmu_argentina_ganz_arpad_cmu_4701_transandino_cargo_selection;
    }
}
