// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/Alstom_Coradia_LINT

// Notes:
//// HEAD_CAPACITY: =52+85 -- 52 seated, 85 standing per car
//// TE_STARTING_KN: =75/2 -- Gemini


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_denmark_arriva_lint_41_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 137/2; \
        bitmask(CC_ARMOURED): 137/4; \
        137; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_denmark_arriva_lint_41_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 137/2; \
        bitmask(CC_ARMOURED): 137/4; \
        137; \
    }

item(FEAT_TRAINS, item_dmu_denmark_arriva_lint_41) {
    property {
        name: string(str_dmu_denmark_arriva_lint_41);
        climates_available: ((param_region_northern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2001,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 30.27629;
        running_cost_factor: 26.72853;
        speed: 120 km/h;
        power: 422 hp;
        cargo_capacity: 137;
        weight: 31 ton;
        tractive_effort_coefficient: 0.123;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/northern", "flag/DK", "power/diesel", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_dmu_denmark_arriva_lint_41_purchase;
        cargo_capacity: switch_dmu_denmark_arriva_lint_41_capacity_engine;
        visual_effect_and_powered: switch_dmu_denmark_arriva_lint_41_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_denmark_arriva_lint_41_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(120/10);
        weight: int(31*1/2);
        cargo_capacity: 137;
        length: 8;
        default: switch_dmu_denmark_arriva_lint_41_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(17.867827969489966));
        power: int(422*1/2);
        weight: int(31*3/4);
        cargo_capacity: 137;
        tractive_effort_coefficient: int(0.123*10*31);
        length: 8;
        default: switch_dmu_denmark_arriva_lint_41_cargo_selection;
    }
}
