// Template: TPL_02A.
// Data from: https://de.wikipedia.org/wiki/DB-Baureihe_642

// Notes:
//// HEAD_CAPACITY: =(98+110)/2 -- standing + seated
//// WAGON_CAPACITY: =PROPERTIES[[#This Row],[HEAD_CAPACITY]] -- Technically, none but hey-ho. This is a 2-unit DMU.


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_siemens_desiro_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 104/2; \
        bitmask(CC_ARMOURED): 104/4; \
        104; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_siemens_desiro_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 104/2; \
        bitmask(CC_ARMOURED): 104/4; \
        104; \
    }

item(FEAT_TRAINS, item_dmu_siemens_desiro) {
    property {
        name: string(str_dmu_siemens_desiro);
        climates_available: (((param_region_northern_europe || param_region_eastern_europe || param_region_southern_europe || param_region_western_europe) || param_region_north_america) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2000,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 41.44969;
        running_cost_factor: 36.61152;
        speed: 120 km/h;
        power: 980 hp;
        cargo_capacity: 104;
        weight: 44 ton;
        tractive_effort_coefficient: 0.098;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/northern", "region/europe/southern", "region/europe/western", "region/europe/eastern", "region/europe/northern", "power/diesel", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_dmu_siemens_desiro_purchase;
        cargo_capacity: switch_dmu_siemens_desiro_capacity_engine;
        visual_effect_and_powered: switch_dmu_siemens_desiro_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_dmu_siemens_desiro_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(120/10);
        weight: int(44*1/2);
        cargo_capacity: 104;
        length: 8;
        default: switch_dmu_siemens_desiro_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(19.442495168499708);
        power: int(980*1/2);
        weight: int(44*3/4);
        cargo_capacity: 104;
        tractive_effort_coefficient: int(0.098*10*44);
        length: 8;
        default: switch_dmu_siemens_desiro_cargo_selection;
    }
}
