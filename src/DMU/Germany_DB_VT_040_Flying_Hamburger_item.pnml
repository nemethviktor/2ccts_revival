//// TE_STARTING_KN: =53/2 -- //www.dbtrains.com/en/trainsets/epochII/SVT_Hamburg/
//// WAGON_CAPACITY: =INT(139/2) -- 2nd class 30, 3rd class 109


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_germany_db_vt_040_flying_hamburger_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 55/2; \
        bitmask(CC_ARMOURED): 55/4; \
        55; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_germany_db_vt_040_flying_hamburger_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 69/2; \
        bitmask(CC_ARMOURED): 69/4; \
        69; \
    }

item(FEAT_TRAINS, item_dmu_germany_db_vt_040_flying_hamburger) {
    property {
        name: string(str_dmu_germany_db_vt_040_flying_hamburger);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1932,1,1);
        model_life: 45;
        vehicle_life: 30;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 37.4772;
        running_cost_factor: 32.71588;
        speed: 160 km/h;
        power: 810 hp;
        cargo_capacity: 55;
        weight: 42 ton;
        tractive_effort_coefficient: 0.064;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "flag/DE", "power/diesel", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_dmu_germany_db_vt_040_flying_hamburger_purchase;
        cargo_capacity: switch_dmu_germany_db_vt_040_flying_hamburger_capacity_engine;
        visual_effect_and_powered: switch_dmu_germany_db_vt_040_flying_hamburger_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_germany_db_vt_040_flying_hamburger_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(160/10);
        weight: int(42*1/2);
        cargo_capacity: 69;
        length: 8;
        default: switch_dmu_germany_db_vt_040_flying_hamburger_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(21.566062103728065));
        power: int(810*1/2);
        weight: int(42*3/4);
        cargo_capacity: 69;
        tractive_effort_coefficient: int(0.064*10*42);
        length: 8;
        default: switch_dmu_germany_db_vt_040_flying_hamburger_cargo_selection;
    }
}
