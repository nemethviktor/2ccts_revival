// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/Transwa_WDA/WDB/WDC_class

// Notes:
//// TE_STARTING_KN: =160/2 -- Gemini
//// WAGON_CAPACITY: 68 -- Again, none, really, this doesn't take trailers IRL


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_ugl_wd_prospector_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 68/2; \
        bitmask(CC_ARMOURED): 68/4; \
        68; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_ugl_wd_prospector_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 68/2; \
        bitmask(CC_ARMOURED): 68/4; \
        68; \
    }

item(FEAT_TRAINS, item_dmu_ugl_wd_prospector) {
    property {
        name: string(str_dmu_ugl_wd_prospector);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2004,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 40.62624;
        running_cost_factor: 36.76056;
        speed: 200 km/h;
        power: 1040 hp;
        cargo_capacity: 68;
        weight: 33 ton;
        tractive_effort_coefficient: 0.247;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU, TRAIN_FLAG_TILT);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "power/diesel", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_dmu_ugl_wd_prospector_purchase;
        cargo_capacity: switch_dmu_ugl_wd_prospector_capacity_engine;
        visual_effect_and_powered: switch_dmu_ugl_wd_prospector_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_dmu_ugl_wd_prospector_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(200/10);
        weight: int(33*1/2);
        cargo_capacity: 68;
        length: 8;
        default: switch_dmu_ugl_wd_prospector_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: round(31.37590309931942);
        power: int(1040*1/2);
        weight: int(33*3/4);
        cargo_capacity: 68;
        tractive_effort_coefficient: int(0.247*10*33);
        length: 8;
        default: switch_dmu_ugl_wd_prospector_cargo_selection;
    }
}
