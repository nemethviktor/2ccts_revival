// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/KiHa_189_series

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_japan_jr_kiha_189_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 56/2; \
        bitmask(CC_ARMOURED): 56/4; \
        56; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_japan_jr_kiha_189_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 56/2; \
        bitmask(CC_ARMOURED): 56/4; \
        56; \
    }

item(FEAT_TRAINS, item_dmu_japan_jr_kiha_189) {
    property {
        name: string(str_dmu_japan_jr_kiha_189);
        climates_available: ((param_region_asia || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2010,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 39.68481;
        running_cost_factor: 34.3205;
        speed: 130 km/h;
        power: 900 hp;
        cargo_capacity: 56;
        weight: 49 ton;
        tractive_effort_coefficient: 0.114;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [NARROW_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "flag/JP", "power/diesel", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_dmu_japan_jr_kiha_189_purchase;
        cargo_capacity: switch_dmu_japan_jr_kiha_189_capacity_engine;
        visual_effect_and_powered: switch_dmu_japan_jr_kiha_189_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_japan_jr_kiha_189_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(130/10);
        weight: int(49*1/2);
        cargo_capacity: 56;
        length: 7;
        default: switch_dmu_japan_jr_kiha_189_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(21.586005490012838));
        power: int(900*1/2);
        weight: int(49*3/4);
        cargo_capacity: 56;
        tractive_effort_coefficient: int(0.114*10*49);
        length: 7;
        default: switch_dmu_japan_jr_kiha_189_cargo_selection;
    }
}
