// Template: TPL_02A.
// Data from: https://it.wikipedia.org/wiki/Automotrici_FS_ALn_442-448

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_fiat_aln_442_448_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 60/2; \
        bitmask(CC_ARMOURED): 60/4; \
        60; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_fiat_aln_442_448_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 60/2; \
        bitmask(CC_ARMOURED): 60/4; \
        60; \
    }

item(FEAT_TRAINS, item_dmu_fiat_aln_442_448) {
    property {
        name: string(str_dmu_fiat_aln_442_448);
        climates_available: ((param_region_southern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1955,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 45.12;
        running_cost_factor: 47.6;
        speed: 140 km/h;
        power: 1250 hp;
        cargo_capacity: 60;
        weight: 52 ton;
        tractive_effort_coefficient: 0.096;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/southern", "power/diesel", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_dmu_fiat_aln_442_448_purchase;
        cargo_capacity: switch_dmu_fiat_aln_442_448_capacity_engine;
        visual_effect_and_powered: switch_dmu_fiat_aln_442_448_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_dmu_fiat_aln_442_448_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(140/10);
        weight: int(52*1/2);
        cargo_capacity: 60;
        length: 8;
        default: switch_dmu_fiat_aln_442_448_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(22.52753390593274);
        power: int(1250*1/2);
        weight: int(52*3/4);
        cargo_capacity: 60;
        tractive_effort_coefficient: int(0.096*10*52);
        length: 8;
        default: switch_dmu_fiat_aln_442_448_cargo_selection;
    }
}
