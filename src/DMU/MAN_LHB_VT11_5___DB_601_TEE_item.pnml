        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(26.30381575982343);
        power: int(2200*1/2);
        weight: int(22*3/4);
        cargo_capacity: 34;
        tractive_effort_coefficient: int(0.254*10*22);
        length: 8;
        default: switch_dmu_man_lhb_vt11_5___db_601_tee_cargo_selection;
