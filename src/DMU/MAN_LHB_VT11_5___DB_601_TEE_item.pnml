// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_man_lhb_vt11_5___db_601_tee_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 24/2; \
        bitmask(CC_ARMOURED): 24/4; \
        24; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_man_lhb_vt11_5___db_601_tee_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 34/2; \
        bitmask(CC_ARMOURED): 34/4; \
        34; \
    }

item(FEAT_TRAINS, item_dmu_man_lhb_vt11_5___db_601_tee) {
    property {
        name: string(str_dmu_man_lhb_vt11_5___db_601_tee);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1957,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 52.4501;
        running_cost_factor: 49.73414;
        speed: 160 km/h;
        power: 2200 hp;
        cargo_capacity: 24;
        weight: 22 ton;
        tractive_effort_coefficient: 0.254;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "power/diesel", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_dmu_man_lhb_vt11_5___db_601_tee_purchase;
        cargo_capacity: switch_dmu_man_lhb_vt11_5___db_601_tee_capacity_engine;
        visual_effect_and_powered: switch_dmu_man_lhb_vt11_5___db_601_tee_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_dmu_man_lhb_vt11_5___db_601_tee_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(160/10);
        weight: int(22*1/2);
        cargo_capacity: 34;
        length: 8;
