// Template: TPL_02A

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_dmu_uk_br_168_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 42/2; \
        bitmask(CC_ARMOURED): 42/4; \
        42; \
    }


    switch(FEAT_TRAINS, SELF, switch_dmu_uk_br_168_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 42/2; \
        bitmask(CC_ARMOURED): 42/4; \
        42; \
    }

item(FEAT_TRAINS, item_dmu_uk_br_168) {
    property {
        name: string(str_dmu_uk_br_168);
        climates_available: ((param_region_northern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1997,1,1);
        model_life: 45;
        vehicle_life: 20;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 45.78286;
        running_cost_factor: 40.27154;
        speed: 160 km/h;
        power: 1300 hp;
        cargo_capacity: 42;
        weight: 50 ton;
        tractive_effort_coefficient: 0.39;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_dmu_uk_br_168_purchase;
        cargo_capacity: switch_dmu_uk_br_168_capacity_engine;
        purchase_cargo_capacity: 52;
        visual_effect_and_powered: switch_dmu_uk_br_168_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_dmu_uk_br_168_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(160/10);
        weight: int(50*1/2);
        cargo_capacity: 42;
        length: 8;
        default: switch_dmu_uk_br_168_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(39.105551380198236));
        power: int(1300*1/2);
        weight: int(50*3/4);
        cargo_capacity: 42;
        tractive_effort_coefficient: int(0.39*10*50);
        length: 8;
        default: switch_dmu_uk_br_168_cargo_selection;
    }
}
