// Template: TPL_32A

// PURCHASE
spriteset(spriteset_diesel_ltz_2te126_purchase, "gfx/diesel/ltz_2te126.png") {template_purchase(1, 128)}


// VEHICLE
/// A Unit
spriteset(spriteset_diesel_ltz_2te126_a_unit, "gfx/diesel/ltz_2te126.png") {template_2cc_l12(1, 1)}


/// B Unit
spriteset(spriteset_diesel_ltz_2te126_b_unit, "gfx/diesel/ltz_2te126.png") {template_2cc_l12(1, 64)}

switch(FEAT_TRAINS, SELF, switch_diesel_ltz_2te126_position, position_in_vehid_chain % 4) {
	0: spriteset_diesel_ltz_2te126_a_unit;
	2: spriteset_diesel_ltz_2te126_b_unit;
	EMPTY_SPRITESET
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_diesel_ltz_2te126_visual_effect, position_in_vehid_chain % 4) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/// Length
switch(FEAT_TRAINS, SELF, switch_diesel_ltz_2te126_length, position_in_vehid_chain % 4) {
    0: 8;
	2: 8;
	0;
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_diesel_ltz_2te126_articulated, extra_callback_info1) {
    1..3: return item_diesel_ltz_2te126;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

