/*
* PURCHASE
*/

spriteset(spriteset_diesel_USA_GNR_EMD_F3_purchase, "gfx/Diesel/USA_GNR_EMD_F3.png") {
	template_purchase(1, 64)
}

/*
* VEHICLE
*/

//Engine
spriteset(spriteset_diesel_USA_GNR_EMD_F3_engine, "gfx/Diesel/USA_GNR_EMD_F3.png") {
	template_2cc_engines_general(1, 1)
}

//B-unit
spriteset(spriteset_diesel_USA_GNR_EMD_F3_B, "gfx/Diesel/USA_GNR_EMD_F3.png") {
	template_2cc_engines_general(1, 32)
}

//Switch for B-unit
switch(FEAT_TRAINS, SELF, switch_diesel_USA_GNR_EMD_F3_position, position_in_vehid_chain % 2) {
	1: spriteset_diesel_USA_GNR_EMD_F3_B;
	spriteset_diesel_USA_GNR_EMD_F3_engine;
}

