// Template: TPL_17B

// PURCHASE
spriteset(spriteset_diesel_usa_pennsylvania_railroad_rf_16_sharknose_purchase, "gfx/diesel/usa_pennsylvania_railroad_rf_16_sharknose.png") {template_purchase(1, 128)}


/// A Front
spriteset(spriteset_diesel_usa_pennsylvania_railroad_rf_16_sharknose_a_front, "gfx/diesel/usa_pennsylvania_railroad_rf_16_sharknose.png") {template_2cc_engines_general(1, 1)}


/// B Front
spriteset(spriteset_diesel_usa_pennsylvania_railroad_rf_16_sharknose_b_front, "gfx/diesel/usa_pennsylvania_railroad_rf_16_sharknose.png") {template_2cc_engines_general(1, 32)}


/// B Back
spriteset(spriteset_diesel_usa_pennsylvania_railroad_rf_16_sharknose_b_back, "gfx/diesel/usa_pennsylvania_railroad_rf_16_sharknose.png") {template_2cc_engines_general(1, 64)}


/// A Back
spriteset(spriteset_diesel_usa_pennsylvania_railroad_rf_16_sharknose_a_back, "gfx/diesel/usa_pennsylvania_railroad_rf_16_sharknose.png") {template_2cc_engines_general(1, 96)}

switch(FEAT_TRAINS, SELF, switch_diesel_usa_pennsylvania_railroad_rf_16_sharknose_position, position_in_vehid_chain % 4) {
	1: spriteset_diesel_usa_pennsylvania_railroad_rf_16_sharknose_b_front;
	2: spriteset_diesel_usa_pennsylvania_railroad_rf_16_sharknose_b_back;
	3: spriteset_diesel_usa_pennsylvania_railroad_rf_16_sharknose_a_back;
	spriteset_diesel_usa_pennsylvania_railroad_rf_16_sharknose_a_front;
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_diesel_usa_pennsylvania_railroad_rf_16_sharknose_visual_effect, position_in_vehid_chain % 4) {
	2..3: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -3, DISABLE_WAGON_POWER);
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_diesel_usa_pennsylvania_railroad_rf_16_sharknose_articulated, extra_callback_info1) {
    1: return item_diesel_usa_pennsylvania_railroad_rf_16_sharknose;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
