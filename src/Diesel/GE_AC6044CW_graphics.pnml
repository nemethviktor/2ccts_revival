// Template: TPL_16A

// PURCHASE
spriteset(spriteset_diesel_ge_ac6044cw_purchase, "gfx/diesel/ge_ac6044cw.png") {template_purchase(1, 128)}


// VEHICLE

// // This vehicle uses the template for length 12.
// // The vehicle is built with 3 pieces of length 8+4
// // The middle part gets the graphics, the other parts are left blank

/// Engine
spriteset(spriteset_diesel_ge_ac6044cw_engine, "gfx/diesel/ge_ac6044cw.png") {template_2cc_l12(1, 1)}

switch(FEAT_TRAINS, SELF, switch_diesel_ge_ac6044cw_position, position_in_vehid_chain % 2) {
	0: spriteset_diesel_ge_ac6044cw_engine;
	EMPTY_SPRITESET
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_diesel_ge_ac6044cw_visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/// Length
switch(FEAT_TRAINS, SELF, switch_diesel_ge_ac6044cw_length, position_in_vehid_chain % 2) {
    0: 8;
	2;
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_diesel_ge_ac6044cw_articulated, extra_callback_info1) {
    1: return item_diesel_ge_ac6044cw;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
