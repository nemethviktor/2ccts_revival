/*
* PURCHASE
*/

spriteset(spriteset_diesel_Ukraine_UZ_2TE10Ut_purchase, "gfx/Diesel/Ukraine_UZ_2TE10Ut.png") {
	template_purchase(1, 64)
}

/*
* VEHICLE
*/

//Engine
spriteset(spriteset_diesel_Ukraine_UZ_2TE10Ut_front, "gfx/Diesel/Ukraine_UZ_2TE10Ut.png") {
	template_2cc_engines_general(1, 1)
}

spriteset(spriteset_diesel_Ukraine_UZ_2TE10Ut_back, "gfx/Diesel/Ukraine_UZ_2TE10Ut.png") {
	template_2cc_engines_general(1, 32)
}

switch(FEAT_TRAINS, SELF, switch_diesel_Ukraine_UZ_2TE10Ut_position, position_in_vehid_chain % 2){
	0: spriteset_diesel_Ukraine_UZ_2TE10Ut_front;
	spriteset_diesel_Ukraine_UZ_2TE10Ut_back;
}

/*
* Visual effect
*/

switch(FEAT_TRAINS, SELF, switch_diesel_Ukraine_UZ_2TE10Ut_visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

switch(FEAT_TRAINS, SELF, switch_diesel_Ukraine_UZ_2TE10Ut_articulated, extra_callback_info1) {
	1: return item_diesel_Ukraine_UZ_2TE10Ut;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

