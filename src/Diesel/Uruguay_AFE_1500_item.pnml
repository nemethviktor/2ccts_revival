item(FEAT_TRAINS, item_diesel_uruguay_afe_1500) {
    property {
        name: string(str_diesel_uruguay_afe_1500);
        climates_available: ((param_region_south_america || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1952,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 0/2 : (param_loadingspeed == 2) ? 0*2 : 0;
        cost_factor: 50.4682;
        running_cost_factor: 38.83751;
        speed: 110 km/h;
        power: 1500 hp;
        cargo_capacity: 0;
        weight: 112 ton;
        tractive_effort_coefficient: 0.232;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/south", "flag/UY", "power/diesel", "role/general_purpose"];

    }
    graphics {
        purchase: spriteset_diesel_uruguay_afe_1500_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: spriteset_diesel_uruguay_afe_1500;
    }
}
