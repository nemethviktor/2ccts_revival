// Template: TPL_03C

// PURCHASE
spriteset(spriteset_diesel_great_southern_railway_dh501_purchase, "gfx/diesel/great_southern_railway_dh501.png") {template_purchase(1, 96)}


// VEHICLE
/// Engine1
spriteset(spriteset_diesel_great_southern_railway_dh501_engine1, "gfx/diesel/great_southern_railway_dh501.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_diesel_great_southern_railway_dh501_engine2, "gfx/diesel/great_southern_railway_dh501.png") {template_2cc_engines_general(1, 32)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_diesel_great_southern_railway_dh501_animation, motion_counter % 2){
	0: spriteset_diesel_great_southern_railway_dh501_engine1;
	spriteset_diesel_great_southern_railway_dh501_engine2;
}