item(FEAT_TRAINS, item_diesel_ltz_2te10m) {
    property {
        name: string(str_diesel_ltz_2te10m);
        climates_available: ((((param_region_asia || param_region_eastern_europe) || param_region_northern_europe) || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1981,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 106.58567;
        running_cost_factor: 78.58567;
        speed: 100 km/h;
        power: 6160 hp;
        cargo_capacity: 0;
        weight: 276 ton;
        tractive_effort_coefficient: 0.29;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [BROAD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "region/europe/eastern", "region/europe/northern", "power/diesel", "role/heavy_freight"];

    }
    graphics {
        purchase: spriteset_diesel_ltz_2te10m_purchase;
        visual_effect_and_powered: switch_diesel_ltz_2te10m_visual_effect;
        // no 'length'
        articulated_part: switch_diesel_ltz_2te10m_articulated;
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_diesel_ltz_2te10m_position;
    }
}
