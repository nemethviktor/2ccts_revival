// Template: TPL_03F

// PURCHASE
spriteset(spriteset_diesel_panama_panama_canal_railway_emd_f40ph_purchase, "gfx/diesel/panama_panama_canal_railway_emd_f40ph.png") {template_purchase(1, 64)}


// VEHICLE
/// Engine
spriteset(spriteset_diesel_panama_panama_canal_railway_emd_f40ph_engine, "gfx/diesel/panama_panama_canal_railway_emd_f40ph.png") {template_2cc_engines_general(1, 1)}


/// B Unit
spriteset(spriteset_diesel_panama_panama_canal_railway_emd_f40ph_b_unit, "gfx/diesel/panama_panama_canal_railway_emd_f40ph.png") {template_2cc_engines_general(1, 32)}

switch(FEAT_TRAINS, SELF, switch_diesel_panama_panama_canal_railway_emd_f40ph_position, position_in_vehid_chain % 2) {
	0: spriteset_diesel_panama_panama_canal_railway_emd_f40ph_engine;
	spriteset_diesel_panama_panama_canal_railway_emd_f40ph_b_unit;
}