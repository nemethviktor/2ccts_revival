// Template: TPL_03F

// PURCHASE
spriteset(spriteset_diesel_ltz_te10m_purchase, "gfx/diesel/ltz_te10m.png") {template_purchase(1, 64)}


// VEHICLE
/// Engine
spriteset(spriteset_diesel_ltz_te10m_engine, "gfx/diesel/ltz_te10m.png") {template_2cc_engines_general(1, 1)}


/// B Unit
spriteset(spriteset_diesel_ltz_te10m_b_unit, "gfx/diesel/ltz_te10m.png") {template_2cc_engines_general(1, 32)}

switch(FEAT_TRAINS, SELF, switch_diesel_ltz_te10m_position, position_in_vehid_chain % 2) {
	0: spriteset_diesel_ltz_te10m_engine;
	spriteset_diesel_ltz_te10m_b_unit;
}