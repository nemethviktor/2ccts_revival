item(FEAT_TRAINS, item_diesel_henschel_ge_g16) {
    property {
        name: string(str_diesel_henschel_ge_g16);
        climates_available: ((param_region_africa || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1962,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 62.27;
        running_cost_factor: 51.69;
        speed: 105 km/h;
        power: 1950 hp;
        cargo_capacity: 0;
        weight: 176 ton;
        tractive_effort_coefficient: 0.297;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [NARROW_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/africa", "power/diesel", "role/heavy_freight"];

    }
    graphics {
        purchase: spriteset_diesel_henschel_ge_g16_purchase;
        visual_effect_and_powered: switch_diesel_henschel_ge_g16_visual_effect;
        length: switch_diesel_henschel_ge_g16_length;
        articulated_part: switch_diesel_henschel_ge_g16_articulated;
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_diesel_henschel_ge_g16_position;
    }
}
