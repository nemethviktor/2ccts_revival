// Template: TPL_03B

// PURCHASE
spriteset(spriteset_diesel_lms_7051_diesel_shunter_purchase, "gfx/diesel/lms_7051_diesel_shunter.png") {template_purchase(1, 64)}


// VEHICLE
/// Engine1
spriteset(spriteset_diesel_lms_7051_diesel_shunter_engine1, "gfx/diesel/lms_7051_diesel_shunter.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_diesel_lms_7051_diesel_shunter_engine2, "gfx/diesel/lms_7051_diesel_shunter.png") {template_2cc_engines_general(1, 32)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_diesel_lms_7051_diesel_shunter_animation, motion_counter % 2){
	0: spriteset_diesel_lms_7051_diesel_shunter_engine1;
	spriteset_diesel_lms_7051_diesel_shunter_engine2;
}