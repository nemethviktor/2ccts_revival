// Template: TPL_03F

// PURCHASE
spriteset(spriteset_diesel_emc_e3_purchase, "gfx/diesel/emc_e3.png") {template_purchase(1, 64)}


// VEHICLE
/// Engine
spriteset(spriteset_diesel_emc_e3_engine, "gfx/diesel/emc_e3.png") {template_2cc_engines_general(1, 1)}


/// B Unit
spriteset(spriteset_diesel_emc_e3_b_unit, "gfx/diesel/emc_e3.png") {template_2cc_engines_general(1, 32)}

switch(FEAT_TRAINS, SELF, switch_diesel_emc_e3_position, position_in_vehid_chain % 2) {
	0: spriteset_diesel_emc_e3_engine;
	spriteset_diesel_emc_e3_b_unit;
}