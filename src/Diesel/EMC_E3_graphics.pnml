// Template: TPL_03D

// PURCHASE
spriteset(spriteset_diesel_emc_e3_purchase, "gfx/diesel/emc_e3.png") {template_purchase(1, 64)}


// VEHICLE
/// Engine
spriteset(spriteset_diesel_emc_e3_engine, "gfx/diesel/emc_e3.png") {template_2cc_engines_general(1, 1)}


/// Tender
spriteset(spriteset_diesel_emc_e3_tender, "gfx/diesel/emc_e3.png") {template_2cc_engines_general(1, 32)}

switch(FEAT_TRAINS, SELF, switch_diesel_emc_e3_position, position_in_vehid_chain % 2) {
	0: spriteset_diesel_emc_e3_engine;
	spriteset_diesel_emc_e3_tender;
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_diesel_emc_e3_visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/// Length
switch(FEAT_TRAINS, SELF, switch_diesel_emc_e3_length, position_in_vehid_chain % 2) {
    0: 8;
	8;
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_diesel_emc_e3_articulated, extra_callback_info1) {
    1: return item_diesel_emc_e3;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
