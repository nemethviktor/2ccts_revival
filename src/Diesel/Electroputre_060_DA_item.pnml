item(FEAT_TRAINS, item_diesel_electroputre_060_da) {
    property {
        name: string(str_diesel_electroputre_060_da);
        climates_available: (((param_region_asia || param_region_eastern_europe) || param_region_southern_europe || param_region_western_europe) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1959,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 57.59725;
        running_cost_factor: 45.59725;
        speed: 100 km/h;
        power: 2070 hp;
        cargo_capacity: 0;
        weight: 116 ton;
        tractive_effort_coefficient: 0.27;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE, BROAD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "region/europe/southern", "region/europe/western", "region/europe/eastern", "power/diesel", "role/universal"];

    }
    graphics {
        purchase: spriteset_diesel_electroputre_060_da_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: spriteset_diesel_electroputre_060_da;
    }
}
