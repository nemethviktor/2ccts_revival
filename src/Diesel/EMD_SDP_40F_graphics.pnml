// Template: TPL_03F

// PURCHASE
spriteset(spriteset_diesel_emd_sdp_40f_purchase, "gfx/diesel/emd_sdp_40f.png") {template_purchase(1, 64)}


// VEHICLE
/// Engine
spriteset(spriteset_diesel_emd_sdp_40f_engine, "gfx/diesel/emd_sdp_40f.png") {template_2cc_engines_general(1, 1)}


/// B Unit
spriteset(spriteset_diesel_emd_sdp_40f_b_unit, "gfx/diesel/emd_sdp_40f.png") {template_2cc_engines_general(1, 32)}

switch(FEAT_TRAINS, SELF, switch_diesel_emd_sdp_40f_position, position_in_vehid_chain % 2) {
	0: spriteset_diesel_emd_sdp_40f_engine;
	spriteset_diesel_emd_sdp_40f_b_unit;
}