// Template: TPL_17A

// PURCHASE
spriteset(spriteset_diesel_ltz_2te10ut_purchase, "gfx/diesel/ltz_2te10ut.png") {template_purchase(1, 64)}


/// Front
spriteset(spriteset_diesel_ltz_2te10ut_front, "gfx/diesel/ltz_2te10ut.png") {template_2cc_engines_general(1, 1)}


/// Back
spriteset(spriteset_diesel_ltz_2te10ut_back, "gfx/diesel/ltz_2te10ut.png") {template_2cc_engines_general(1, 32)}

switch(FEAT_TRAINS, SELF, switch_diesel_ltz_2te10ut_position, position_in_vehid_chain % 2) {
	0: spriteset_diesel_ltz_2te10ut_front;
	spriteset_diesel_ltz_2te10ut_back;
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_diesel_ltz_2te10ut_visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_diesel_ltz_2te10ut_articulated, extra_callback_info1) {
    1: return item_diesel_ltz_2te10ut;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
