// Template: TPL_03B

// PURCHASE
spriteset(spriteset_diesel_bmag_wr_200_b_14_purchase, "gfx/diesel/bmag_wr_200_b_14.png") {template_purchase(1, 64)}


// VEHICLE
/// Engine1
spriteset(spriteset_diesel_bmag_wr_200_b_14_engine1, "gfx/diesel/bmag_wr_200_b_14.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_diesel_bmag_wr_200_b_14_engine2, "gfx/diesel/bmag_wr_200_b_14.png") {template_2cc_engines_general(1, 32)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_diesel_bmag_wr_200_b_14_animation, motion_counter % 2){
	0: spriteset_diesel_bmag_wr_200_b_14_engine1;
	spriteset_diesel_bmag_wr_200_b_14_engine2;
}