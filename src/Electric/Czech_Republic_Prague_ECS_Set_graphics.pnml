/*
* PURCHASE
*/

spriteset(spriteset_mtro_Czech_Republic_Prague_ECS_Set_purchase, "gfx/Metro/Czech_Republic_Prague_ECS_Set.png") {
	template_purchase_dualheaded(1, 96)
}

/*
* VEHICLE
*/

//Front
spriteset(spriteset_mtro_Czech_Republic_Prague_ECS_Set_front, "gfx/Metro/Czech_Republic_Prague_ECS_Set.png") {
	template_2cc_engines_general(1, 1)
}

//Back
spriteset(spriteset_mtro_Czech_Republic_Prague_ECS_Set_back, "gfx/Metro/Czech_Republic_Prague_ECS_Set.png") {
	template_2cc_engines_general(1, 32)
}

//Middle - PAX
spriteset(spriteset_mtro_Czech_Republic_Prague_ECS_Set_middle, "gfx/Metro/Czech_Republic_Prague_ECS_Set.png") {
	template_2cc_engines_general(1, 64)
}

//Dualheaded engines
switch(FEAT_TRAINS, SELF, switch_mtro_Czech_Republic_Prague_ECS_Set_reversed, var[0xC8]) {
	0xFE: spriteset_mtro_Czech_Republic_Prague_ECS_Set_back;
    0xFF: spriteset_mtro_Czech_Republic_Prague_ECS_Set_back; 
    spriteset_mtro_Czech_Republic_Prague_ECS_Set_front;
}

//Add defined switches

RUNNINGCOST_ENGINE_SWITCH

PURCHASETEXT_SWITCH