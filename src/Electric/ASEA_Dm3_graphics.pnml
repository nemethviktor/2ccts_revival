// Template: TPL_17D

// PURCHASE
spriteset(spriteset_electric_asea_dm3_purchase, "gfx/electric/asea_dm3.png") {template_purchase(1, 192)}


/// Front1
spriteset(spriteset_electric_asea_dm3_front1, "gfx/electric/asea_dm3.png") {template_2cc_engines_general(1, 1)}


/// Front2
spriteset(spriteset_electric_asea_dm3_front2, "gfx/electric/asea_dm3.png") {template_2cc_engines_general(1, 32)}


/// Middle1
spriteset(spriteset_electric_asea_dm3_middle1, "gfx/electric/asea_dm3.png") {template_2cc_engines_general(1, 64)}


/// Middle2
spriteset(spriteset_electric_asea_dm3_middle2, "gfx/electric/asea_dm3.png") {template_2cc_engines_general(1, 96)}


/// Back1
spriteset(spriteset_electric_asea_dm3_back1, "gfx/electric/asea_dm3.png") {template_2cc_engines_general(1, 128)}


/// Back2
spriteset(spriteset_electric_asea_dm3_back2, "gfx/electric/asea_dm3.png") {template_2cc_engines_general(1, 160)}


/// Animation states (animation_front)
switch(FEAT_TRAINS, SELF, switch_electric_asea_dm3_animation_front, motion_counter % 2){
	0: spriteset_electric_asea_dm3_front1;
	spriteset_electric_asea_dm3_front2;
}

/// Animation states (animation_middle)
switch(FEAT_TRAINS, SELF, switch_electric_asea_dm3_animation_middle, motion_counter % 2){
	0: spriteset_electric_asea_dm3_middle1;
	spriteset_electric_asea_dm3_middle2;
}

/// Animation states (animation_back)
switch(FEAT_TRAINS, SELF, switch_electric_asea_dm3_animation_back, motion_counter % 2){
	0: spriteset_electric_asea_dm3_back1;
	spriteset_electric_asea_dm3_back2;
}
switch(FEAT_TRAINS, SELF, switch_electric_asea_dm3_position, position_in_vehid_chain % 3) {
	0: switch_electric_asea_dm3_animation_front;
	1: switch_electric_asea_dm3_animation_middle;
	switch_electric_asea_dm3_animation_back;
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_electric_asea_dm3_visual_effect, position_in_vehid_chain % 3) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/// Length
switch(FEAT_TRAINS, SELF, switch_electric_asea_dm3_length, position_in_vehid_chain % 3) {
    1: 6;
	7;
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_electric_asea_dm3_articulated, extra_callback_info1) {
    1..2: return item_electric_asea_dm3;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
