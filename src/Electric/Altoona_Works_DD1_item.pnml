        visual_effect_and_powered: switch_electric_altoona_works_dd1_visual_effect;
        length: switch_electric_altoona_works_dd1_length;
        articulated_part: switch_electric_altoona_works_dd1_articulated;
        can_attach_wagon: switch_can_attach_vehicle;
