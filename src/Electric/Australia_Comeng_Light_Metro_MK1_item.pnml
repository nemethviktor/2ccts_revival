// Template: TPL_02C.
// Data from: nan

// Notes:
//// WEB: NA -- Taken from Ragan's set as COMERT Mk1, fwiw it's a concept vehicle


item(FEAT_TRAINS, item_mtro_australia_comeng_light_metro_mk1) {
    property {
        name: string(str_mtro_australia_comeng_light_metro_mk1);
        climates_available: ((param_region_oceania || 0) && param_concept) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1965,1,1);
        model_life: 45;
        vehicle_life: 60;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 30.49289;
        running_cost_factor: 27.87981;
        speed: 100 km/h;
        power: 500 hp;
        cargo_capacity: 100;
        weight: 22 ton;
        tractive_effort_coefficient: 0.25;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [BROAD_GAUGE_RAILTYPE_3RD];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "flag/AU", "power/metro", "role/metro"];

    }
    graphics {
        purchase: spriteset_mtro_australia_comeng_light_metro_mk1_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_mtro_australia_comeng_light_metro_mk1_reversed;
    }
    livery_override (item_mtro_metro_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: int(100/10);
        weight: int(22*1/2);
        cargo_capacity: 80;
        length: 8;
        default: spriteset_mtro_australia_comeng_light_metro_mk1_middle;
    }
    livery_override (item_mtro_metro_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: (round(17.736313276997155));
        power: int(500*1/2);
        weight: int(22*3/4);
        cargo_capacity: 80;
        tractive_effort_coefficient: int(0.25*10*22);
        length: 8;
        default: spriteset_mtro_australia_comeng_light_metro_mk1_middle;
    }
}
