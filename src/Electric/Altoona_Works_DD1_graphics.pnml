// Template: TPL_17E

// PURCHASE
spriteset(spriteset_electric_altoona_works_dd1_purchase, "gfx/electric/altoona_works_dd1.png") {template_purchase(1, 128)}


/// Front 1
spriteset(spriteset_electric_altoona_works_dd1_front_1, "gfx/electric/altoona_works_dd1.png") {template_2cc_engines_general(1, 1)}


/// Front 2
spriteset(spriteset_electric_altoona_works_dd1_front_2, "gfx/electric/altoona_works_dd1.png") {template_2cc_engines_general(1, 32)}


/// Back 1
spriteset(spriteset_electric_altoona_works_dd1_back_1, "gfx/electric/altoona_works_dd1.png") {template_2cc_engines_general(1, 64)}


/// Back 2
spriteset(spriteset_electric_altoona_works_dd1_back_2, "gfx/electric/altoona_works_dd1.png") {template_2cc_engines_general(1, 96)}


/// Animation states (animation_front)
switch(FEAT_TRAINS, SELF, switch_electric_altoona_works_dd1_animation_front, motion_counter % 2){
	0: spriteset_electric_altoona_works_dd1_front_1;
	spriteset_electric_altoona_works_dd1_front_2;
}

/// Animation states (animation_back)
switch(FEAT_TRAINS, SELF, switch_electric_altoona_works_dd1_animation_back, motion_counter % 2){
	0: spriteset_electric_altoona_works_dd1_back_1;
	spriteset_electric_altoona_works_dd1_back_2;
}
switch(FEAT_TRAINS, SELF, switch_electric_altoona_works_dd1_position, position_in_vehid_chain % 2) {
	0: switch_electric_altoona_works_dd1_animation_front;
	switch_electric_altoona_works_dd1_animation_back;
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_electric_altoona_works_dd1_visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/// Length
switch(FEAT_TRAINS, SELF, switch_electric_altoona_works_dd1_length, position_in_vehid_chain % 2) {
    0: 5;
	5;
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_electric_altoona_works_dd1_articulated, extra_callback_info1) {
    1: return item_electric_altoona_works_dd1;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
