/*
* PURCHASE
*/

spriteset(spriteset_electric_Austria_OBB_1161_purchase, "gfx/Electric/Austria_OBB_1161.png") {
	template_purchase(1, 64)
}

/*
* VEHICLE
*/

//Engine
spriteset(spriteset_electric_Austria_OBB_1161_engine1, "gfx/Electric/Austria_OBB_1161.png") {
	template_2cc_engines_general(1, 1)
}

spriteset(spriteset_electric_Austria_OBB_1161_engine2, "gfx/Electric/Austria_OBB_1161.png") {
	template_2cc_engines_general(1, 32)
}

//Animation states
switch(FEAT_TRAINS, SELF, switch_electric_Austria_OBB_1161_animation, motion_counter % 2){
	0: spriteset_electric_Austria_OBB_1161_engine1;
	spriteset_electric_Austria_OBB_1161_engine2;
}

