item(FEAT_TRAINS, item_electric_slm_abb_lok_2000) {
    property {
        name: string(str_electric_slm_abb_lok_2000);
        climates_available: (((param_region_northern_europe || param_region_western_europe) || param_region_asia) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1991,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 95.82;
        running_cost_factor: 98.48;
        speed: 230 km/h;
        power: 7510 hp;
        cargo_capacity: 0;
        weight: 84 ton;
        tractive_effort_coefficient: 0.364;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_25KV, STANDARD_GAUGE_RAILTYPE_15KV, BROAD_GAUGE_RAILTYPE_25KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -3, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "region/europe/western", "region/europe/northern", "power/electric/ac", "role/express"];

    }
    graphics {
        purchase: spriteset_electric_slm_abb_lok_2000_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: spriteset_electric_slm_abb_lok_2000;
    }
}
