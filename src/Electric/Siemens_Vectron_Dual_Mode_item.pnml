// Template: TPL_01A.
// Data from: https://en.wikipedia.org/wiki/Vectron_(locomotive)


// Dual-mode vehicle -> Check if the tile the vehicle is currently on provides power to this rail vehicle
switch (FEAT_TRAINS, SELF, sw_loco_visual_effect_electric_siemens_vectron_dual_mode, tile_powers_railtype("ELRL")) {
    1: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);
    visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);
}

item(FEAT_TRAINS, item_electric_siemens_vectron_dual_mode) {
    property {
        name: string(str_electric_siemens_vectron_dual_mode);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2026,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 61.02049;
        running_cost_factor: 51.91452;
        speed: 160 km/h;
        power: 2682 hp;
        cargo_capacity: 0;
        weight: 86 ton;
        tractive_effort_coefficient: 0.356;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_15KV, STANDARD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "power/dual", "role/express"];

    }
    graphics {
        visual_effect_and_powered: sw_loco_visual_effect_electric_siemens_vectron_dual_mode;
        purchase: spriteset_electric_siemens_vectron_dual_mode_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: spriteset_electric_siemens_vectron_dual_mode;
    }
}
