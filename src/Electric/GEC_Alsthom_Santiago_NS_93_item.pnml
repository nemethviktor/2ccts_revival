    livery_override (item_mtro_metro_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: round(23.473979485566353);
        power: int(2400*1/2);
        weight: int(24*3/4);
        cargo_capacity: 116;
        tractive_effort_coefficient: int(0.35*10*24);
