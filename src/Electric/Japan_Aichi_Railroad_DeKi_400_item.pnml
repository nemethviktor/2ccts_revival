// Notes:
//// TE_STARTING_KN: 78 -- Gemini --> the JP Wiki says 47.5 but it's explicitly stated there it's the 1-hr rated, not starting


item(FEAT_TRAINS, item_electric_japan_aichi_railroad_deki_400) {
    property {
        name: string(str_electric_japan_aichi_railroad_deki_400);
        climates_available: ((param_region_asia || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1930,1,1);
        model_life: 45;
        vehicle_life: 63;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 26.28344;
        running_cost_factor: 22.02266;
        speed: 28 km/h;
        power: 482 hp;
        cargo_capacity: 0;
        weight: 40 ton;
        tractive_effort_coefficient: 0.199;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [NARROW_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 6;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "flag/JP", "power/electric/dc", "role/shunting"];

    }
    graphics {
        purchase: spriteset_electric_japan_aichi_railroad_deki_400_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: spriteset_electric_japan_aichi_railroad_deki_400;
    }
}
