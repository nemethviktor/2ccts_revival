// Data from: https://es.wikipedia.org/wiki/Material_rodante_del_subte_de_Buenos_Aires

item(FEAT_TRAINS, item_mtro_hitachi_buenos_aires_serie_1200) {
    property {
        name: string(str_mtro_hitachi_buenos_aires_serie_1200);
        climates_available: ((param_region_south_america || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1999,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 50;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 33.67314;
        running_cost_factor: 30.97673;
        speed: 75 km/h;
        power: 640 hp;
        cargo_capacity: 115;
        weight: 23 ton;
        tractive_effort_coefficient: 0.23;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_3RD];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/south", "power/metro", "role/metro"];

    }
    graphics {
        purchase: spriteset_mtro_hitachi_buenos_aires_serie_1200_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_mtro_hitachi_buenos_aires_serie_1200_reversed;
    }
    livery_override (item_mtro_metro_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: int(75/10);
        weight: int(23*1/2);
        cargo_capacity: 162;
        length: 7;
        default: spriteset_mtro_hitachi_buenos_aires_serie_1200_middle;
    }
    livery_override (item_mtro_metro_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: round(15.434822128134705);
        power: int(640*1/2);
        weight: int(23*3/4);
        cargo_capacity: 162;
        tractive_effort_coefficient: int(0.23*10*23);
        length: 7;
        default: spriteset_mtro_hitachi_buenos_aires_serie_1200_middle;
    }
}
