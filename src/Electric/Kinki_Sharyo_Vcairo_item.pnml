// Template: TPL_02C.
// Data from: https://en.wikipedia.org/wiki/Cairo_Metro_Line_1

item(FEAT_TRAINS, item_mtro_kinki_sharyo_vcairo) {
    property {
        name: string(str_mtro_kinki_sharyo_vcairo);
        climates_available: ((param_region_africa || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1987,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 50;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 49.01;
        running_cost_factor: 51.74;
        speed: 100 km/h;
        power: 1450 hp;
        cargo_capacity: 165;
        weight: 37 ton;
        tractive_effort_coefficient: 0.26;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_3RD];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/africa", "power/metro", "role/metro"];

    }
    graphics {
        purchase: spriteset_mtro_kinki_sharyo_vcairo_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_mtro_kinki_sharyo_vcairo_reversed;
    }
    livery_override (item_mtro_metro_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: int(100/10);
        weight: int(37*1/2);
        cargo_capacity: 250;
        length: 8;
        default: spriteset_mtro_kinki_sharyo_vcairo_middle;
    }
    livery_override (item_mtro_metro_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: round(23.557886552931954);
        power: int(1450*1/2);
        weight: int(37*3/4);
        cargo_capacity: 250;
        tractive_effort_coefficient: int(0.26*10*37);
        length: 8;
        default: spriteset_mtro_kinki_sharyo_vcairo_middle;
    }
}
