// Template: TPL_02C.
// Data from: https://pt.wikipedia.org/wiki/Material_circulante_do_Metropolitano_de_Lisboa#ML7

item(FEAT_TRAINS, item_mtro_lhb_lisbon_ml7) {
    property {
        name: string(str_mtro_lhb_lisbon_ml7);
        climates_available: ((param_region_southern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1959,1,1);
        model_life: 45;
        vehicle_life: 50;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 27.87351;
        running_cost_factor: 25.66367;
        speed: 60 km/h;
        power: 430 hp;
        cargo_capacity: 85;
        weight: 19 ton;
        tractive_effort_coefficient: 0.24;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_3RD];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/southern", "power/metro", "role/metro"];

    }
    graphics {
        purchase: spriteset_mtro_lhb_lisbon_ml7_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_mtro_lhb_lisbon_ml7_reversed;
    }
    livery_override (item_mtro_metro_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: int(60/10);
        weight: int(19*1/2);
        cargo_capacity: 160;
        length: 8;
        default: spriteset_mtro_lhb_lisbon_ml7_middle;
    }
    livery_override (item_mtro_metro_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: round(12.633644135332773);
        power: int(430*1/2);
        weight: int(19*3/4);
        cargo_capacity: 160;
        tractive_effort_coefficient: int(0.24*10*19);
        length: 8;
        default: spriteset_mtro_lhb_lisbon_ml7_middle;
    }
}
