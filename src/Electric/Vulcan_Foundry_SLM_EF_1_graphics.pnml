// Template: TPL_03B

// PURCHASE
spriteset(spriteset_electric_vulcan_foundry_slm_ef_1_purchase, "gfx/electric/vulcan_foundry_slm_ef_1.png") {template_purchase(1, 64)}


// VEHICLE
/// Engine1
spriteset(spriteset_electric_vulcan_foundry_slm_ef_1_engine1, "gfx/electric/vulcan_foundry_slm_ef_1.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_electric_vulcan_foundry_slm_ef_1_engine2, "gfx/electric/vulcan_foundry_slm_ef_1.png") {template_2cc_engines_general(1, 32)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_electric_vulcan_foundry_slm_ef_1_animation, motion_counter % 2){
	0: spriteset_electric_vulcan_foundry_slm_ef_1_engine1;
	spriteset_electric_vulcan_foundry_slm_ef_1_engine2;
}