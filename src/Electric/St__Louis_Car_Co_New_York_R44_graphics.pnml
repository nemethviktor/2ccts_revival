// Template: TPL_02C

// PURCHASE
spriteset(spriteset_mtro_st__louis_car_co_new_york_r44_purchase, "gfx/electric/st__louis_car_co_new_york_r44.png") {template_purchase_dualheaded(1, 96)}


// VEHICLE
/// Front
spriteset(spriteset_mtro_st__louis_car_co_new_york_r44_front, "gfx/electric/st__louis_car_co_new_york_r44.png") {template_2cc_engines_general(1, 1)}


// VEHICLE
/// Back
spriteset(spriteset_mtro_st__louis_car_co_new_york_r44_back, "gfx/electric/st__louis_car_co_new_york_r44.png") {template_2cc_engines_general(1, 32)}


/// MIDDLE
spriteset(spriteset_mtro_st__louis_car_co_new_york_r44_middle, "gfx/electric/st__louis_car_co_new_york_r44.png") {template_2cc_engines_general(1, 64)}


/// Dualheaded (reverse switch)
/// In the context of var[0xC8] (which is the variable for "position in consist"):
/// 0xFE: The very first vehicle in the train (The Engine/Front).
/// 0xFF: The very last vehicle in the train (The Caboose/End).
switch(FEAT_TRAINS, SELF, switch_mtro_st__louis_car_co_new_york_r44_reversed, var[0xC8]) {
    0xFE: spriteset_mtro_st__louis_car_co_new_york_r44_back;
    0xFF: spriteset_mtro_st__louis_car_co_new_york_r44_back;
    spriteset_mtro_st__louis_car_co_new_york_r44_front;
}