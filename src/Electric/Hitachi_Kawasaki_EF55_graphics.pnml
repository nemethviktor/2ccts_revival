// Template: TPL_03F

// PURCHASE
spriteset(spriteset_electric_hitachi_kawasaki_ef55_purchase, "gfx/electric/hitachi_kawasaki_ef55.png") {template_purchase(1, 64)}


// VEHICLE
/// Engine
spriteset(spriteset_electric_hitachi_kawasaki_ef55_engine, "gfx/electric/hitachi_kawasaki_ef55.png") {template_2cc_engines_general(1, 1)}


/// B Unit
spriteset(spriteset_electric_hitachi_kawasaki_ef55_b_unit, "gfx/electric/hitachi_kawasaki_ef55.png") {template_2cc_engines_general(1, 32)}

switch(FEAT_TRAINS, SELF, switch_electric_hitachi_kawasaki_ef55_position, position_in_vehid_chain % 2) {
	0: spriteset_electric_hitachi_kawasaki_ef55_engine;
	spriteset_electric_hitachi_kawasaki_ef55_b_unit;
}