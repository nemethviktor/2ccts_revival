// Template: TPL_02C.
// Data from: https://en.wikipedia.org/wiki/London_Underground_1959_Stock

// Notes:
//// POWER: 700 -- Guess -- 1938 stock was marked as 600 so added a bit


item(FEAT_TRAINS, item_mtro_metro_cammell_london_1959_stock) {
    property {
        name: string(str_mtro_metro_cammell_london_1959_stock);
        climates_available: ((param_region_northern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1959,1,1);
        model_life: 45;
        vehicle_life: 50;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 34.92525;
        running_cost_factor: 31.88584;
        speed: 72 km/h;
        power: 700 hp;
        cargo_capacity: 105;
        weight: 27 ton;
        tractive_effort_coefficient: 0.22;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_4TH];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/northern", "power/metro", "role/metro"];

    }
    graphics {
        purchase: spriteset_mtro_metro_cammell_london_1959_stock_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_mtro_metro_cammell_london_1959_stock_reversed;
    }
    livery_override (item_mtro_metro_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: int(72/10);
        weight: int(27*1/2);
        cargo_capacity: 120;
        length: 7;
        default: spriteset_mtro_metro_cammell_london_1959_stock_middle;
    }
    livery_override (item_mtro_metro_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: round(15.78575131106459);
        power: int(700*1/2);
        weight: int(27*3/4);
        cargo_capacity: 120;
        tractive_effort_coefficient: int(0.22*10*27);
        length: 7;
        default: spriteset_mtro_metro_cammell_london_1959_stock_middle;
    }
}
