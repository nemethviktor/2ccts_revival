// Template: TPL_02C.
// Data from: https://en.wikipedia.org/wiki/Rotterdam_Metro

item(FEAT_TRAINS, item_mtro_netherlands_rotterdam_mg2_type_m) {
    property {
        name: string(str_mtro_netherlands_rotterdam_mg2_type_m);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1968,1,1);
        model_life: 45;
        vehicle_life: 50;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 34.30547;
        running_cost_factor: 31.42952;
        speed: 80 km/h;
        power: 630 hp;
        cargo_capacity: 140;
        weight: 25 ton;
        tractive_effort_coefficient: 0.23;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_3RD];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "flag/NL", "power/metro", "role/metro"];

    }
    graphics {
        purchase: spriteset_mtro_netherlands_rotterdam_mg2_type_m_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_mtro_netherlands_rotterdam_mg2_type_m_reversed;
    }
    livery_override (item_mtro_metro_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: int(80/10);
        weight: int(25*1/2);
        cargo_capacity: 235;
        length: 7;
        default: spriteset_mtro_netherlands_rotterdam_mg2_type_m_middle;
    }
    livery_override (item_mtro_metro_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: (round(16.26004591557384));
        power: int(630*1/2);
        weight: int(25*3/4);
        cargo_capacity: 235;
        tractive_effort_coefficient: int(0.23*10*25);
        length: 7;
        default: spriteset_mtro_netherlands_rotterdam_mg2_type_m_middle;
    }
}
