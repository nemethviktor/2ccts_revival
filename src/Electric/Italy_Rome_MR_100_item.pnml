// Template: TPL_02C.
// Data from: https://it.wikipedia.org/wiki/Elettromotrici_STEFER_MR_100_e_MR_200

item(FEAT_TRAINS, item_mtro_italy_rome_mr_100) {
    property {
        name: string(str_mtro_italy_rome_mr_100);
        climates_available: ((param_region_southern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1954,1,1);
        model_life: 45;
        vehicle_life: 50;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 39.54124;
        running_cost_factor: 35.12816;
        speed: 100 km/h;
        power: 830 hp;
        cargo_capacity: 140;
        weight: 40 ton;
        tractive_effort_coefficient: 0.21;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_3RD];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/southern", "flag/IT", "power/metro", "role/metro"];

    }
    graphics {
        purchase: spriteset_mtro_italy_rome_mr_100_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_mtro_italy_rome_mr_100_reversed;
    }
    livery_override (item_mtro_metro_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: int(100/10);
        weight: int(40*1/2);
        cargo_capacity: 156;
        length: 7;
        default: spriteset_mtro_italy_rome_mr_100_middle;
    }
    livery_override (item_mtro_metro_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: (round(21.28098226452495));
        power: int(830*1/2);
        weight: int(40*3/4);
        cargo_capacity: 156;
        tractive_effort_coefficient: int(0.21*10*40);
        length: 7;
        default: spriteset_mtro_italy_rome_mr_100_middle;
    }
}
