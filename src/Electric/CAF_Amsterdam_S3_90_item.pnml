// Template: TPL_02C.
// Data from: https://en.wikipedia.org/wiki/S3/M4_(Amsterdam_Metro)

item(FEAT_TRAINS, item_mtro_caf_amsterdam_s3_90) {
    property {
        name: string(str_mtro_caf_amsterdam_s3_90);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1997,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 50;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 40.62594;
        running_cost_factor: 37.89127;
        speed: 70 km/h;
        power: 1020 hp;
        cargo_capacity: 125;
        weight: 24 ton;
        tractive_effort_coefficient: 0.28;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_1500V, STANDARD_GAUGE_RAILTYPE_3RD];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "power/metro", "role/metro"];

    }
    graphics {
        purchase: spriteset_mtro_caf_amsterdam_s3_90_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_mtro_caf_amsterdam_s3_90_reversed;
    }
    livery_override (item_mtro_metro_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: int(70/10);
        weight: int(24*1/2);
        cargo_capacity: 250;
        length: 8;
        default: spriteset_mtro_caf_amsterdam_s3_90_middle;
    }
    livery_override (item_mtro_metro_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: round(16.913743884534263);
        power: int(1020*1/2);
        weight: int(24*3/4);
        cargo_capacity: 250;
        tractive_effort_coefficient: int(0.28*10*24);
        length: 8;
        default: spriteset_mtro_caf_amsterdam_s3_90_middle;
    }
}
