        introduction_date: date(1914,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 52.91967;
        running_cost_factor: 40.08393;
        speed: 60 km/h;
        power: 1600 hp;
        cargo_capacity: 0;
        weight: 125 ton;
        tractive_effort_coefficient: 0.202;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_15KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 6;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/northern", "flag/SE", "power/electric/ac", "role/universal"];

    }
    graphics {
        purchase: spriteset_electric_sweden_sj_o_class_purchase;
        visual_effect_and_powered: switch_electric_sweden_sj_o_class_visual_effect;
        length: switch_electric_sweden_sj_o_class_length;
        articulated_part: switch_electric_sweden_sj_o_class_articulated;
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_electric_sweden_sj_o_class_position;
