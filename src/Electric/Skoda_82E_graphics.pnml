// Template: TPL_17A

// PURCHASE
spriteset(spriteset_electric_skoda_82e_purchase, "gfx/electric/skoda_82e.png") {template_purchase(1, 64)}


/// Front
spriteset(spriteset_electric_skoda_82e_front, "gfx/electric/skoda_82e.png") {template_2cc_engines_general(1, 1)}


/// Back
spriteset(spriteset_electric_skoda_82e_back, "gfx/electric/skoda_82e.png") {template_2cc_engines_general(1, 32)}

switch(FEAT_TRAINS, SELF, switch_electric_skoda_82e_position, position_in_vehid_chain % 2) {
	0: spriteset_electric_skoda_82e_front;
	spriteset_electric_skoda_82e_back;
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_electric_skoda_82e_visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_electric_skoda_82e_articulated, extra_callback_info1) {
    1: return item_electric_skoda_82e;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
