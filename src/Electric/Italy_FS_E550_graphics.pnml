// Template: TPL_03B

// PURCHASE
spriteset(spriteset_electric_italy_fs_e550_purchase, "gfx/electric/italy_fs_e550.png") {template_purchase(1, 64)}


// VEHICLE
/// Engine1
spriteset(spriteset_electric_italy_fs_e550_engine1, "gfx/electric/italy_fs_e550.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_electric_italy_fs_e550_engine2, "gfx/electric/italy_fs_e550.png") {template_2cc_engines_general(1, 32)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_electric_italy_fs_e550_animation, motion_counter % 2){
	0: spriteset_electric_italy_fs_e550_engine1;
	spriteset_electric_italy_fs_e550_engine2;
}