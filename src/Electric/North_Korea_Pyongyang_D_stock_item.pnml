// Template: TPL_02C. Data from: https://en.wikipedia.org/wiki/Pyongyang_Metro#Rolling_stock

item(FEAT_TRAINS, item_mtro_north_korea_pyongyang_d_stock) {
    property {
        name: string(str_mtro_north_korea_pyongyang_d_stock);
        climates_available: ((param_region_asia || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1999,1,1);
        model_life: 45;
        vehicle_life: 60;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 38.20125;
        running_cost_factor: 34.99497;
        speed: 70 km/h;
        power: 800 hp;
        cargo_capacity: 160;
        weight: 28 ton;
        tractive_effort_coefficient: 0.23;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_3RD];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

badges: ["power/metro", "flag/KP"];

    }
    graphics {
        purchase: spriteset_mtro_north_korea_pyongyang_d_stock_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_mtro_north_korea_pyongyang_d_stock_reversed;
    }
    livery_override (item_mtro_metro_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: int(70/10);
        weight: int(28*1/2);
        cargo_capacity: 180;
        length: 8;
        default: spriteset_mtro_north_korea_pyongyang_d_stock_middle;
    }
    livery_override (item_mtro_metro_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: (round(16.383440485114242));
        power: int(800*1/2);
        weight: int(28*3/4);
        cargo_capacity: 180;
        tractive_effort_coefficient: int(0.23*10*28);
        length: 8;
        default: spriteset_mtro_north_korea_pyongyang_d_stock_middle;
    }
}
