// Template: TPL_03D
// CargoDef: NONE
// ID: 6147

// PURCHASE
spriteset(spriteset_electric_alstom_crrc_datong_hxd2_purchase, "gfx/electric/alstom_crrc_datong_hxd2.png") {template_purchase(1, 64)}


// VEHICLE
/// Engine
spriteset(spriteset_electric_alstom_crrc_datong_hxd2_engine, "gfx/electric/alstom_crrc_datong_hxd2.png") {template_2cc_engines_general(1, 1)}


/// B Unit
spriteset(spriteset_electric_alstom_crrc_datong_hxd2_b_unit, "gfx/electric/alstom_crrc_datong_hxd2.png") {template_2cc_engines_general(1, 32)}

switch(FEAT_TRAINS, SELF, switch_electric_alstom_crrc_datong_hxd2_position, position_in_vehid_chain % 2) {
	0: spriteset_electric_alstom_crrc_datong_hxd2_engine;
	spriteset_electric_alstom_crrc_datong_hxd2_b_unit;
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_electric_alstom_crrc_datong_hxd2_visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/// Length
switch(FEAT_TRAINS, SELF, switch_electric_alstom_crrc_datong_hxd2_length, position_in_vehid_chain % 2) {
    0: 7;
	0;
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_electric_alstom_crrc_datong_hxd2_articulated, extra_callback_info1) {
    1: return item_electric_alstom_crrc_datong_hxd2;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
