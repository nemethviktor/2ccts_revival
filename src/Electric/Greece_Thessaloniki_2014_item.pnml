// Template: TPL_02C.
// Data from: https://en.wikipedia.org/wiki/Thessaloniki_Metro#Stations,_depot_and_rolling_stock

item(FEAT_TRAINS, item_mtro_greece_thessaloniki_2014) {
    property {
        name: string(str_mtro_greece_thessaloniki_2014);
        climates_available: ((param_region_southern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2024,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 60;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 45.88922;
        running_cost_factor: 42.76328;
        speed: 80 km/h;
        power: 1360 hp;
        cargo_capacity: 115;
        weight: 27 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_3RD];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 6;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["power/metro", "flag/GR"];

    }
    graphics {
        purchase: spriteset_mtro_greece_thessaloniki_2014_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_mtro_greece_thessaloniki_2014_reversed;
    }
    livery_override (item_mtro_metro_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: int(80/10);
        weight: int(27*1/2);
        cargo_capacity: 110;
        length: 6;
        default: spriteset_mtro_greece_thessaloniki_2014_middle;
    }
    livery_override (item_mtro_metro_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: (round(19.93781782972936));
        power: int(1360*1/2);
        weight: int(27*3/4);
        cargo_capacity: 110;
        tractive_effort_coefficient: int(0.3*10*27);
        length: 6;
        default: spriteset_mtro_greece_thessaloniki_2014_middle;
    }
}
