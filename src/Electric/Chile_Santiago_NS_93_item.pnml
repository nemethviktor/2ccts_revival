item(FEAT_TRAINS, item_mtro_Chile_Santiago_NS_93) {
    property {
        name: string(str_mtro_Chile_Santiago_NS_93);
        climates_available: ((param_region_south_america || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1996,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 46.48581;
        running_cost_factor: 41.67274;
        speed: 100 km/h;
        power: 1270 hp;
        cargo_capacity: 116;
        weight: 44 ton;
        tractive_effort_coefficient: 0.42;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_3RD];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_mtro_Chile_Santiago_NS_93_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_mtro_Chile_Santiago_NS_93_reversed;
    }
    livery_override (item_mtro_Metro_Wagon_Unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: int(100/10);
        weight: int(44*1/2);
        cargo_capacity: 116;
        length: 7;
        default: spriteset_mtro_Chile_Santiago_NS_93_middle;
    }
    livery_override (item_mtro_Metro_Wagon_Powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: (round(32.043706087458474));
        power: int(1270*1/2);
        weight: int(44*3/4);
        cargo_capacity: 116;
        tractive_effort_coefficient: int(0.42*10*44);
        length: 7;
        default: spriteset_mtro_Chile_Santiago_NS_93_middle;
    }
}
