        running_cost_factor: (round(22.897003937702145));
        power: int(1550*1/2);
        weight: int(32*3/4);
        cargo_capacity: 196;
        tractive_effort_coefficient: int(0.28*10*32);
        length: 8;
        default: spriteset_mtro_chile_santiago_as_2002_middle;
