// Template: TPL_02C.
// Data from: https://fr.wikipedia.org/wiki/M%C3%A9tro_d%27Alger

item(FEAT_TRAINS, item_mtro_algeria_algiers_caf_2011_stock) {
    property {
        name: string(str_mtro_algeria_algiers_caf_2011_stock);
        climates_available: ((param_region_africa || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2011,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 50;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 47.88386;
        running_cost_factor: 44.95791;
        speed: 80 km/h;
        power: 1450 hp;
        cargo_capacity: 165;
        weight: 25 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_3RD];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/africa", "flag/DZ", "power/metro", "role/metro"];

    }
    graphics {
        purchase: spriteset_mtro_algeria_algiers_caf_2011_stock_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_mtro_algeria_algiers_caf_2011_stock_reversed;
    }
    livery_override (item_mtro_metro_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: int(80/10);
        weight: int(25*1/2);
        cargo_capacity: 215;
        length: 7;
        default: spriteset_mtro_algeria_algiers_caf_2011_stock_middle;
    }
    livery_override (item_mtro_metro_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: (round(19.45788656367942));
        power: int(1450*1/2);
        weight: int(25*3/4);
        cargo_capacity: 215;
        tractive_effort_coefficient: int(0.3*10*25);
        length: 7;
        default: spriteset_mtro_algeria_algiers_caf_2011_stock_middle;
    }
}
