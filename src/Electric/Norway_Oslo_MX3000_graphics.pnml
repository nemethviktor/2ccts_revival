/*
* PURCHASE
*/

spriteset(spriteset_mtro_Norway_Oslo_MX3000_purchase, "gfx/Metro/Norway_Oslo_MX3000.png") {
	template_purchase_dualheaded(1, 96)
}

/*
* VEHICLE
*/

//Front
spriteset(spriteset_mtro_Norway_Oslo_MX3000_front, "gfx/Metro/Norway_Oslo_MX3000.png") {
	template_2cc_engines_general(1, 1)
}

//Back
spriteset(spriteset_mtro_Norway_Oslo_MX3000_back, "gfx/Metro/Norway_Oslo_MX3000.png") {
	template_2cc_engines_general(1, 32)
}

//Middle
spriteset(spriteset_mtro_Norway_Oslo_MX3000_middle, "gfx/Metro/Norway_Oslo_MX3000.png") {
	template_2cc_engines_general(1, 64)
}

//Dualheaded engines
switch(FEAT_TRAINS, SELF, switch_mtro_Norway_Oslo_MX3000_reversed, var[0xC8]) {
	0xFE: spriteset_mtro_Norway_Oslo_MX3000_back;
    0xFF: spriteset_mtro_Norway_Oslo_MX3000_back; 
    spriteset_mtro_Norway_Oslo_MX3000_front;
}

//Add defined switches

RUNNINGCOSTENGINESWITCH

PURCHASETEXTSWITCH