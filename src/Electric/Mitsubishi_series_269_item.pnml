item(FEAT_TRAINS, item_electric_mitsubishi_series_269) {
    property {
        name: string(str_electric_mitsubishi_series_269);
        climates_available: ((param_region_south_america || param_region_southern_europe) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1980,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 75.31;
        running_cost_factor: 77.0;
        speed: 160 km/h;
        power: 4340 hp;
        cargo_capacity: 0;
        weight: 88 ton;
        tractive_effort_coefficient: 0.16;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [BROAD_GAUGE_RAILTYPE_3KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/south", "region/europe/southern", "power/electric/dc", "role/express"];

    }
    graphics {
        purchase: spriteset_electric_mitsubishi_series_269_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: spriteset_electric_mitsubishi_series_269;
    }
}
