// Template: TPL_03D

// PURCHASE
spriteset(spriteset_electric_alstom_kz8a_purchase, "gfx/electric/alstom_kz8a.png") {template_purchase(1, 64)}


// VEHICLE
/// Engine
spriteset(spriteset_electric_alstom_kz8a_engine, "gfx/electric/alstom_kz8a.png") {template_2cc_engines_general(1, 1)}


/// Tender
spriteset(spriteset_electric_alstom_kz8a_tender, "gfx/electric/alstom_kz8a.png") {template_2cc_engines_general(1, 32)}

switch(FEAT_TRAINS, SELF, switch_electric_alstom_kz8a_position, position_in_vehid_chain % 2) {
	0: spriteset_electric_alstom_kz8a_engine;
	spriteset_electric_alstom_kz8a_tender;
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_electric_alstom_kz8a_visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/// Length
switch(FEAT_TRAINS, SELF, switch_electric_alstom_kz8a_length, position_in_vehid_chain % 2) {
    0: 8;
	8;
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_electric_alstom_kz8a_articulated, extra_callback_info1) {
    1: return item_electric_alstom_kz8a;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
