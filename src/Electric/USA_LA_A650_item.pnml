// Template: TPL_02C

item(FEAT_TRAINS, item_mtro_usa_la_a650) {
    property {
        name: string(str_mtro_usa_la_a650);
        climates_available: ((param_region_north_america || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1993,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 60;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 34.31369;
        running_cost_factor: 30.17954;
        speed: 112 km/h;
        power: 530 hp;
        cargo_capacity: 170;
        weight: 37 ton;
        tractive_effort_coefficient: 0.47;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_3RD];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

badges: ["power/maglev", "flag/US"];

    }
    graphics {
        purchase: spriteset_mtro_usa_la_a650_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_mtro_usa_la_a650_reversed;
    }
    livery_override (item_mtro_metro_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: int(112/10);
        weight: int(37*1/2);
        cargo_capacity: 170;
        length: 8;
        default: spriteset_mtro_usa_la_a650_middle;
    }
    livery_override (item_mtro_metro_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: (round(30.892352559924202));
        power: int(530*1/2);
        weight: int(37*3/4);
        cargo_capacity: 170;
        tractive_effort_coefficient: int(0.47*10*37);
        length: 8;
        default: spriteset_mtro_usa_la_a650_middle;
    }
}
