// Template: TPL_02C.
// Data from: https://en.wikipedia.org/wiki/R1_(New_York_City_Subway_car)

item(FEAT_TRAINS, item_mtro_acf_new_york_r1) {
    property {
        name: string(str_mtro_acf_new_york_r1);
        climates_available: ((param_region_north_america || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1930,1,1);
        model_life: 45;
        vehicle_life: 50;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 37.60591;
        running_cost_factor: 33.02644;
        speed: 90 km/h;
        power: 760 hp;
        cargo_capacity: 105;
        weight: 42 ton;
        tractive_effort_coefficient: 0.24;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_3RD];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/northern", "power/metro", "role/metro"];

    }
    graphics {
        purchase: spriteset_mtro_acf_new_york_r1_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_mtro_acf_new_york_r1_reversed;
    }
    livery_override (item_mtro_metro_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: int(90/10);
        weight: int(42*1/2);
        cargo_capacity: 156;
        length: 8;
        default: spriteset_mtro_acf_new_york_r1_middle;
    }
    livery_override (item_mtro_metro_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: round(21.836809750418045);
        power: int(760*1/2);
        weight: int(42*3/4);
        cargo_capacity: 156;
        tractive_effort_coefficient: int(0.24*10*42);
        length: 8;
        default: spriteset_mtro_acf_new_york_r1_middle;
    }
}
