/*
* PURCHASE
*/

spriteset(spriteset_electric_Kazakhstan_KTZ_KZ8A_purchase, "gfx/Electric/Kazakhstan_KTZ_KZ8A.png") {
	template_purchase(1, 64)
}

/*
* VEHICLE
*/

//Engine
spriteset(spriteset_electric_Kazakhstan_KTZ_KZ8A_engine, "gfx/Electric/Kazakhstan_KTZ_KZ8A.png") {
	template_2cc_engines_general(1, 1)
}

//Tender
spriteset(spriteset_electric_Kazakhstan_KTZ_KZ8A_tender, "gfx/Electric/Kazakhstan_KTZ_KZ8A.png") {
	template_2cc_engines_general(1, 32)
}

switch(FEAT_TRAINS, SELF, switch_electric_Kazakhstan_KTZ_KZ8A_position, position_in_vehid_chain % 2) {
	0: spriteset_electric_Kazakhstan_KTZ_KZ8A_engine;
	spriteset_electric_Kazakhstan_KTZ_KZ8A_tender;
}

/*
* Visual effect
*/

switch(FEAT_TRAINS, SELF, switch_electric_Kazakhstan_KTZ_KZ8A_visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

switch(FEAT_TRAINS, SELF, switch_electric_Kazakhstan_KTZ_KZ8A_length, position_in_vehid_chain % 2) {
	0: 8;
	8;
}

switch(FEAT_TRAINS, SELF, switch_electric_Kazakhstan_KTZ_KZ8A_articulated, extra_callback_info1) {
	1: return item_electric_Kazakhstan_KTZ_KZ8A;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

//Add defined switches

RUNNINGCOST_ENGINE_SWITCH

PURCHASETEXT_SWITCH