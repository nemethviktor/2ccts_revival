        visual_effect_and_powered: switch_electric_ukraine_uz_chs7_visual_effect;
        // no 'length'
        articulated_part: switch_electric_ukraine_uz_chs7_articulated;
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_electric_ukraine_uz_chs7_position;
    }
