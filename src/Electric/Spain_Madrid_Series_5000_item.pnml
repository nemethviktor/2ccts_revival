item(FEAT_TRAINS, item_mtro_Spain_Madrid_Series_5000) {
    property {
        name: string(str_mtro_Spain_Madrid_Series_5000);
        climates_available: ((param_region_southern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1974,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 35.02496;
        running_cost_factor: 30.54901;
        speed: 80 km/h;
        power: 530 hp;
        cargo_capacity: 192;
        weight: 41 ton;
        tractive_effort_coefficient: 0.46;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_3RD];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_mtro_Spain_Madrid_Series_5000_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_mtro_Spain_Madrid_Series_5000_reversed;
    }
    livery_override (item_mtro_Metro_Wagon_Unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(80/10);
        weight: int(41*1/2);
        cargo_capacity: 192;
        length: 8;
        default: spriteset_mtro_Spain_Madrid_Series_5000_middle;
    }
    livery_override (item_mtro_Metro_Wagon_Powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(29.1623525599242));
        power: int(530*1/2);
        weight: int(41*3/4);
        cargo_capacity: 192;
        tractive_effort_coefficient: int(0.46*10*41);
        length: 8;
        default: spriteset_mtro_Spain_Madrid_Series_5000_middle;
    }
}
