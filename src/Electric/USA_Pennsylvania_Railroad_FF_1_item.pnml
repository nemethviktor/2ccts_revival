        introduction_date: date(1916,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 0/2 : (param_loadingspeed == 2) ? 0*2 : 0;
        cost_factor: 91.56886;
        running_cost_factor: 67.89496;
        speed: 33 km/h;
        power: 4600 hp;
        cargo_capacity: 0;
        weight: 234 ton;
        tractive_effort_coefficient: 0.27;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_15KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/northern", "flag/US", "power/electric/ac", "role/heavy_freight"];

    }
    graphics {
        purchase: spriteset_electric_usa_pennsylvania_railroad_ff_1_purchase;
        visual_effect_and_powered: switch_electric_usa_pennsylvania_railroad_ff_1_visual_effect;
        length: switch_electric_usa_pennsylvania_railroad_ff_1_length;
        articulated_part: switch_electric_usa_pennsylvania_railroad_ff_1_articulated;
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_electric_usa_pennsylvania_railroad_ff_1_position;
    }
