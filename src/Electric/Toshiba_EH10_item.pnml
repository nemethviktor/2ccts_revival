        introduction_date: date(1954,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 70.34811;
        running_cost_factor: 58.32859;
        speed: 110 km/h;
        power: 3390 hp;
        cargo_capacity: 0;
        weight: 116 ton;
        tractive_effort_coefficient: 0.209;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [NARROW_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "power/electric/dc", "role/express"];

    }
    graphics {
        purchase: spriteset_electric_toshiba_eh10_purchase;
        visual_effect_and_powered: switch_electric_toshiba_eh10_visual_effect;
        length: switch_electric_toshiba_eh10_length;
        articulated_part: switch_electric_toshiba_eh10_articulated;
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_electric_toshiba_eh10_position;
    }
