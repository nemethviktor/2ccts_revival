// Template: TPL_02C.
// Data from: https://en.wikipedia.org/wiki/London_Underground_S7_and_S8_Stock

// Notes:
//// POWER: 2000 -- That's a guess. But the 1992 stock's power is >2300 hp so this should be more except reduced slightly due to the power car logic in the game


item(FEAT_TRAINS, item_mtro_uk_london_s_stock) {
    property {
        name: string(str_mtro_uk_london_s_stock);
        climates_available: ((param_region_northern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2010,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 60;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 54.97835;
        running_cost_factor: 51.66527;
        speed: 100 km/h;
        power: 2000 hp;
        cargo_capacity: 168;
        weight: 29 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_4TH];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/northern", "flag/GB", "power/metro", "role/metro"];

    }
    graphics {
        purchase: spriteset_mtro_uk_london_s_stock_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_mtro_uk_london_s_stock_reversed;
    }
    livery_override (item_mtro_metro_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: int(100/10);
        weight: int(29*1/2);
        cargo_capacity: 160;
        length: 8;
        default: spriteset_mtro_uk_london_s_stock_middle;
    }
    livery_override (item_mtro_metro_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        running_cost_factor: (round(23.172136091482166));
        power: int(2000*1/2);
        weight: int(29*3/4);
        cargo_capacity: 160;
        tractive_effort_coefficient: int(0.3*10*29);
        length: 8;
        default: spriteset_mtro_uk_london_s_stock_middle;
    }
}
