//Railtype translation table
// Note to self: the way this works is that on the left side is the custom label and the right side is a fallback list.
// e.g. STANDARD_GAUGE_25KV: [SAAA, SAAE, ELRL] // -> and then define track_type:  STANDARD_GAUGE_25KV in the item file
// e.g. SHINKANSEN: [SGAA, SAAE, ELRL] // -> and then define track_type:  SHINKANSEN in the item file
// Fallbacks are in first-come-first-serve order. So if we define [SAAN, NAAN] and both exist, the first one will be taken, the second will be ignored.
// Which means that if something (e.g. generic wagons) are to be available universally then in the item file define them thrice _AS A LIST_.
// --> #define CURRENT_TRACK_TYPE [STANDARD_GAUGE_RAILTYPE_NONE, NARROW_GAUGE_RAILTYPE_NONE, BROAD_GAUGE_RAILTYPE_NONE]

railtypetable {

// STANDARD

	STANDARD_GAUGE_RAILTYPE_OHLE 	: ["SAAE", "ELRL", "RAIL"],
	STANDARD_GAUGE_RAILTYPE_25KV 	: ["SAAA", "ELRL", "RAIL"],
	STANDARD_GAUGE_RAILTYPE_15KV 	: ["SAAa", "SAAA", "ELRL", "RAIL"],
	STANDARD_GAUGE_RAILTYPE_3KV 	: ["SAAD", "ELRL", "RAIL"],
	STANDARD_GAUGE_RAILTYPE_1500V	: ["SAAd", "SAAD", "ELRL", "RAIL"],
	STANDARD_GAUGE_RAILTYPE_3RD 	: ["SAA3", "3RDR", "MTRO", "MONO"],
	STANDARD_GAUGE_RAILTYPE_4TH 	: ["SAA4", "3RDR", "MTRO", "MONO"],
	STANDARD_GAUGE_RAILTYPE_NONE 	: ["SAAN", "RAIL"],

// NARROW

	NARROW_GAUGE_RAILTYPE_OHLE 		: ["NAAE", "SAAE", "ELRL", "RAIL"],
	NARROW_GAUGE_RAILTYPE_25KV 		: ["NAAA", "NAAE", "SAAA", "SAAE", "ELRL", "RAIL"],
	NARROW_GAUGE_RAILTYPE_15KV 		: ["NAAa", "NAAA", "NAAE", "SAAa", "SAAA", "SAAE","ELRL", "RAIL"],
	NARROW_GAUGE_RAILTYPE_3KV 		: ["NAAD", "NAAE", "SAAD", "SAAE", "ELRL", "RAIL"],
	NARROW_GAUGE_RAILTYPE_1500V		: ["NAAd", "NAAD", "NAAE", "SAAd", "SAAD", "SAAE","ELRL", "RAIL"],
	NARROW_GAUGE_RAILTYPE_3RD 		: ["NAA3", "SAA3", "3RDR", "MTRO", "MONO"],
	NARROW_GAUGE_RAILTYPE_4TH 		: ["NAA4", "SAA4", "3RDR", "MTRO", "MONO"],
	NARROW_GAUGE_RAILTYPE_NONE 		: ["NAAN", "RAIL"],
 	
// BROAD 

	BROAD_GAUGE_RAILTYPE_OHLE 		: ["BAAE", "SAAE", "ELRL", "RAIL"],
	BROAD_GAUGE_RAILTYPE_25KV 		: ["BAAA", "BAAE", "SAAA", "SAAE","ELRL", "RAIL"],
	BROAD_GAUGE_RAILTYPE_15KV 		: ["BAAa", "BAAA", "BAAE", "SAAa", "SAAA", "SAAE", "ELRL", "RAIL"],
	BROAD_GAUGE_RAILTYPE_3KV 		: ["BAAD", "BAAE", "SAAD", "SAAE", "ELRL"],
	BROAD_GAUGE_RAILTYPE_1500V		: ["BAAd", "BAAD", "BAAE", "SAAd", "SAAD", "SAAE", "ELRL", "RAIL"],
	BROAD_GAUGE_RAILTYPE_3RD 		: ["BAA3", "SAA3", "3RDR", "MTRO", "MONO"],
	BROAD_GAUGE_RAILTYPE_4TH 		: ["BAA4", "SAA4", "3RDR", "MTRO", "MONO"],
	BROAD_GAUGE_RAILTYPE_NONE 		: ["BAAN", "RAIL"],


// (Semi-original things)
	RAIL,
	ELRL,
	MONO,
	MGLV: [MGLV, LCAI, LCAE],
	MTRO: ["SAB3", "3RDR", MTRO, MONO], // fall back to monorail if no Metro-tracks are available
}