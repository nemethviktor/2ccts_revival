// Notes:
//// TE_STARTING_KN: 25 -- Gemini


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_singlemtro_usa_brooklyn_union_gate_car_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 48/2; \
        bitmask(CC_ARMOURED): 48/4; \
        48; \
    }


    switch(FEAT_TRAINS, SELF, switch_singlemtro_usa_brooklyn_union_gate_car_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }

item(FEAT_TRAINS, item_singlemtro_usa_brooklyn_union_gate_car) {
    property {
        name: string(str_singlemtro_usa_brooklyn_union_gate_car);
        climates_available: ((param_region_north_america || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1880,1,1);
        model_life: 45;
        vehicle_life: 60;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 120/2 : (param_loadingspeed == 2) ? 120*2 : 120;
        cost_factor: 21.28321;
        running_cost_factor: 18.16909;
        speed: 50 km/h;
        power: 200 hp;
        cargo_capacity: 48;
        weight: 28 ton;
        tractive_effort_coefficient: 0.091;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_DUAL];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_MAGLEV;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/northern", "flag/US", "power/metro", "role/metro"];

    }
    graphics {
        purchase: spriteset_singlemtro_usa_brooklyn_union_gate_car_purchase;
        cargo_capacity: switch_singlemtro_usa_brooklyn_union_gate_car_capacity_engine;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: spriteset_singlemtro_usa_brooklyn_union_gate_car;
    }
}
