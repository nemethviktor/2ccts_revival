 *  This program is free software; you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation; either version 3 of the License, or (at your option) any later version.
 *  
 *  An explanation of the values you need to provide:
 *  
 *    left_x: horizontal distance in pixels from the top left of the image file to the top left of the sprite;
 *    upper_y: vertical distance in pixels from the top left of the image file to the top left of the sprite;
 *    width: width of the sprite in pixels;
 *    height: height of the sprite in pixels;
 *    offset_x: horizontal offset in pixels from the center of the bounding box (see below);
 *    offset_y: vertical offset in pixels from the center of the bounding box (see below);
 *    filename: path and file name of the graphics file this sprite is in, if it is different than the one defined in the spriteset itself.
 * 
 * The offsets you set in a spriteset define where the sprite is drawn inside this bounding box.
 *  
 * For vehicles this is relative to the middle of the bounding box. 
 * So both offsets set to zero will put the top left corner of the sprite in the middle of the bounding box. 
 * A general rule of thumb here is to take half the width/height (rounded down) and then the negative of that for the x/y offset. 
 * This places the vehicle roughly in the middle of its bounding box.
 * 
*/

// Purchase templates
// Engines
template template_purchase(x, y) {
    //[left_x   ,  upper_y  , width , height, offset_x  , offset_y  , file]
    //                                          more negative to shift left
    //                                                      more negative to shift up

    [x          ,  y        , 53    , 12    , -25       ,  -8       ]
}

// Dualheaded Engines
template template_purchase_dualheaded(x,y) {
    //[left_x   ,  upper_y  , width , height, offset_x  , offset_y  , file]
    //                                          more negative to shift left
    //                                                      more negative to shift up
	[1          ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1          ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1 	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1 	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1 	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1 	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [x	        ,  y        ,  53   , 12    , -11       , -8]       
    [1	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
}

// Coaches
template template_purchase_coach(x, y) {
    //[left_x   ,  upper_y  , width , height, offset_x  , offset_y  , file]
    //                                          more negative to shift left
    //                                                      more negative to shift up
    [x          ,  y        , 53    , 12    , -25       ,  -8       ]
}

// Wagons
template template_purchase_wagon(x, y) {
    //[left_x   ,  upper_y  , width , height, offset_x  , offset_y  , file]
    //                                          more negative to shift left
    //                                                      more negative to shift up
    [x          , y         ,  43   , 12    , -15       , -8]
}

// Unit wagons
template template_purchase_wagon_special(x, y) {
    //[left_x   ,  upper_y  , width , height, offset_x  , offset_y  , file]
    //                                          more negative to shift left
    //                                                      more negative to shift up
    [x          , y         ,  53   , 12    , -25       , -8]
}

template template_wagon_special(x,y) {
    //[left_x   ,  upper_y  , width , height, offset_x  , offset_y  , file]
    //                                          more negative to shift left
    //                                                      more negative to shift up
	[1          ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1          ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1 	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1 	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1 	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1 	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
	[x	        ,  y        , 33    , 12    , -16       ,  -8       ]
    [1	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
}

/*
 * The templates below are derived from the 2cc trainset.
*/



// All engines and front+middle parts of MUs
// This actually causes problems with xMUs that aren't 8-length so we define a separate one for 7-length
template template_2cc_engines_general(x, y) {
    //[left_x   ,  upper_y  , width , height, offset_x  , offset_y  , file]
    //                                          more negative to shift left
    //                                                      more negative to shift up
    [x          , y         ,  8    , 24    ,  -3       , -12]
    [x+9        , y         , 22    , 20    , -14       , -12]
    [x+32       , y         , 32    , 16    , -16       , -12]
    [x+65       , y         , 22    , 20    ,  -6       , -12]
    [x+88       , y         ,  8    , 24    ,  -3       , -12]
    [x+97       , y         , 22    , 20    , -14       , -12]
    [x+120      , y         , 32    , 16    , -16       , -12]
    [x+153      , y         , 22    , 20    ,  -6       , -12]
}

// Template for 7-length (28 pixels) multiple units/wagons
template template_2cc_engines_7len(x, y) {
    // [left_x   , upper_y  , width , height, offset_x  , offset_y]
    [x          , y         ,  8    , 24    ,  -3       , -12]
    [x+9        , y         , 22    , 20    , -14       , -12]
    [x+32       , y         , 28    , 16    , -14       , -12] // E: Width reduced to 28, offset tracking adjusted
    [x+65       , y         , 22    , 20    ,  -6       , -12]
    [x+88       , y         ,  8    , 24    ,  -3       , -12]
    [x+97       , y         , 22    , 20    , -14       , -12]
    [x+120      , y         , 28    , 16    , -14       , -12] // W: Width reduced to 28, offset tracking adjusted
    [x+153      , y         , 22    , 20    ,  -6       , -12]
}

// Wagons+Coaches
template template_2cc_wagons(x, y) {
    //[left_x   ,  upper_y  , width , height, offset_x  , offset_y  , file]
    //                                          more negative to shift left
    //                                                      more negative to shift up
    [x          , y         ,  8    , 24    ,  -3       , -12]
    [x+9        , y         , 22    , 20    , -14       , -12]
    [x+32       , y         , 32    , 16    , -16       , -12]
    [x+65       , y         , 22    , 20    ,  -6       , -12]
    [x+88       , y         ,  8    , 24    ,  -3       , -12]
    [x+97       , y         , 22    , 20    , -14       , -12]
    [x+120      , y         , 32    , 16    , -16       , -12]
    [x+153      , y         , 22    , 20    ,  -6       , -12]
}

// Railbus and single unit metros
template template_2cc_railbus_general(x, y) {
    //[left_x   ,  upper_y  , width , height, offset_x  , offset_y  , file]
    //                                          more negative to shift left
    //                                                      more negative to shift up
	[x          , y         ,  8    , 24    ,  -3       , -12]
    [x+9        , y         , 22    , 20    , -14       , -12]
    [x+32       , y         , 32    , 16    , -16       , -10]
    [x+65       , y         , 22    , 20    ,  -6       , -12]
    [x+88       , y         ,  8    , 24    ,  -3       , -12]
    [x+97       , y         , 22    , 20    , -14       , -12]
    [x+120      , y         , 32    , 16    , -16       , -10]
    [x+153      , y         , 22    , 20    ,  -6       , -12]	
}

// Special template for vehicles with length 12
template template_2cc_l12(x, y) {
    //[left_x   ,  upper_y  , width , height, offset_x  , offset_y  , file]
    //                                          more negative to shift left
    //                                                      more negative to shift up
    [x          , y         ,  8    , 36    ,  -3       , -15]
    [x+9        , y         , 30    , 26    , -22       , -14]
    [x+40       , y         , 48    , 16    , -33       , -12]
    [x+89       , y         , 30    , 26    , -14       , -18]
    [x+120      , y         ,  8    , 36    ,  -3       , -20]
    [x+129      , y         , 29    , 25    , -13       , -18]
    [x+160      , y         , 48    , 16    , -16       , -12]
    [x+209      , y         , 29    , 25    ,  -4       , -13]
}

// Special template for empty spritesets (vehicles with length 10 use this)
template template_empty_spriteset() {
    //[left_x   ,  upper_y  , width , height, offset_x  , offset_y  , file]
    //                                          more negative to shift left
    //                                                      more negative to shift up
	[1          ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1          ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1 	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1 	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1 	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1 	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1 	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
    [1	        ,  1        ,  1    ,  1    ,   0       ,   0       , "gfx/Empty.png"]
}

spriteset(spriteset_empty) {
	template_empty_spriteset()
}

#define EMPTY_SPRITESET spriteset_empty;