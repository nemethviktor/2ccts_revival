/// RANDOM SWITCHES FOR REGULAR MIDDLE CARRIAGES (NORMAL VARIANTS)
random_switch(FEAT_TRAINS, SELF, switch_mu_coach_gen3_aluminium_lightweight_intercity_coach_middle_livery) {
    1: spriteset_mu_coach_gen3_aluminium_lightweight_intercity_coach_l1_s1;
    1: spriteset_mu_coach_gen3_aluminium_lightweight_intercity_coach_l2_s1;
    1: spriteset_mu_coach_gen3_aluminium_lightweight_intercity_coach_l3_s1;
    1: spriteset_mu_coach_gen3_aluminium_lightweight_intercity_coach_l4_s1;
}

/// RANDOM SWITCHES FOR THE TAIL CARRIAGE (LAST VARIANTS)
/// Uses the explicit .last property references inside the spritegroup definitions
random_switch(FEAT_TRAINS, SELF, switch_mu_coach_gen3_aluminium_lightweight_intercity_coach_tail_livery) {
    1: spriteset_mu_coach_gen3_aluminium_lightweight_intercity_coach_l1_s2;
    1: spriteset_mu_coach_gen3_aluminium_lightweight_intercity_coach_l2_s2;
    1: spriteset_mu_coach_gen3_aluminium_lightweight_intercity_coach_l3_s2;
    1: spriteset_mu_coach_gen3_aluminium_lightweight_intercity_coach_l4_s2;
}

/// RANDOM SWITCHES FOR THE TAIL CARRIAGE (LAST VARIANTS)
/// Uses the explicit .last property references inside the spritegroup definitions
random_switch(FEAT_TRAINS, SELF, switch_mu_coach_gen3_aluminium_lightweight_intercity_coach_head_livery) {
    1: spriteset_mu_coach_gen3_aluminium_lightweight_intercity_coach_l1_s3;
    1: spriteset_mu_coach_gen3_aluminium_lightweight_intercity_coach_l2_s3;
    1: spriteset_mu_coach_gen3_aluminium_lightweight_intercity_coach_l3_s3;
    1: spriteset_mu_coach_gen3_aluminium_lightweight_intercity_coach_l4_s3;
}

// Logic via https://github.com/OpenTTD-JPplus/JPengines/blob/modular/src/pax/12_series.pnml
switch(FEAT_TRAINS, SELF, switch_mu_coach_gen3_aluminium_lightweight_intercity_coach_end, position_in_vehid_chain_from_end) {
	0: switch_mu_coach_gen3_aluminium_lightweight_intercity_coach_tail_livery;
	switch_mu_coach_gen3_aluminium_lightweight_intercity_coach_middle_livery;
	}
	

switch(FEAT_TRAINS, SELF, switch_mu_coach_gen3_aluminium_lightweight_intercity_coach_position_check, position_in_vehid_chain) {
	0: switch_mu_coach_gen3_aluminium_lightweight_intercity_coach_head_livery;
	switch_mu_coach_gen3_aluminium_lightweight_intercity_coach_end;
	}
