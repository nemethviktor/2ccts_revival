// Template: TPL_04U

// PURCHASE
spriteset(spriteset_mu_coach_gen4_comeng_suburban_double_deck_sa2000_purchase, "gfx/coaches/gen4/coach_gen4_comeng_suburban_double_deck_sa2000_purchase.png") {template_purchase_wagon(1, 1)}


// VEHICLE

/// LIVERY 1   NORMAL
spriteset(spriteset_mu_coach_gen4_comeng_suburban_double_deck_sa2000_l1_dt_normal, "gfx/coaches/gen4/coach_gen4_comeng_suburban_double_deck_sa2000.png") {template_2cc_wagons(1, 1)}


/// LIVERY 1   FORWARD
spriteset(spriteset_mu_coach_gen4_comeng_suburban_double_deck_sa2000_l1_dt_forward, "gfx/coaches/gen4/coach_gen4_comeng_suburban_double_deck_sa2000.png") {template_2cc_wagons(1, 32)}


/// LIVERY 1   REVERSE
spriteset(spriteset_mu_coach_gen4_comeng_suburban_double_deck_sa2000_l1_dt_reverse, "gfx/coaches/gen4/coach_gen4_comeng_suburban_double_deck_sa2000.png") {template_2cc_wagons(1, 64)}


            
// Driving backwards switch
switch(FEAT_TRAINS, PARENT, switch_mu_coach_gen4_comeng_suburban_double_deck_sa2000_direction, train_is_driving_backwards) {
    1: spriteset_mu_coach_gen4_comeng_suburban_double_deck_sa2000_l1_dt_forward;
    spriteset_mu_coach_gen4_comeng_suburban_double_deck_sa2000_l1_dt_reverse;
}

// Consist position switch
switch(FEAT_TRAINS, SELF, switch_mu_coach_gen4_comeng_suburban_double_deck_sa2000_position, position_in_consist_from_end) {
    0: switch_mu_coach_gen4_comeng_suburban_double_deck_sa2000_direction;
    spriteset_mu_coach_gen4_comeng_suburban_double_deck_sa2000_l1_dt_normal;
}