/// LIVERY 1   FORWARD
spriteset(spriteset_mu_coach_gen4_brel_mk3_coach_l1_dt_forward, "gfx/coaches/gen4/coach_gen4_brel_mk3_coach.png") {template_2cc_wagons(1, 32)}


/// LIVERY 1   REVERSE
spriteset(spriteset_mu_coach_gen4_brel_mk3_coach_l1_dt_reverse, "gfx/coaches/gen4/coach_gen4_brel_mk3_coach.png") {template_2cc_wagons(1, 64)}



/// LIVERY 2   NORMAL
spriteset(spriteset_mu_coach_gen4_brel_mk3_coach_l2_dt_normal, "gfx/coaches/gen4/coach_gen4_brel_mk3_coach.png") {template_2cc_wagons(179, 1)}


/// LIVERY 2   FORWARD
spriteset(spriteset_mu_coach_gen4_brel_mk3_coach_l2_dt_forward, "gfx/coaches/gen4/coach_gen4_brel_mk3_coach.png") {template_2cc_wagons(179, 32)}


/// LIVERY 2   REVERSE
spriteset(spriteset_mu_coach_gen4_brel_mk3_coach_l2_dt_reverse, "gfx/coaches/gen4/coach_gen4_brel_mk3_coach.png") {template_2cc_wagons(179, 64)}



/// LIVERY 3   NORMAL
spriteset(spriteset_mu_coach_gen4_brel_mk3_coach_l3_dt_normal, "gfx/coaches/gen4/coach_gen4_brel_mk3_coach.png") {template_2cc_wagons(357, 1)}


/// LIVERY 3   FORWARD
spriteset(spriteset_mu_coach_gen4_brel_mk3_coach_l3_dt_forward, "gfx/coaches/gen4/coach_gen4_brel_mk3_coach.png") {template_2cc_wagons(357, 32)}


/// LIVERY 3   REVERSE
spriteset(spriteset_mu_coach_gen4_brel_mk3_coach_l3_dt_reverse, "gfx/coaches/gen4/coach_gen4_brel_mk3_coach.png") {template_2cc_wagons(357, 64)}



/// LIVERY 4   NORMAL
spriteset(spriteset_mu_coach_gen4_brel_mk3_coach_l4_dt_normal, "gfx/coaches/gen4/coach_gen4_brel_mk3_coach.png") {template_2cc_wagons(535, 1)}


/// LIVERY 4   FORWARD
spriteset(spriteset_mu_coach_gen4_brel_mk3_coach_l4_dt_forward, "gfx/coaches/gen4/coach_gen4_brel_mk3_coach.png") {template_2cc_wagons(535, 32)}


/// LIVERY 4   REVERSE
