// Random Livery Selector dt_normal
random_switch(FEAT_TRAINS, SELF, switch_mu_coach_gen4_brel_mk3_coach_livery_dt_normal) {
	7: spriteset_mu_coach_gen4_brel_mk3_coach_l1_dt_normal;
	1: spriteset_mu_coach_gen4_brel_mk3_coach_l2_dt_normal;
	1: spriteset_mu_coach_gen4_brel_mk3_coach_l3_dt_normal;
	1: spriteset_mu_coach_gen4_brel_mk3_coach_l4_dt_normal;
}

// Random Livery Selector dt_forward
random_switch(FEAT_TRAINS, SELF, switch_mu_coach_gen4_brel_mk3_coach_livery_dt_forward) {
	7: spriteset_mu_coach_gen4_brel_mk3_coach_l1_dt_forward;
	1: spriteset_mu_coach_gen4_brel_mk3_coach_l2_dt_forward;
	1: spriteset_mu_coach_gen4_brel_mk3_coach_l3_dt_forward;
	1: spriteset_mu_coach_gen4_brel_mk3_coach_l4_dt_forward;
}

// Random Livery Selector dt_reverse
random_switch(FEAT_TRAINS, SELF, switch_mu_coach_gen4_brel_mk3_coach_livery_dt_reverse) {
	7: spriteset_mu_coach_gen4_brel_mk3_coach_l1_dt_reverse;
	1: spriteset_mu_coach_gen4_brel_mk3_coach_l2_dt_reverse;
	1: spriteset_mu_coach_gen4_brel_mk3_coach_l3_dt_reverse;
	1: spriteset_mu_coach_gen4_brel_mk3_coach_l4_dt_reverse;
}

// Driving backwards switch
switch(FEAT_TRAINS, PARENT, switch_mu_coach_gen4_brel_mk3_coach_direction, train_is_driving_backwards) {
    1: switch_mu_coach_gen4_brel_mk3_coach_livery_dt_forward;
    switch_mu_coach_gen4_brel_mk3_coach_livery_dt_reverse;
}

// Consist position switch
switch(FEAT_TRAINS, SELF, switch_mu_coach_gen4_brel_mk3_coach_position, position_in_consist_from_end) {
    0: switch_mu_coach_gen4_brel_mk3_coach_direction;
    switch_mu_coach_gen4_brel_mk3_coach_livery_dt_normal;
}
