item(FEAT_TRAINS, item_mu_coach_gen4_bombardier_bi_level) {
    property {
        name: string(str_mu_coach_gen4_bombardier_bi_level);
        climates_available: (((param_region_north_america || param_region_south_america) || param_region_oceania) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1970,1,1);
        model_life: 70;
        vehicle_life: 25;
        retire_early: 0;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 183.01623;
        running_cost_factor: 135.04743;
        speed: 160 km/h;
        power: 0 hp;
        cargo_capacity: 255;
        weight: 54 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        extra_flags: bitmask(VEHICLE_FLAG_TRAIN_HAS_CAB);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE, NARROW_GAUGE_RAILTYPE_NONE, BROAD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/northern", "region/america/south", "region/oceania", "attribute/push_pull", "role/coach__express_"];

    }
    graphics {
        purchase_cargo_capacity: 360;
        purchase: spriteset_mu_coach_gen4_bombardier_bi_level_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        // no 'can_attach'
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_mu_coach_gen4_bombardier_bi_level_position;
        // Always flip because DT has to face backwards
        reverse_build_probability: return 100;
    }
}
