// Notes:
//// HEAD_CAPACITY: 120 -- Gemini - ~80 seated + 30-50 standing (crush load).


item(FEAT_TRAINS, item_mu_coach_gen2_steel_regional_coach) {
    property {
        name: string(str_mu_coach_gen2_steel_regional_coach);
        climates_available: ((((param_region_northern_europe || param_region_eastern_europe || param_region_southern_europe || param_region_western_europe) || param_region_asia || param_region_africa) || param_region_oceania) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1910,1,1);
        model_life: 70;
        vehicle_life: 25;
        retire_early: 0;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 62.25;
        running_cost_factor: 45.0375;
        speed: 100 km/h;
        power: 0 hp;
        cargo_capacity: 120;
        weight: 40 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_NONE, NARROW_GAUGE_RAILTYPE_NONE, BROAD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_DIESEL;
        engine_class: ENGINE_CLASS_DIESEL;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/africa", "region/asia", "region/europe/southern", "region/europe/western", "region/europe/eastern", "region/europe/northern", "region/oceania", "role/coach__commuter_"];

    }
    graphics {
        purchase: spriteset_mu_coach_gen2_steel_regional_coach_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        // no 'can_attach'
        default: switch_mu_coach_gen2_steel_regional_coach_livery;
        // Random flip for variety
        reverse_build_probability: return 50;
    }
}
