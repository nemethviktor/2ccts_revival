// Template: TPL_02A.
// Data from: https://de.wikipedia.org/wiki/BB%C3%96_ET_10

// Notes:
//// WEIGHT: 72.7 -- Techincally these weren't EMUs but railcars and they are 72.7t each
//// POWER: =555*2 -- See note ref weight
//// TE_STARTING_KN: =200/2 -- Again, assuming 2 cars bcs EMU, which these were not.


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_elin_et_10_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 62/2; \
        bitmask(CC_ARMOURED): 62/4; \
        62; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_elin_et_10_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 62/2; \
        bitmask(CC_ARMOURED): 62/4; \
        62; \
    }

item(FEAT_TRAINS, item_emu_elin_et_10) {
    property {
        name: string(str_emu_elin_et_10);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1929,1,1);
        model_life: 45;
        vehicle_life: 44;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 45.05737;
        running_cost_factor: 37.47241;
        speed: 62 km/h;
        power: 1110 hp;
        cargo_capacity: 62;
        weight: 72 ton;
        tractive_effort_coefficient: 0.14;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_15KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "power/electric/ac", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_elin_et_10_purchase;
        cargo_capacity: switch_emu_elin_et_10_capacity_engine;
        visual_effect_and_powered: switch_emu_elin_et_10_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_elin_et_10_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(62/10);
        weight: int(72*1/2);
        cargo_capacity: 62;
        length: 8;
        default: switch_emu_elin_et_10_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(19.70966624979154);
        power: int(1110*1/2);
        weight: int(72*3/4);
        cargo_capacity: 62;
        tractive_effort_coefficient: int(0.14*10*72);
        length: 8;
        default: switch_emu_elin_et_10_cargo_selection;
    }
}
