// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/Tait_(train)

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_victorian_railways_tait_trains_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 72/2; \
        bitmask(CC_ARMOURED): 72/4; \
        72; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_victorian_railways_tait_trains_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 72/2; \
        bitmask(CC_ARMOURED): 72/4; \
        72; \
    }

item(FEAT_TRAINS, item_emu_victorian_railways_tait_trains) {
    property {
        name: string(str_emu_victorian_railways_tait_trains);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1919,1,1);
        model_life: 45;
        vehicle_life: 65;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 25.18;
        running_cost_factor: 31.98;
        speed: 80 km/h;
        power: 282 hp;
        cargo_capacity: 72;
        weight: 35 ton;
        tractive_effort_coefficient: 0.2;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [BROAD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "power/electric/dc", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_victorian_railways_tait_trains_purchase;
        cargo_capacity: switch_emu_victorian_railways_tait_trains_capacity_engine;
        visual_effect_and_powered: switch_emu_victorian_railways_tait_trains_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_victorian_railways_tait_trains_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(80/10);
        weight: int(35*1/2);
        cargo_capacity: 72;
        length: 8;
        default: switch_emu_victorian_railways_tait_trains_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(16.679285562374666);
        power: int(282*1/2);
        weight: int(35*3/4);
        cargo_capacity: 72;
        tractive_effort_coefficient: int(0.2*10*35);
        length: 8;
        default: switch_emu_victorian_railways_tait_trains_cargo_selection;
    }
}
