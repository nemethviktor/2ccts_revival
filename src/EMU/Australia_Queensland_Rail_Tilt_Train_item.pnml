// Template: TPL_02D

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_australia_queensland_rail_tilt_train_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 56/2; \
        bitmask(CC_ARMOURED): 56/4; \
        56; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_australia_queensland_rail_tilt_train_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 56/2; \
        bitmask(CC_ARMOURED): 56/4; \
        56; \
    }

item(FEAT_TRAINS, item_emu_australia_queensland_rail_tilt_train) {
    property {
        name: string(str_emu_australia_queensland_rail_tilt_train);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1997,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 39.92577;
        running_cost_factor: 34.71445;
        speed: 160 km/h;
        power: 910 hp;
        cargo_capacity: 56;
        weight: 47 ton;
        tractive_effort_coefficient: 0.33;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [NARROW_GAUGE_RAILTYPE_25KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

badges: ["power/electric", "flag/AU"];

    }
    graphics {
        purchase: spriteset_emu_australia_queensland_rail_tilt_train_purchase;
        cargo_capacity: switch_emu_australia_queensland_rail_tilt_train_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_australia_queensland_rail_tilt_train_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(160/10);
        weight: int(47*1/2);
        visual_effect_and_powered: switch_emu_australia_queensland_rail_tilt_train_visual_effect_and_powered_position;
        cargo_capacity: 56;
        length: 8;
        default: switch_emu_australia_queensland_rail_tilt_train_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(34.52662565303132));
        power: int(910*1/2);
        weight: int(47*3/4);
        visual_effect_and_powered: switch_emu_australia_queensland_rail_tilt_train_visual_effect_and_powered_position;
        cargo_capacity: 56;
        tractive_effort_coefficient: int(0.33*10*47);
        length: 8;
        default: switch_emu_australia_queensland_rail_tilt_train_cargo_selection;
    }
}
