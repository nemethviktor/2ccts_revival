// Template: TPL_02D.
// Data from: https://en.wikipedia.org/wiki/FS_Class_ETR_300

// Notes:
//// POWER: 1020 -- Cont. rating for 2 head units


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_italy_fs_etr300_settebello_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 27/2; \
        bitmask(CC_ARMOURED): 27/4; \
        27; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_italy_fs_etr300_settebello_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 27/2; \
        bitmask(CC_ARMOURED): 27/4; \
        27; \
    }

item(FEAT_TRAINS, item_emu_italy_fs_etr300_settebello) {
    property {
        name: string(str_emu_italy_fs_etr300_settebello);
        climates_available: ((param_region_southern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1952,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 40.39694;
        running_cost_factor: 35.38529;
        speed: 200 km/h;
        power: 1020 hp;
        cargo_capacity: 27;
        weight: 44 ton;
        tractive_effort_coefficient: 0.08;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_3KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/southern", "flag/IT", "power/electric/dc", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_italy_fs_etr300_settebello_purchase;
        cargo_capacity: switch_emu_italy_fs_etr300_settebello_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_italy_fs_etr300_settebello_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(200/10);
        weight: int(44*1/2);
        cargo_capacity: 27;
        length: 8;
        default: switch_emu_italy_fs_etr300_settebello_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(26.74803149495891));
        power: int(1020*1/2);
        weight: int(44*3/4);
        cargo_capacity: 27;
        tractive_effort_coefficient: int(0.08*10*44);
        length: 8;
        default: switch_emu_italy_fs_etr300_settebello_cargo_selection;
    }
}
