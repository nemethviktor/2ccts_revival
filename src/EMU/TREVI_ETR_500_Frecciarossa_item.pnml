// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/FS_Class_ETR_500

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_trevi_etr_500_frecciarossa_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_trevi_etr_500_frecciarossa_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 68/2; \
        bitmask(CC_ARMOURED): 68/4; \
        68; \
    }

item(FEAT_TRAINS, item_emu_trevi_etr_500_frecciarossa) {
    property {
        name: string(str_emu_trevi_etr_500_frecciarossa);
        climates_available: ((param_region_southern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1993,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 115.19637;
        running_cost_factor: 109.16392;
        speed: 250 km/h;
        power: 11800 hp;
        cargo_capacity: 0;
        weight: 54 ton;
        tractive_effort_coefficient: 0.378;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_25KV, STANDARD_GAUGE_RAILTYPE_3KV, STANDARD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/southern", "power/electric/ac", "role/express"];

    }
    graphics {
        purchase: spriteset_emu_trevi_etr_500_frecciarossa_purchase;
        cargo_capacity: switch_emu_trevi_etr_500_frecciarossa_capacity_engine;
        visual_effect_and_powered: switch_emu_trevi_etr_500_frecciarossa_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_trevi_etr_500_frecciarossa_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(250/10);
        weight: int(54*1/2);
        cargo_capacity: 68;
        length: 8;
        default: switch_emu_trevi_etr_500_frecciarossa_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: round(56.27478049120021);
        power: int(11800*1/2);
        weight: int(54*3/4);
        cargo_capacity: 68;
        tractive_effort_coefficient: int(0.378*10*54);
        length: 8;
        default: switch_emu_trevi_etr_500_frecciarossa_cargo_selection;
    }
}
