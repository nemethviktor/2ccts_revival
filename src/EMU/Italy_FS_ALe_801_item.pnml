// Template: TPL_02A.
// Data from: https://it.wikipedia.org/wiki/Automotrici_FS_ALe_801_e_ALe_940

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_italy_fs_ale_801_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 80/2; \
        bitmask(CC_ARMOURED): 80/4; \
        80; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_italy_fs_ale_801_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 108/2; \
        bitmask(CC_ARMOURED): 108/4; \
        108; \
    }

item(FEAT_TRAINS, item_emu_italy_fs_ale_801) {
    property {
        name: string(str_emu_italy_fs_ale_801);
        climates_available: ((param_region_southern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1975,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 38.89504;
        running_cost_factor: 31.39898;
        speed: 150 km/h;
        power: 702 hp;
        cargo_capacity: 80;
        weight: 70 ton;
        tractive_effort_coefficient: 0.08;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_3KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["power/electric/dc", "flag/IT"];

    }
    graphics {
        purchase: spriteset_emu_italy_fs_ale_801_purchase;
        cargo_capacity: switch_emu_italy_fs_ale_801_capacity_engine;
        visual_effect_and_powered: switch_emu_italy_fs_ale_801_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_italy_fs_ale_801_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(150/10);
        weight: int(70*1/2);
        cargo_capacity: 108;
        length: 7;
        default: switch_emu_italy_fs_ale_801_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(23.249561228095157));
        power: int(702*1/2);
        weight: int(70*3/4);
        cargo_capacity: 108;
        tractive_effort_coefficient: int(0.08*10*70);
        length: 7;
        default: switch_emu_italy_fs_ale_801_cargo_selection;
    }
}
