// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/New_Zealand_FP_class_electric_multiple_unit

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_hyundai_rotem__mitsui_matangi_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 188/2; \
        bitmask(CC_ARMOURED): 188/4; \
        188; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_hyundai_rotem__mitsui_matangi_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 188/2; \
        bitmask(CC_ARMOURED): 188/4; \
        188; \
    }

item(FEAT_TRAINS, item_emu_hyundai_rotem__mitsui_matangi) {
    property {
        name: string(str_emu_hyundai_rotem__mitsui_matangi);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2010,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 41.66958;
        running_cost_factor: 37.43141;
        speed: 120 km/h;
        power: 910 hp;
        cargo_capacity: 188;
        weight: 38 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [NARROW_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "power/electric/dc", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_hyundai_rotem__mitsui_matangi_purchase;
        cargo_capacity: switch_emu_hyundai_rotem__mitsui_matangi_capacity_engine;
        visual_effect_and_powered: switch_emu_hyundai_rotem__mitsui_matangi_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_hyundai_rotem__mitsui_matangi_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(120/10);
        weight: int(38*1/2);
        cargo_capacity: 188;
        length: 8;
        default: switch_emu_hyundai_rotem__mitsui_matangi_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(26.416620625799673);
        power: int(910*1/2);
        weight: int(38*3/4);
        cargo_capacity: 188;
        tractive_effort_coefficient: int(0.3*10*38);
        length: 8;
        default: switch_emu_hyundai_rotem__mitsui_matangi_cargo_selection;
    }
}
