// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/Stadler_KISS

// Notes:
//// WEIGHT: 78 -- 78t each
//// TE_STARTING_KN: =200/2 -- Again, assuming 2 cars bcs EMU, which these were not.


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_stadler_4010_kiss_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 60/2; \
        bitmask(CC_ARMOURED): 60/4; \
        60; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_stadler_4010_kiss_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 140/2; \
        bitmask(CC_ARMOURED): 140/4; \
        140; \
    }

item(FEAT_TRAINS, item_emu_stadler_4010_kiss) {
    property {
        name: string(str_emu_stadler_4010_kiss);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2011,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 85.58639;
        running_cost_factor: 77.22071;
        speed: 200 km/h;
        power: 5340 hp;
        cargo_capacity: 60;
        weight: 78 ton;
        tractive_effort_coefficient: 0.131;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_25KV, STANDARD_GAUGE_RAILTYPE_15KV, STANDARD_GAUGE_RAILTYPE_3KV, BROAD_GAUGE_RAILTYPE_25KV, BROAD_GAUGE_RAILTYPE_15KV, BROAD_GAUGE_RAILTYPE_3KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "power/electric/ac", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_stadler_4010_kiss_purchase;
        cargo_capacity: switch_emu_stadler_4010_kiss_capacity_engine;
        visual_effect_and_powered: switch_emu_stadler_4010_kiss_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_stadler_4010_kiss_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(200/10);
        weight: int(78*1/2);
        cargo_capacity: 140;
        length: 8;
        default: switch_emu_stadler_4010_kiss_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: round(37.52553036257804);
        power: int(5340*1/2);
        weight: int(78*3/4);
        cargo_capacity: 140;
        tractive_effort_coefficient: int(0.131*10*78);
        length: 8;
        default: switch_emu_stadler_4010_kiss_cargo_selection;
    }
}
