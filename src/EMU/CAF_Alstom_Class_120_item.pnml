// Template: TPL_02A.
// Data from: https://es.wikipedia.org/wiki/Serie_120_de_Renfe

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_caf_alstom_class_120_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 60/2; \
        bitmask(CC_ARMOURED): 60/4; \
        60; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_caf_alstom_class_120_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 60/2; \
        bitmask(CC_ARMOURED): 60/4; \
        60; \
    }

item(FEAT_TRAINS, item_emu_caf_alstom_class_120) {
    property {
        name: string(str_emu_caf_alstom_class_120);
        climates_available: ((param_region_southern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2001,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 62.61227;
        running_cost_factor: 55.87981;
        speed: 250 km/h;
        power: 2680 hp;
        cargo_capacity: 60;
        weight: 61 ton;
        tractive_effort_coefficient: 0.08;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_25KV, STANDARD_GAUGE_RAILTYPE_3KV, BROAD_GAUGE_RAILTYPE_25KV, BROAD_GAUGE_RAILTYPE_3KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/southern", "power/electric/ac", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_caf_alstom_class_120_purchase;
        cargo_capacity: switch_emu_caf_alstom_class_120_capacity_engine;
        visual_effect_and_powered: switch_emu_caf_alstom_class_120_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_caf_alstom_class_120_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(250/10);
        weight: int(61*1/2);
        cargo_capacity: 60;
        length: 8;
        default: switch_emu_caf_alstom_class_120_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: round(35.056871642217914);
        power: int(2680*1/2);
        weight: int(61*3/4);
        cargo_capacity: 60;
        tractive_effort_coefficient: int(0.08*10*61);
        length: 8;
        default: switch_emu_caf_alstom_class_120_cargo_selection;
    }
}
