// Template: TPL_02A.
// Data from: https://fr.wikipedia.org/wiki/CFL_s%C3%A9rie_2200

// Notes:
//// TE_STARTING_KN: =240/2 -- 240 total


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_alstom_coradia_duplex_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 111/2; \
        bitmask(CC_ARMOURED): 111/4; \
        111; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_alstom_coradia_duplex_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 111/2; \
        bitmask(CC_ARMOURED): 111/4; \
        111; \
    }

item(FEAT_TRAINS, item_emu_alstom_coradia_duplex) {
    property {
        name: string(str_emu_alstom_coradia_duplex);
        climates_available: (((param_region_northern_europe || param_region_western_europe) || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1999,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 70.88649;
        running_cost_factor: 63.98052;
        speed: 160 km/h;
        power: 3410 hp;
        cargo_capacity: 111;
        weight: 64 ton;
        tractive_effort_coefficient: 0.191;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_25KV, STANDARD_GAUGE_RAILTYPE_15KV, STANDARD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "region/europe/northern", "power/electric/ac", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_alstom_coradia_duplex_purchase;
        cargo_capacity: switch_emu_alstom_coradia_duplex_capacity_engine;
        visual_effect_and_powered: switch_emu_alstom_coradia_duplex_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_alstom_coradia_duplex_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(160/10);
        weight: int(64*1/2);
        cargo_capacity: 111;
        length: 8;
        default: switch_emu_alstom_coradia_duplex_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(34.06352052826257);
        power: int(3410*1/2);
        weight: int(64*3/4);
        cargo_capacity: 111;
        tractive_effort_coefficient: int(0.191*10*64);
        length: 8;
        default: switch_emu_alstom_coradia_duplex_cargo_selection;
    }
}
