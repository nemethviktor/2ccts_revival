// Template: TPL_02D.
// Data from: https://da.wikipedia.org/wiki/Litra_SE

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_denmark_dsb_s_tog_iv_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 90/2; \
        bitmask(CC_ARMOURED): 90/4; \
        90; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_denmark_dsb_s_tog_iv_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 90/2; \
        bitmask(CC_ARMOURED): 90/4; \
        90; \
    }

item(FEAT_TRAINS, item_emu_denmark_dsb_s_tog_iv) {
    property {
        name: string(str_emu_denmark_dsb_s_tog_iv);
        climates_available: ((param_region_northern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1996,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 42.67795;
        running_cost_factor: 39.0802;
        speed: 120 km/h;
        power: 1150 hp;
        cargo_capacity: 90;
        weight: 31 ton;
        tractive_effort_coefficient: 0.121;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 5;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["power/electric/dc", "flag/DK"];

    }
    graphics {
        purchase: spriteset_emu_denmark_dsb_s_tog_iv_purchase;
        cargo_capacity: switch_emu_denmark_dsb_s_tog_iv_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_denmark_dsb_s_tog_iv_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(120/10);
        weight: int(31*1/2);
        visual_effect_and_powered: switch_emu_denmark_dsb_s_tog_iv_visual_effect_and_powered_position;
        cargo_capacity: 90;
        length: 5;
        default: switch_emu_denmark_dsb_s_tog_iv_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(19.202665548180395));
        power: int(1150*1/2);
        weight: int(31*3/4);
        visual_effect_and_powered: switch_emu_denmark_dsb_s_tog_iv_visual_effect_and_powered_position;
        cargo_capacity: 90;
        tractive_effort_coefficient: int(0.121*10*31);
        length: 5;
        default: switch_emu_denmark_dsb_s_tog_iv_cargo_selection;
    }
}
