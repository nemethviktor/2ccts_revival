// Template: TPL_02A.
// Data from: https://sv.wikipedia.org/wiki/X2_(t%C3%A5g)

// Notes:
//// WEIGHT: 73 -- 73t for power cars, each [wiki]
//// TE_STARTING_KN: =160/2 -- Wikipedia
//// WAGON_CAPACITY: 72 -- 2nd class. [wiki]
//// REGION2: APAC -- Exported to AUS & China


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_asea_x2000_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_asea_x2000_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 72/2; \
        bitmask(CC_ARMOURED): 72/4; \
        72; \
    }

item(FEAT_TRAINS, item_emu_asea_x2000) {
    property {
        name: string(str_emu_asea_x2000);
        climates_available: ((param_region_northern_europe || (param_region_asia || param_region_oceania)) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1990,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 74.4516;
        running_cost_factor: 66.58592;
        speed: 200 km/h;
        power: 4400 hp;
        cargo_capacity: 0;
        weight: 73 ton;
        tractive_effort_coefficient: 0.112;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU, TRAIN_FLAG_TILT);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_25KV, STANDARD_GAUGE_RAILTYPE_15KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "region/europe/northern", "region/oceania", "power/electric/ac", "role/express"];

    }
    graphics {
        purchase: spriteset_emu_asea_x2000_purchase;
        cargo_capacity: switch_emu_asea_x2000_capacity_engine;
        visual_effect_and_powered: switch_emu_asea_x2000_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_asea_x2000_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(200/10);
        weight: int(73*1/2);
        cargo_capacity: 72;
        length: 8;
        default: switch_emu_asea_x2000_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: round(34.8092495807108);
        power: int(4400*1/2);
        weight: int(73*3/4);
        cargo_capacity: 72;
        tractive_effort_coefficient: int(0.112*10*73);
        length: 8;
        default: switch_emu_asea_x2000_cargo_selection;
    }
}
