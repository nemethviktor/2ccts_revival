// Template: TPL_02F

// PURCHASE
spriteset(spriteset_emu_mmz_s_purchase, "gfx/emu/mmz_s.png") {template_purchase_dualheaded(1, 128)}


// VEHICLE
/// Front
spriteset(spriteset_emu_mmz_s_front, "gfx/emu/mmz_s.png") {template_2cc_engines_general(1, 1)}


// VEHICLE
/// Back
spriteset(spriteset_emu_mmz_s_back, "gfx/emu/mmz_s.png") {template_2cc_engines_general(1, 32)}


/// MIDDLE   PAX   LIVERY 1
spriteset(spriteset_emu_mmz_s_middlepass_l1, "gfx/emu/mmz_s.png") {template_2cc_engines_general(1, 64)}


/// MIDDLE   PAX   LIVERY 2
spriteset(spriteset_emu_mmz_s_middlepass_l2, "gfx/emu/mmz_s.png") {template_2cc_engines_general(178, 64)}


/// MIDDLE   MAIL   LIVERY
spriteset(spriteset_emu_mmz_s_middlemail, "gfx/emu/mmz_s.png") {template_2cc_engines_general(1, 96)}


// Random Livery Selector for middlepass
random_switch(FEAT_TRAINS, SELF, switch_emu_mmz_s_middlepass_livery) {
	7: spriteset_emu_mmz_s_middlepass_l1;
	3: spriteset_emu_mmz_s_middlepass_l2;
}

/// Dualheaded (reverse switch)
/// In the context of var[0xC8] (which is the variable for "position in consist"):
/// 0xFE: The very first vehicle in the train (The Engine/Front).
/// 0xFF: The very last vehicle in the train (The Caboose/End).
switch(FEAT_TRAINS, SELF, switch_emu_mmz_s_reversed, var[0xC8]) {
    0xFE: spriteset_emu_mmz_s_back;
    0xFF: spriteset_emu_mmz_s_back;
    spriteset_emu_mmz_s_front;
}

// Visual effect and power management
// Position-based logic: ends
/// In the context of var[0xC8] (which is the variable for "position in consist"):
/// 0xFE: The very first vehicle in the train (The Engine/Front).
/// 0xFF: The very last vehicle in the train (The Caboose/End).
switch(FEAT_TRAINS, SELF, switch_emu_mmz_s_visual_effect_and_powered, var[0xC8]) {
    0xFE: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
    0xFF: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
    visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -3, DISABLE_WAGON_POWER);
}

/// Graphics for the unit wagon based on cargo class
switch(FEAT_TRAINS, SELF, switch_emu_mmz_s_cargo_selection, cargo_classes){
	bitmask(CC_PASSENGERS): switch_emu_mmz_s_middlepass_livery;
	spriteset_emu_mmz_s_middlemail;
}