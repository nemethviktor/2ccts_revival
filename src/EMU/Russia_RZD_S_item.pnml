// Template: TPL_02F.
// Data from: https://ru.wikipedia.org/wiki/%D0%A1_(%D1%8D%D0%BB%D0%B5%D0%BA%D1%82%D1%80%D0%BE%D0%BF%D0%BE%D0%B5%D0%B7%D0%B4)

// Notes:
//// POWER: =805*2 -- Technically just 805 because they ran as M+T setup, not M+M but alas.
//// TE_STARTING_KN: 145 -- 145 per motor car


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_russia_rzd_s_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 110/2; \
        bitmask(CC_ARMOURED): 110/4; \
        110; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_russia_rzd_s_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 110/2; \
        bitmask(CC_ARMOURED): 110/4; \
        110; \
    }

item(FEAT_TRAINS, item_emu_russia_rzd_s) {
    property {
        name: string(str_emu_russia_rzd_s);
        climates_available: ((((param_region_asia || param_region_eastern_europe) || param_region_northern_europe) || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1929,1,1);
        model_life: 45;
        vehicle_life: 83;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 52.13129;
        running_cost_factor: 45.85581;
        speed: 85 km/h;
        power: 1610 hp;
        cargo_capacity: 110;
        weight: 58 ton;
        tractive_effort_coefficient: 0.251;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [BROAD_GAUGE_RAILTYPE_3KV, BROAD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "region/europe/eastern", "region/europe/northern", "flag/RU", "power/electric/dc", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_russia_rzd_s_purchase;
        cargo_capacity: switch_emu_russia_rzd_s_capacity_engine;
        visual_effect_and_powered: switch_emu_russia_rzd_s_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_russia_rzd_s_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(85/10);
        weight: int(58*1/2);
        cargo_capacity: 110;
        length: 7;
        default: switch_emu_russia_rzd_s_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(27.296380529602146));
        power: int(1610*1/2);
        weight: int(58*3/4);
        cargo_capacity: 110;
        tractive_effort_coefficient: int(0.251*10*58);
        length: 7;
        default: switch_emu_russia_rzd_s_cargo_selection;
    }
}
