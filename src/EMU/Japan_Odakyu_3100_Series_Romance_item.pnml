// Template: TPL_02D.
// Data from: https://ja.wikipedia.org/wiki/%E5%B0%8F%E7%94%B0%E6%80%A53100%E5%BD%A2%E9%9B%BB%E8%BB%8A#%E7%B7%A8%E6%88%90%E8%A1%A8

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_japan_odakyu_3100_series_romance_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 48/2; \
        bitmask(CC_ARMOURED): 48/4; \
        48; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_japan_odakyu_3100_series_romance_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 42/2; \
        bitmask(CC_ARMOURED): 42/4; \
        42; \
    }

item(FEAT_TRAINS, item_emu_japan_odakyu_3100_series_romance) {
    property {
        name: string(str_emu_japan_odakyu_3100_series_romance);
        climates_available: ((param_region_asia || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1962,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 40.11632;
        running_cost_factor: 36.84563;
        speed: 110 km/h;
        power: 1072 hp;
        cargo_capacity: 48;
        weight: 28 ton;
        tractive_effort_coefficient: 0.126;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [NARROW_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "flag/JP", "power/electric/dc", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_japan_odakyu_3100_series_romance_purchase;
        cargo_capacity: switch_emu_japan_odakyu_3100_series_romance_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_japan_odakyu_3100_series_romance_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(110/10);
        weight: int(28*1/2);
        visual_effect_and_powered: switch_emu_japan_odakyu_3100_series_romance_visual_effect_and_powered_position;
        cargo_capacity: 42;
        length: 8;
        default: switch_emu_japan_odakyu_3100_series_romance_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(17.852542287544413));
        power: int(1072*1/2);
        weight: int(28*3/4);
        visual_effect_and_powered: switch_emu_japan_odakyu_3100_series_romance_visual_effect_and_powered_position;
        cargo_capacity: 42;
        tractive_effort_coefficient: int(0.126*10*28);
        length: 8;
        default: switch_emu_japan_odakyu_3100_series_romance_cargo_selection;
    }
}
