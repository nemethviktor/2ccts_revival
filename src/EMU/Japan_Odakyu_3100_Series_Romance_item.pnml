// Template: TPL_02D. Data from: nan

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_japan_odakyu_3100_series_romance_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 40/2; \
        bitmask(CC_ARMOURED): 40/4; \
        40; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_japan_odakyu_3100_series_romance_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 40/2; \
        bitmask(CC_ARMOURED): 40/4; \
        40; \
    }

item(FEAT_TRAINS, item_emu_japan_odakyu_3100_series_romance) {
    property {
        name: string(str_emu_japan_odakyu_3100_series_romance);
        climates_available: ((param_region_asia || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1962,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 24.36607;
        running_cost_factor: 19.23538;
        speed: 110 km/h;
        power: 230 hp;
        cargo_capacity: 40;
        weight: 47 ton;
        tractive_effort_coefficient: 0.27;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [NARROW_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

badges: ["power/electric", "flag/JP"];

    }
    graphics {
        purchase: spriteset_emu_japan_odakyu_3100_series_romance_purchase;
        cargo_capacity: switch_emu_japan_odakyu_3100_series_romance_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_japan_odakyu_3100_series_romance_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(110/10);
        weight: int(47*1/2);
        visual_effect_and_powered: switch_emu_japan_odakyu_3100_series_romance_visual_effect_and_powered_position;
        cargo_capacity: 40;
        length: 8;
        default: switch_emu_japan_odakyu_3100_series_romance_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(25.211865532264927));
        power: int(230*1/2);
        weight: int(47*3/4);
        visual_effect_and_powered: switch_emu_japan_odakyu_3100_series_romance_visual_effect_and_powered_position;
        cargo_capacity: 40;
        tractive_effort_coefficient: int(0.27*10*47);
        length: 8;
        default: switch_emu_japan_odakyu_3100_series_romance_cargo_selection;
    }
}
