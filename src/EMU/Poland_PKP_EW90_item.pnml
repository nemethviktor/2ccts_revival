// Template: TPL_02A.
// Data from: https://pl.wikipedia.org/wiki/EW90

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_poland_pkp_ew90_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 59/2; \
        bitmask(CC_ARMOURED): 59/4; \
        59; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_poland_pkp_ew90_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 59/2; \
        bitmask(CC_ARMOURED): 59/4; \
        59; \
    }

item(FEAT_TRAINS, item_emu_poland_pkp_ew90) {
    property {
        name: string(str_emu_poland_pkp_ew90);
        climates_available: ((param_region_eastern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1924,1,1);
        model_life: 45;
        vehicle_life: 30;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 28.87587;
        running_cost_factor: 24.69992;
        speed: 80 km/h;
        power: 413 hp;
        cargo_capacity: 59;
        weight: 38 ton;
        tractive_effort_coefficient: 0.107;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/eastern", "flag/PL", "power/electric/dc", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_poland_pkp_ew90_purchase;
        cargo_capacity: switch_emu_poland_pkp_ew90_capacity_engine;
        visual_effect_and_powered: switch_emu_poland_pkp_ew90_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_poland_pkp_ew90_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(80/10);
        weight: int(38*1/2);
        cargo_capacity: 59;
        length: 8;
        default: switch_emu_poland_pkp_ew90_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(14.098862583900232));
        power: int(413*1/2);
        weight: int(38*3/4);
        cargo_capacity: 59;
        tractive_effort_coefficient: int(0.107*10*38);
        length: 8;
        default: switch_emu_poland_pkp_ew90_cargo_selection;
    }
}
