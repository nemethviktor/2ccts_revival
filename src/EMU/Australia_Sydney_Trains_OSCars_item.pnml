// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_Australia_Sydney_Trains_OSCars_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 120/2; \
        bitmask(CC_ARMOURED): 120/4; \
        120; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_Australia_Sydney_Trains_OSCars_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 120/2; \
        bitmask(CC_ARMOURED): 120/4; \
        120; \
    }

item(FEAT_TRAINS, item_emu_Australia_Sydney_Trains_OSCars) {
    property {
        name: string(str_emu_Australia_Sydney_Trains_OSCars);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2007,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 42.10944;
        running_cost_factor: 36.94513;
        speed: 130 km/h;
        power: 950 hp;
        cargo_capacity: 120;
        weight: 47 ton;
        tractive_effort_coefficient: 0.41;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_emu_Australia_Sydney_Trains_OSCars_purchase;
        cargo_capacity: switch_emu_Australia_Sydney_Trains_OSCars_capacity_engine;
        visual_effect_and_powered: switch_emu_Australia_Sydney_Trains_OSCars_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_Australia_Sydney_Trains_OSCars_reversed;
    }
    livery_override (item_mu_MU_Wagon_Unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(130/10);
        weight: int(47*1/2);
        cargo_capacity: 120;
        length: 8;
        default: switch_emu_Australia_Sydney_Trains_OSCars_cargo_selection;
    }
    livery_override (item_mu_MU_Wagon_Powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(35.352210536011384));
        power: int(950*1/2);
        weight: int(47*3/4);
        cargo_capacity: 120;
        tractive_effort_coefficient: int(0.41*10*47);
        length: 8;
        default: switch_emu_Australia_Sydney_Trains_OSCars_cargo_selection;
    }
}
