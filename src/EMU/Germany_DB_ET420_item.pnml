// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_Germany_DB_ET420_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 76/2; \
        bitmask(CC_ARMOURED): 76/4; \
        76; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_Germany_DB_ET420_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 76/2; \
        bitmask(CC_ARMOURED): 76/4; \
        76; \
    }

item(FEAT_TRAINS, item_emu_Germany_DB_ET420) {
    property {
        name: string(str_emu_Germany_DB_ET420);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1969,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 41.70516;
        running_cost_factor: 36.64907;
        speed: 125 km/h;
        power: 1000 hp;
        cargo_capacity: 76;
        weight: 46 ton;
        tractive_effort_coefficient: 0.31;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_15KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_emu_Germany_DB_ET420_purchase;
        cargo_capacity: switch_emu_Germany_DB_ET420_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_Germany_DB_ET420_reversed;
    }
    livery_override (item_mu_MU_Wagon_Unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(125/10);
        weight: int(46*1/2);
        visual_effect_and_powered: switch_emu_Germany_DB_ET420_visual_effect_and_powered_position;
        cargo_capacity: 76;
        length: 8;
        default: switch_emu_Germany_DB_ET420_cargo_selection;
    }
    livery_override (item_mu_MU_Wagon_Powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(29.922279928844183));
        power: int(1000*1/2);
        weight: int(46*3/4);
        visual_effect_and_powered: switch_emu_Germany_DB_ET420_visual_effect_and_powered_position;
        cargo_capacity: 76;
        tractive_effort_coefficient: int(0.31*10*46);
        length: 8;
        default: switch_emu_Germany_DB_ET420_cargo_selection;
    }
}
