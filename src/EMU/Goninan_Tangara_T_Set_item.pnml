// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/Sydney_Trains_T_set

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_goninan_tangara_t_set_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 98/2; \
        bitmask(CC_ARMOURED): 98/4; \
        98; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_goninan_tangara_t_set_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 112/2; \
        bitmask(CC_ARMOURED): 112/4; \
        112; \
    }

item(FEAT_TRAINS, item_emu_goninan_tangara_t_set) {
    property {
        name: string(str_emu_goninan_tangara_t_set);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1988,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 53.62591;
        running_cost_factor: 48.18662;
        speed: 115 km/h;
        power: 1824 hp;
        cargo_capacity: 98;
        weight: 50 ton;
        tractive_effort_coefficient: 0.25;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "power/electric/dc", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_goninan_tangara_t_set_purchase;
        cargo_capacity: switch_emu_goninan_tangara_t_set_capacity_engine;
        visual_effect_and_powered: switch_emu_goninan_tangara_t_set_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_goninan_tangara_t_set_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(115/10);
        weight: int(50*1/2);
        cargo_capacity: 112;
        length: 8;
        default: switch_emu_goninan_tangara_t_set_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(28.270831326044544));
        power: int(1824*1/2);
        weight: int(50*3/4);
        cargo_capacity: 112;
        tractive_effort_coefficient: int(0.25*10*50);
        length: 8;
        default: switch_emu_goninan_tangara_t_set_cargo_selection;
    }
}
