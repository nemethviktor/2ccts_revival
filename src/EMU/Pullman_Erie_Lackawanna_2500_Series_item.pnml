// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/Erie_Lackawanna_MU_Cars

// Notes:
//// TE_STARTING_KN: 135 -- 135 each


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_pullman_erie_lackawanna_2500_series_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 82/2; \
        bitmask(CC_ARMOURED): 82/4; \
        82; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_pullman_erie_lackawanna_2500_series_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 84/2; \
        bitmask(CC_ARMOURED): 84/4; \
        84; \
    }

item(FEAT_TRAINS, item_emu_pullman_erie_lackawanna_2500_series) {
    property {
        name: string(str_emu_pullman_erie_lackawanna_2500_series);
        climates_available: ((param_region_north_america || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1930,1,1);
        model_life: 45;
        vehicle_life: 54;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 43.52936;
        running_cost_factor: 37.01449;
        speed: 101 km/h;
        power: 1020 hp;
        cargo_capacity: 82;
        weight: 61 ton;
        tractive_effort_coefficient: 0.226;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_3KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/northern", "power/electric/dc", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_pullman_erie_lackawanna_2500_series_purchase;
        cargo_capacity: switch_emu_pullman_erie_lackawanna_2500_series_capacity_engine;
        visual_effect_and_powered: switch_emu_pullman_erie_lackawanna_2500_series_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_pullman_erie_lackawanna_2500_series_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(101/10);
        weight: int(61*1/2);
        cargo_capacity: 84;
        length: 8;
        default: switch_emu_pullman_erie_lackawanna_2500_series_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(27.079745780673193));
        power: int(1020*1/2);
        weight: int(61*3/4);
        cargo_capacity: 84;
        tractive_effort_coefficient: int(0.226*10*61);
        length: 8;
        default: switch_emu_pullman_erie_lackawanna_2500_series_cargo_selection;
    }
}
