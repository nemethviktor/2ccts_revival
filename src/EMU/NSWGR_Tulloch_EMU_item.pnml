// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/New_South_Wales_Tulloch_suburban_carriage_stock

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_nswgr_tulloch_emu_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 90/2; \
        bitmask(CC_ARMOURED): 90/4; \
        90; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_nswgr_tulloch_emu_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 90/2; \
        bitmask(CC_ARMOURED): 90/4; \
        90; \
    }

item(FEAT_TRAINS, item_emu_nswgr_tulloch_emu) {
    property {
        name: string(str_emu_nswgr_tulloch_emu);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1940,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 28.76149;
        running_cost_factor: 24.04196;
        speed: 110 km/h;
        power: 360 hp;
        cargo_capacity: 90;
        weight: 43 ton;
        tractive_effort_coefficient: 0.22;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "power/electric/dc", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_nswgr_tulloch_emu_purchase;
        cargo_capacity: switch_emu_nswgr_tulloch_emu_capacity_engine;
        visual_effect_and_powered: switch_emu_nswgr_tulloch_emu_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_nswgr_tulloch_emu_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(110/10);
        weight: int(43*1/2);
        cargo_capacity: 90;
        length: 8;
        default: switch_emu_nswgr_tulloch_emu_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(22.35736659610103);
        power: int(360*1/2);
        weight: int(43*3/4);
        cargo_capacity: 90;
        tractive_effort_coefficient: int(0.22*10*43);
        length: 8;
        default: switch_emu_nswgr_tulloch_emu_cargo_selection;
    }
}
