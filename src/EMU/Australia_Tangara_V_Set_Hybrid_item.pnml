// Template: TPL_02A.
// Data from: nan

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_australia_tangara_v_set_hybrid_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 100/2; \
        bitmask(CC_ARMOURED): 100/4; \
        100; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_australia_tangara_v_set_hybrid_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 100/2; \
        bitmask(CC_ARMOURED): 100/4; \
        100; \
    }

item(FEAT_TRAINS, item_emu_australia_tangara_v_set_hybrid) {
    property {
        name: string(str_emu_australia_tangara_v_set_hybrid);
        climates_available: ((param_region_oceania || 0) && param_concept) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1988,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 51.5218;
        running_cost_factor: 45.65749;
        speed: 130 km/h;
        power: 1600 hp;
        cargo_capacity: 100;
        weight: 54 ton;
        tractive_effort_coefficient: 0.378;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "flag/AU", "power/electric/dc", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_australia_tangara_v_set_hybrid_purchase;
        cargo_capacity: switch_emu_australia_tangara_v_set_hybrid_capacity_engine;
        visual_effect_and_powered: switch_emu_australia_tangara_v_set_hybrid_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_australia_tangara_v_set_hybrid_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(130/10);
        weight: int(54*1/2);
        cargo_capacity: 100;
        length: 8;
        default: switch_emu_australia_tangara_v_set_hybrid_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(37.412));
        power: int(1600*1/2);
        weight: int(54*3/4);
        cargo_capacity: 100;
        tractive_effort_coefficient: int(0.378*10*54);
        length: 8;
        default: switch_emu_australia_tangara_v_set_hybrid_cargo_selection;
    }
}
