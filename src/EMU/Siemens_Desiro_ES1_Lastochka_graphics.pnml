// Template: TPL_02D

// PURCHASE
spriteset(spriteset_emu_siemens_desiro_es1_lastochka_purchase, "gfx/emu/siemens_desiro_es1_lastochka.png") {template_purchase_dualheaded(1, 128)}


// VEHICLE
/// Front
spriteset(spriteset_emu_siemens_desiro_es1_lastochka_front, "gfx/emu/siemens_desiro_es1_lastochka.png") {template_2cc_engines_general(1, 1)}


// VEHICLE
/// Back
spriteset(spriteset_emu_siemens_desiro_es1_lastochka_back, "gfx/emu/siemens_desiro_es1_lastochka.png") {template_2cc_engines_general(1, 32)}


/// MIDDLEPASS L1
spriteset(spriteset_emu_siemens_desiro_es1_lastochka_middlepass_l1, "gfx/emu/siemens_desiro_es1_lastochka.png") {template_2cc_engines_general(1, 64)}


/// MIDDLEMAIL L1
spriteset(spriteset_emu_siemens_desiro_es1_lastochka_middlemail_l1, "gfx/emu/siemens_desiro_es1_lastochka.png") {template_2cc_engines_general(1, 96)}


/// MIDDLEPASS L2
spriteset(spriteset_emu_siemens_desiro_es1_lastochka_middlepass_l2, "gfx/emu/siemens_desiro_es1_lastochka.png") {template_2cc_engines_general(178, 64)}


/// MIDDLEMAIL L2
spriteset(spriteset_emu_siemens_desiro_es1_lastochka_middlemail_l2, "gfx/emu/siemens_desiro_es1_lastochka.png") {template_2cc_engines_general(178, 96)}


/// Dualheaded (reverse switch)
/// In the context of var[0xC8] (which is the variable for "position in consist"):
/// 0xFE: The very first vehicle in the train (The Engine/Front).
/// 0xFF: The very last vehicle in the train (The Caboose/End).
switch(FEAT_TRAINS, SELF, switch_emu_siemens_desiro_es1_lastochka_reversed, var[0xC8]) {
    0xFE: spriteset_emu_siemens_desiro_es1_lastochka_back;
    0xFF: spriteset_emu_siemens_desiro_es1_lastochka_back;
    spriteset_emu_siemens_desiro_es1_lastochka_front;
}

    /// Livery switch for Passengers (pax)
switch(FEAT_TRAINS, SELF, switch_emu_siemens_desiro_es1_lastochka_middlepass_livery, 
    (vehicle_type_id == item_mu_mu_wagon_powered) || 
    (position_in_consist == 1) || 
    (position_in_consist == num_vehs_in_consist - 2)
) {
    1: spriteset_emu_siemens_desiro_es1_lastochka_middlepass_l2; 
    spriteset_emu_siemens_desiro_es1_lastochka_middlepass_l1;
}

/// Livery switch for Mail
switch(FEAT_TRAINS, SELF, switch_emu_siemens_desiro_es1_lastochka_middlemail_livery, 
    (vehicle_type_id == item_mu_mu_wagon_powered) || 
    (position_in_consist == 1) || 
    (position_in_consist == num_vehs_in_consist - 2)
) {
    1: spriteset_emu_siemens_desiro_es1_lastochka_middlemail_l2; 
    spriteset_emu_siemens_desiro_es1_lastochka_middlemail_l1;
}


/// Graphics for the unit wagon based on cargo class
switch(FEAT_TRAINS, SELF, switch_emu_siemens_desiro_es1_lastochka_cargo_selection, cargo_classes){
	bitmask(CC_PASSENGERS): switch_emu_siemens_desiro_es1_lastochka_middlepass_livery;
	switch_emu_siemens_desiro_es1_lastochka_middlemail_livery;
}