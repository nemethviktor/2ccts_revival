// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/Siemens_Nexas

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_siemens_nexas_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 142/2; \
        bitmask(CC_ARMOURED): 142/4; \
        142; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_siemens_nexas_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 140/2; \
        bitmask(CC_ARMOURED): 140/4; \
        140; \
    }

item(FEAT_TRAINS, item_emu_siemens_nexas) {
    property {
        name: string(str_emu_siemens_nexas);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2023,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 46.72111;
        running_cost_factor: 42.23945;
        speed: 145 km/h;
        power: 1286 hp;
        cargo_capacity: 142;
        weight: 40 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [BROAD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "power/electric/dc", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_siemens_nexas_purchase;
        cargo_capacity: switch_emu_siemens_nexas_capacity_engine;
        visual_effect_and_powered: switch_emu_siemens_nexas_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_siemens_nexas_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(145/10);
        weight: int(40*1/2);
        cargo_capacity: 140;
        length: 8;
        default: switch_emu_siemens_nexas_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(30.08608421540822);
        power: int(1286*1/2);
        weight: int(40*3/4);
        cargo_capacity: 140;
        tractive_effort_coefficient: int(0.3*10*40);
        length: 8;
        default: switch_emu_siemens_nexas_cargo_selection;
    }
}
