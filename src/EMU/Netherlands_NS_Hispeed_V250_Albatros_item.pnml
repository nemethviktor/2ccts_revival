// Template: TPL_02A

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_netherlands_ns_hispeed_v250_albatros_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 71/2; \
        bitmask(CC_ARMOURED): 71/4; \
        71; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_netherlands_ns_hispeed_v250_albatros_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 71/2; \
        bitmask(CC_ARMOURED): 71/4; \
        71; \
    }

item(FEAT_TRAINS, item_emu_netherlands_ns_hispeed_v250_albatros) {
    property {
        name: string(str_emu_netherlands_ns_hispeed_v250_albatros);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2012,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 54.6044;
        running_cost_factor: 48.16906;
        speed: 251 km/h;
        power: 1850 hp;
        cargo_capacity: 71;
        weight: 58 ton;
        tractive_effort_coefficient: 0.52;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_OHLE];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_emu_netherlands_ns_hispeed_v250_albatros_purchase;
        cargo_capacity: switch_emu_netherlands_ns_hispeed_v250_albatros_capacity_engine;
        visual_effect_and_powered: switch_emu_netherlands_ns_hispeed_v250_albatros_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_netherlands_ns_hispeed_v250_albatros_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(251/10);
        weight: int(58*1/2);
        cargo_capacity: 71;
        length: 8;
        default: switch_emu_netherlands_ns_hispeed_v250_albatros_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(59.56116266764515));
        power: int(1850*1/2);
        weight: int(58*3/4);
        cargo_capacity: 71;
        tractive_effort_coefficient: int(0.52*10*58);
        length: 8;
        default: switch_emu_netherlands_ns_hispeed_v250_albatros_cargo_selection;
    }
}
