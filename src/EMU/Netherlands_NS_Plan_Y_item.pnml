// Template: TPL_02A.
// Data from: https://nl.wikipedia.org/wiki/Stadsgewestelijk_Materieel

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_netherlands_ns_plan_y_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 77/2; \
        bitmask(CC_ARMOURED): 77/4; \
        77; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_netherlands_ns_plan_y_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 77/2; \
        bitmask(CC_ARMOURED): 77/4; \
        77; \
    }

item(FEAT_TRAINS, item_emu_netherlands_ns_plan_y) {
    property {
        name: string(str_emu_netherlands_ns_plan_y);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1975,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 52.12367;
        running_cost_factor: 46.36757;
        speed: 125 km/h;
        power: 1720 hp;
        cargo_capacity: 77;
        weight: 53 ton;
        tractive_effort_coefficient: 0.154;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["power/electric", "flag/NL"];

    }
    graphics {
        purchase: spriteset_emu_netherlands_ns_plan_y_purchase;
        cargo_capacity: switch_emu_netherlands_ns_plan_y_capacity_engine;
        visual_effect_and_powered: switch_emu_netherlands_ns_plan_y_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_netherlands_ns_plan_y_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(125/10);
        weight: int(53*1/2);
        cargo_capacity: 77;
        length: 8;
        default: switch_emu_netherlands_ns_plan_y_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(24.809288276056446));
        power: int(1720*1/2);
        weight: int(53*3/4);
        cargo_capacity: 77;
        tractive_effort_coefficient: int(0.154*10*53);
        length: 8;
        default: switch_emu_netherlands_ns_plan_y_cargo_selection;
    }
}
