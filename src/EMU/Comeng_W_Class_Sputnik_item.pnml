// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_comeng_w_class_sputnik_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 59/2; \
        bitmask(CC_ARMOURED): 59/4; \
        59; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_comeng_w_class_sputnik_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 70/2; \
        bitmask(CC_ARMOURED): 70/4; \
        70; \
    }

item(FEAT_TRAINS, item_emu_comeng_w_class_sputnik) {
    property {
        name: string(str_emu_comeng_w_class_sputnik);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1957,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 37.30639;
        running_cost_factor: 31.71821;
        speed: 120 km/h;
        power: 760 hp;
        cargo_capacity: 59;
        weight: 51 ton;
        tractive_effort_coefficient: 0.2;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [NARROW_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "power/electric/dc", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_comeng_w_class_sputnik_purchase;
        cargo_capacity: switch_emu_comeng_w_class_sputnik_capacity_engine;
        visual_effect_and_powered: switch_emu_comeng_w_class_sputnik_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_comeng_w_class_sputnik_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(120/10);
        weight: int(51*1/2);
        cargo_capacity: 70;
        length: 8;
        default: switch_emu_comeng_w_class_sputnik_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(25.056809750418047);
        power: int(760*1/2);
        weight: int(51*3/4);
        cargo_capacity: 70;
        tractive_effort_coefficient: int(0.2*10*51);
        length: 8;
        default: switch_emu_comeng_w_class_sputnik_cargo_selection;
    }
}
