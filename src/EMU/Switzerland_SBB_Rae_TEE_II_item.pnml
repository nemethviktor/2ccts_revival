// Template: TPL_02D.
// Data from: https://de.wikipedia.org/wiki/SBB_RAe_TEE_II

// Notes:
//// POWER: 3100 -- Reporting for the dedicated power car (the Re unit). In this formation, only the center power car provides traction; the cab cars are unpowered driving trailers. [Gemini ++ Wiki]


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_switzerland_sbb_rae_tee_ii_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 58/2; \
        bitmask(CC_ARMOURED): 58/4; \
        58; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_switzerland_sbb_rae_tee_ii_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 58/2; \
        bitmask(CC_ARMOURED): 58/4; \
        58; \
    }

item(FEAT_TRAINS, item_emu_switzerland_sbb_rae_tee_ii) {
    property {
        name: string(str_emu_switzerland_sbb_rae_tee_ii);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1961,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 65.58806;
        running_cost_factor: 60.14341;
        speed: 160 km/h;
        power: 3100 hp;
        cargo_capacity: 58;
        weight: 49 ton;
        tractive_effort_coefficient: 0.194;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_OHLE];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "flag/CH", "power/electric", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_switzerland_sbb_rae_tee_ii_purchase;
        cargo_capacity: switch_emu_switzerland_sbb_rae_tee_ii_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_switzerland_sbb_rae_tee_ii_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(160/10);
        weight: int(49*1/2);
        visual_effect_and_powered: switch_emu_switzerland_sbb_rae_tee_ii_visual_effect_and_powered_position;
        cargo_capacity: 58;
        length: 8;
        default: switch_emu_switzerland_sbb_rae_tee_ii_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(31.138444757647413));
        power: int(3100*1/2);
        weight: int(49*3/4);
        visual_effect_and_powered: switch_emu_switzerland_sbb_rae_tee_ii_visual_effect_and_powered_position;
        cargo_capacity: 58;
        tractive_effort_coefficient: int(0.194*10*49);
        length: 8;
        default: switch_emu_switzerland_sbb_rae_tee_ii_cargo_selection;
    }
}
