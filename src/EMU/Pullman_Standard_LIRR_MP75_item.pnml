// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/ACMU

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_pullman_standard_lirr_mp75_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 130/2; \
        bitmask(CC_ARMOURED): 130/4; \
        130; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_pullman_standard_lirr_mp75_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 130/2; \
        bitmask(CC_ARMOURED): 130/4; \
        130; \
    }

item(FEAT_TRAINS, item_emu_pullman_standard_lirr_mp75) {
    property {
        name: string(str_emu_pullman_standard_lirr_mp75);
        climates_available: ((param_region_north_america || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1963,1,1);
        model_life: 45;
        vehicle_life: 41;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 37.40524;
        running_cost_factor: 34.34917;
        speed: 130 km/h;
        power: 800 hp;
        cargo_capacity: 130;
        weight: 26 ton;
        tractive_effort_coefficient: 0.25;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_3RD];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/northern", "power/electric", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_pullman_standard_lirr_mp75_purchase;
        cargo_capacity: switch_emu_pullman_standard_lirr_mp75_capacity_engine;
        visual_effect_and_powered: switch_emu_pullman_standard_lirr_mp75_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_pullman_standard_lirr_mp75_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(130/10);
        weight: int(26*1/2);
        cargo_capacity: 130;
        length: 8;
        default: switch_emu_pullman_standard_lirr_mp75_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(22.32842712474619);
        power: int(800*1/2);
        weight: int(26*3/4);
        cargo_capacity: 130;
        tractive_effort_coefficient: int(0.25*10*26);
        length: 8;
        default: switch_emu_pullman_standard_lirr_mp75_cargo_selection;
    }
}
