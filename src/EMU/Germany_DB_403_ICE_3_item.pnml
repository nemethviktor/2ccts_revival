// Template: TPL_02D.
// Data from: https://en.wikipedia.org/wiki/ICE_3

// Notes:
//// TE_STARTING_KN: =300/2 -- EN wiki


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_germany_db_403_ice_3_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 55/2; \
        bitmask(CC_ARMOURED): 55/4; \
        55; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_germany_db_403_ice_3_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 55/2; \
        bitmask(CC_ARMOURED): 55/4; \
        55; \
    }

item(FEAT_TRAINS, item_emu_germany_db_403_ice_3) {
    property {
        name: string(str_emu_germany_db_403_ice_3);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2000,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 114.26894;
        running_cost_factor: 108.43136;
        speed: 328 km/h;
        power: 10728 hp;
        cargo_capacity: 55;
        weight: 51 ton;
        tractive_effort_coefficient: 0.299;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_15KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "flag/DE", "power/electric/ac", "role/ultra_high_speed__pax_"];

    }
    graphics {
        purchase: spriteset_emu_germany_db_403_ice_3_purchase;
        cargo_capacity: switch_emu_germany_db_403_ice_3_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_germany_db_403_ice_3_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(328/10);
        weight: int(51*1/2);
        cargo_capacity: 55;
        length: 8;
        default: switch_emu_germany_db_403_ice_3_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(58.47514112884971));
        power: int(10728*1/2);
        weight: int(51*3/4);
        cargo_capacity: 55;
        tractive_effort_coefficient: int(0.299*10*51);
        length: 8;
        default: switch_emu_germany_db_403_ice_3_cargo_selection;
    }
}
