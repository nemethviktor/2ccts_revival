// Template: TPL_02D.
// Data from: https://no.wikipedia.org/wiki/Type_73_(motorvognsett)

// Notes:
//// POWER: =1166*2 -- 2 head cars
//// TE_STARTING_KN: =117/2 -- Wikipedia


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_norway_nsb_bm73_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 54/2; \
        bitmask(CC_ARMOURED): 54/4; \
        54; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_norway_nsb_bm73_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 54/2; \
        bitmask(CC_ARMOURED): 54/4; \
        54; \
    }

item(FEAT_TRAINS, item_emu_norway_nsb_bm73) {
    property {
        name: string(str_emu_norway_nsb_bm73);
        climates_available: ((param_region_northern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1998,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 58.56513;
        running_cost_factor: 52.58274;
        speed: 210 km/h;
        power: 2332 hp;
        cargo_capacity: 54;
        weight: 54 ton;
        tractive_effort_coefficient: 0.11;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_15KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/northern", "flag/NO", "power/electric/ac", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_norway_nsb_bm73_purchase;
        cargo_capacity: switch_emu_norway_nsb_bm73_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_norway_nsb_bm73_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(210/10);
        weight: int(54*1/2);
        visual_effect_and_powered: switch_emu_norway_nsb_bm73_visual_effect_and_powered_position;
        cargo_capacity: 54;
        length: 8;
        default: switch_emu_norway_nsb_bm73_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(31.76907954320171));
        power: int(2332*1/2);
        weight: int(54*3/4);
        visual_effect_and_powered: switch_emu_norway_nsb_bm73_visual_effect_and_powered_position;
        cargo_capacity: 54;
        tractive_effort_coefficient: int(0.11*10*54);
        length: 8;
        default: switch_emu_norway_nsb_bm73_cargo_selection;
    }
}
