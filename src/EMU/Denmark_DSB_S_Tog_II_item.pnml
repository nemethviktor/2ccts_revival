// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_Denmark_DSB_S_Tog_II_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 56/2; \
        bitmask(CC_ARMOURED): 56/4; \
        56; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_Denmark_DSB_S_Tog_II_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 42/2; \
        bitmask(CC_ARMOURED): 42/4; \
        42; \
    }

item(FEAT_TRAINS, item_emu_Denmark_DSB_S_Tog_II) {
    property {
        name: string(str_emu_Denmark_DSB_S_Tog_II);
        climates_available: ((param_region_northern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1966,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 23.46673;
        running_cost_factor: 18.55366;
        speed: 100 km/h;
        power: 200 hp;
        cargo_capacity: 56;
        weight: 45 ton;
        tractive_effort_coefficient: 0.14;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_emu_Denmark_DSB_S_Tog_II_purchase;
        cargo_capacity: switch_emu_Denmark_DSB_S_Tog_II_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_Denmark_DSB_S_Tog_II_reversed;
    }
    livery_override (item_mu_MU_Wagon_Unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(100/10);
        weight: int(45*1/2);
        visual_effect_and_powered: switch_emu_Denmark_DSB_S_Tog_II_visual_effect_and_powered_position;
        cargo_capacity: 42;
        length: 8;
        default: switch_emu_Denmark_DSB_S_Tog_II_cargo_selection;
    }
    livery_override (item_mu_MU_Wagon_Powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(17.72200311106765));
        power: int(200*1/2);
        weight: int(45*3/4);
        visual_effect_and_powered: switch_emu_Denmark_DSB_S_Tog_II_visual_effect_and_powered_position;
        cargo_capacity: 42;
        tractive_effort_coefficient: int(0.14*10*45);
        length: 8;
        default: switch_emu_Denmark_DSB_S_Tog_II_cargo_selection;
    }
}
