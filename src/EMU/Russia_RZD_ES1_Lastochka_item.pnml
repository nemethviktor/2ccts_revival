// Template: TPL_02D.
// Data from: https://en.wikipedia.org/wiki/Lastochka

// Notes:
//// TE_STARTING_KN: 90 -- 90 each


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_russia_rzd_es1_lastochka_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 67/2; \
        bitmask(CC_ARMOURED): 67/4; \
        67; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_russia_rzd_es1_lastochka_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 88/2; \
        bitmask(CC_ARMOURED): 88/4; \
        88; \
    }

item(FEAT_TRAINS, item_emu_russia_rzd_es1_lastochka) {
    property {
        name: string(str_emu_russia_rzd_es1_lastochka);
        climates_available: ((param_region_asia || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2011,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 62.74244;
        running_cost_factor: 56.63113;
        speed: 160 km/h;
        power: 2700 hp;
        cargo_capacity: 67;
        weight: 56 ton;
        tractive_effort_coefficient: 0.164;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [BROAD_GAUGE_RAILTYPE_OHLE];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["power/electric", "flag/RU"];

    }
    graphics {
        purchase: spriteset_emu_russia_rzd_es1_lastochka_purchase;
        cargo_capacity: switch_emu_russia_rzd_es1_lastochka_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_russia_rzd_es1_lastochka_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(160/10);
        weight: int(56*1/2);
        visual_effect_and_powered: switch_emu_russia_rzd_es1_lastochka_visual_effect_and_powered_position;
        cargo_capacity: 88;
        length: 8;
        default: switch_emu_russia_rzd_es1_lastochka_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(30.380156438726996));
        power: int(2700*1/2);
        weight: int(56*3/4);
        visual_effect_and_powered: switch_emu_russia_rzd_es1_lastochka_visual_effect_and_powered_position;
        cargo_capacity: 88;
        tractive_effort_coefficient: int(0.164*10*56);
        length: 8;
        default: switch_emu_russia_rzd_es1_lastochka_cargo_selection;
    }
}
