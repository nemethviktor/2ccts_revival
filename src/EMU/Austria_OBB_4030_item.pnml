// Template: TPL_02A.
// Data from: https://de.wikipedia.org/wiki/%C3%96BB_4030

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_austria_obb_4030_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 72/2; \
        bitmask(CC_ARMOURED): 72/4; \
        72; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_austria_obb_4030_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 72/2; \
        bitmask(CC_ARMOURED): 72/4; \
        72; \
    }

item(FEAT_TRAINS, item_emu_austria_obb_4030) {
    property {
        name: string(str_emu_austria_obb_4030);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1956,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 46.15454;
        running_cost_factor: 41.34147;
        speed: 100 km/h;
        power: 1341 hp;
        cargo_capacity: 72;
        weight: 44 ton;
        tractive_effort_coefficient: 0.115;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_15KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["power/electric/ac", "flag/AT"];

    }
    graphics {
        purchase: spriteset_emu_austria_obb_4030_purchase;
        cargo_capacity: switch_emu_austria_obb_4030_capacity_engine;
        visual_effect_and_powered: switch_emu_austria_obb_4030_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_austria_obb_4030_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(100/10);
        weight: int(44*1/2);
        cargo_capacity: 72;
        length: 7;
        default: switch_emu_austria_obb_4030_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(18.72196674583372));
        power: int(1341*1/2);
        weight: int(44*3/4);
        cargo_capacity: 72;
        tractive_effort_coefficient: int(0.115*10*44);
        length: 7;
        default: switch_emu_austria_obb_4030_cargo_selection;
    }
}
