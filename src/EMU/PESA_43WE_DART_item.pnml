// Template: TPL_02E.
// Data from: https://en.wikipedia.org/wiki/Pesa_Dart

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_pesa_43we_dart_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 44/2; \
        bitmask(CC_ARMOURED): 44/4; \
        44; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_pesa_43we_dart_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 44/2; \
        bitmask(CC_ARMOURED): 44/4; \
        44; \
    }

item(FEAT_TRAINS, item_emu_pesa_43we_dart) {
    property {
        name: string(str_emu_pesa_43we_dart);
        climates_available: ((param_region_eastern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2014,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 65.914;
        running_cost_factor: 60.47053;
        speed: 160 km/h;
        power: 3218 hp;
        cargo_capacity: 44;
        weight: 49 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_3KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/eastern", "power/electric/dc", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_pesa_43we_dart_purchase;
        cargo_capacity: switch_emu_pesa_43we_dart_capacity_engine;
        visual_effect_and_powered: switch_emu_pesa_43we_dart_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_pesa_43we_dart_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(160/10);
        weight: int(49*1/2);
        cargo_capacity: 44;
        length: 8;
        default: switch_emu_pesa_43we_dart_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(36.48524184147313);
        power: int(3218*1/2);
        weight: int(49*3/4);
        cargo_capacity: 44;
        tractive_effort_coefficient: int(0.3*10*49);
        length: 8;
        default: switch_emu_pesa_43we_dart_cargo_selection;
    }
}
