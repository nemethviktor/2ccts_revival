// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/AES_Railcar

// Notes:
//// POWER: =805*2 -- Technically just 805 because they ran as M+T setup, not M+M but alas.
//// TE_STARTING_KN: 85 -- 85 each


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_chile_efe_aes_railcar_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 88/2; \
        bitmask(CC_ARMOURED): 88/4; \
        88; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_chile_efe_aes_railcar_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 92/2; \
        bitmask(CC_ARMOURED): 92/4; \
        92; \
    }

item(FEAT_TRAINS, item_emu_chile_efe_aes_railcar) {
    property {
        name: string(str_emu_chile_efe_aes_railcar);
        climates_available: ((param_region_south_america || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1976,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 50.96126;
        running_cost_factor: 45.29694;
        speed: 130 km/h;
        power: 1610 hp;
        cargo_capacity: 88;
        weight: 52 ton;
        tractive_effort_coefficient: 0.167;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [BROAD_GAUGE_RAILTYPE_3KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/south", "flag/CL", "power/electric/dc", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_chile_efe_aes_railcar_purchase;
        cargo_capacity: switch_emu_chile_efe_aes_railcar_capacity_engine;
        visual_effect_and_powered: switch_emu_chile_efe_aes_railcar_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_chile_efe_aes_railcar_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(130/10);
        weight: int(52*1/2);
        cargo_capacity: 92;
        length: 7;
        default: switch_emu_chile_efe_aes_railcar_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(25.696480529602145));
        power: int(1610*1/2);
        weight: int(52*3/4);
        cargo_capacity: 92;
        tractive_effort_coefficient: int(0.167*10*52);
        length: 7;
        default: switch_emu_chile_efe_aes_railcar_cargo_selection;
    }
}
