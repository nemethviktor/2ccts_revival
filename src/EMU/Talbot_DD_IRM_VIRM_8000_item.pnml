// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/NS_VIRM

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_talbot_dd_irm_virm_8000_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 95/2; \
        bitmask(CC_ARMOURED): 95/4; \
        95; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_talbot_dd_irm_virm_8000_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 95/2; \
        bitmask(CC_ARMOURED): 95/4; \
        95; \
    }

item(FEAT_TRAINS, item_emu_talbot_dd_irm_virm_8000) {
    property {
        name: string(str_emu_talbot_dd_irm_virm_8000);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1994,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 52.24089;
        running_cost_factor: 46.5676;
        speed: 140 km/h;
        power: 1720 hp;
        cargo_capacity: 95;
        weight: 52 ton;
        tractive_effort_coefficient: 0.103;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "power/electric/dc", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_talbot_dd_irm_virm_8000_purchase;
        cargo_capacity: switch_emu_talbot_dd_irm_virm_8000_capacity_engine;
        visual_effect_and_powered: switch_emu_talbot_dd_irm_virm_8000_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_talbot_dd_irm_virm_8000_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(140/10);
        weight: int(52*1/2);
        cargo_capacity: 95;
        length: 8;
        default: switch_emu_talbot_dd_irm_virm_8000_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(23.503288270665543);
        power: int(1720*1/2);
        weight: int(52*3/4);
        cargo_capacity: 95;
        tractive_effort_coefficient: int(0.103*10*52);
        length: 8;
        default: switch_emu_talbot_dd_irm_virm_8000_cargo_selection;
    }
}
