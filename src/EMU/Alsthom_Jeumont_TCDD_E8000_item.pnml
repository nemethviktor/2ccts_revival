// Template: TPL_02A.
// Data from: https://tr.wikipedia.org/wiki/TCDD_E8000

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_alsthom_jeumont_tcdd_e8000_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 81/2; \
        bitmask(CC_ARMOURED): 81/4; \
        81; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_alsthom_jeumont_tcdd_e8000_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 81/2; \
        bitmask(CC_ARMOURED): 81/4; \
        81; \
    }

item(FEAT_TRAINS, item_emu_alsthom_jeumont_tcdd_e8000) {
    property {
        name: string(str_emu_alsthom_jeumont_tcdd_e8000);
        climates_available: (((param_region_asia || param_region_eastern_europe) || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1955,1,1);
        model_life: 45;
        vehicle_life: 56;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 42.32;
        running_cost_factor: 46.2;
        speed: 90 km/h;
        power: 1100 hp;
        cargo_capacity: 81;
        weight: 40 ton;
        tractive_effort_coefficient: 0.178;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_25KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "region/europe/eastern", "power/electric/ac", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_alsthom_jeumont_tcdd_e8000_purchase;
        cargo_capacity: switch_emu_alsthom_jeumont_tcdd_e8000_capacity_engine;
        visual_effect_and_powered: switch_emu_alsthom_jeumont_tcdd_e8000_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_alsthom_jeumont_tcdd_e8000_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(90/10);
        weight: int(40*1/2);
        cargo_capacity: 81;
        length: 8;
        default: switch_emu_alsthom_jeumont_tcdd_e8000_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(19.4366247903554);
        power: int(1100*1/2);
        weight: int(40*3/4);
        cargo_capacity: 81;
        tractive_effort_coefficient: int(0.178*10*40);
        length: 8;
        default: switch_emu_alsthom_jeumont_tcdd_e8000_cargo_selection;
    }
}
