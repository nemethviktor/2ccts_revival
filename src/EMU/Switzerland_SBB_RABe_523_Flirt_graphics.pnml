/*
* PURCHASE
*/

spriteset(spriteset_emu_Switzerland_SBB_RABe_523_Flirt_purchase, "gfx/EMU/Switzerland_SBB_RABe_523_Flirt.png") {
	template_purchase_dualheaded(1, 128)
}

/*
* VEHICLE
*/

//Front
spriteset(spriteset_emu_Switzerland_SBB_RABe_523_Flirt_front, "gfx/EMU/Switzerland_SBB_RABe_523_Flirt.png") {
	template_2cc_engines_general(1, 1)
}

//Back
spriteset(spriteset_emu_Switzerland_SBB_RABe_523_Flirt_back, "gfx/EMU/Switzerland_SBB_RABe_523_Flirt.png") {
	template_2cc_engines_general(1, 32)
}

//Middle - PAX
spriteset(spriteset_emu_Switzerland_SBB_RABe_523_Flirt_middlepass, "gfx/EMU/Switzerland_SBB_RABe_523_Flirt.png") {
	template_2cc_engines_general(1, 64)
}
//Middle - MAIL
spriteset(spriteset_emu_Switzerland_SBB_RABe_523_Flirt_middlemail, "gfx/EMU/Switzerland_SBB_RABe_523_Flirt.png") {
	template_2cc_engines_general(1, 96)
}

//Dualheaded engines
switch(FEAT_TRAINS, SELF, switch_emu_Switzerland_SBB_RABe_523_Flirt_reversed, var[0xC8]) {
	0xFE: spriteset_emu_Switzerland_SBB_RABe_523_Flirt_back;
    0xFF: spriteset_emu_Switzerland_SBB_RABe_523_Flirt_back; 
    spriteset_emu_Switzerland_SBB_RABe_523_Flirt_front;
}

//Visual effect, for EMU this is done on the part with the pantograph
switch(FEAT_TRAINS, SELF, switch_emu_Switzerland_SBB_RABe_523_Flirt_visual_effect_and_powered, var[0xC8]) {
	0xFE: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
	0xFF: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
	visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -3, DISABLE_WAGON_POWER);
}
	
/*
* Cargo capacity
*/

// ENGINECAPACITYSWITCH(VEHIDCODE)

// WAGONCAPACITYSWITCH(VEHIDCODE)

//Graphics for the unit wagon based on cargo class
switch(FEAT_TRAINS, SELF, switch_emu_Switzerland_SBB_RABe_523_Flirt_cargo_selection, cargo_classes){
	bitmask(CC_PASSENGERS): spriteset_emu_Switzerland_SBB_RABe_523_Flirt_middlepass;
	spriteset_emu_Switzerland_SBB_RABe_523_Flirt_middlemail;
}

