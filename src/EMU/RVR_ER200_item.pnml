// Template: TPL_02D.
// Data from: https://en.wikipedia.org/wiki/ER200

// Notes:
//// TE_STARTING_KN: 35.6 -- 35.6 each


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_rvr_er200_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 64/2; \
        bitmask(CC_ARMOURED): 64/4; \
        64; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_rvr_er200_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 64/2; \
        bitmask(CC_ARMOURED): 64/4; \
        64; \
    }

item(FEAT_TRAINS, item_emu_rvr_er200) {
    property {
        name: string(str_emu_rvr_er200);
        climates_available: ((param_region_eastern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1973,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 45.46;
        running_cost_factor: 57.06;
        speed: 200 km/h;
        power: 1280 hp;
        cargo_capacity: 64;
        weight: 49 ton;
        tractive_effort_coefficient: 0.074;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [BROAD_GAUGE_RAILTYPE_3KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/eastern", "power/electric/dc", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_rvr_er200_purchase;
        cargo_capacity: switch_emu_rvr_er200_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_rvr_er200_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(200/10);
        weight: int(49*1/2);
        cargo_capacity: 64;
        length: 8;
        default: switch_emu_rvr_er200_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: round(27.203708763999664);
        power: int(1280*1/2);
        weight: int(49*3/4);
        cargo_capacity: 64;
        tractive_effort_coefficient: int(0.074*10*49);
        length: 8;
        default: switch_emu_rvr_er200_cargo_selection;
    }
}
