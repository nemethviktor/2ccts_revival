// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/VR_Class_Sm2

// Notes:
//// WEIGHT: =(46.5+76)/2 -- Technically it's 1 MU + 1 DT and this is their combined avg
//// POWER: 818 -- Wiki says 208, railfaneurope says 818…go figure.
//// TE_STARTING_KN: =85/2 -- //www.railfaneurope.net/list/finland_vr.html


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_finland_vr_sm2_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 100/2; \
        bitmask(CC_ARMOURED): 100/4; \
        100; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_finland_vr_sm2_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 100/2; \
        bitmask(CC_ARMOURED): 100/4; \
        100; \
    }

item(FEAT_TRAINS, item_emu_finland_vr_sm2) {
    property {
        name: string(str_emu_finland_vr_sm2);
        climates_available: ((param_region_northern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1975,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 40.51992;
        running_cost_factor: 33.94716;
        speed: 120 km/h;
        power: 818 hp;
        cargo_capacity: 100;
        weight: 61 ton;
        tractive_effort_coefficient: 0.071;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [NARROW_GAUGE_RAILTYPE_25KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/northern", "flag/FI", "power/electric/ac", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_finland_vr_sm2_purchase;
        cargo_capacity: switch_emu_finland_vr_sm2_capacity_engine;
        visual_effect_and_powered: switch_emu_finland_vr_sm2_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_finland_vr_sm2_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(120/10);
        weight: int(61*1/2);
        cargo_capacity: 100;
        length: 8;
        default: switch_emu_finland_vr_sm2_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(19.208831292565826));
        power: int(818*1/2);
        weight: int(61*3/4);
        cargo_capacity: 100;
        tractive_effort_coefficient: int(0.071*10*61);
        length: 8;
        default: switch_emu_finland_vr_sm2_cargo_selection;
    }
}
