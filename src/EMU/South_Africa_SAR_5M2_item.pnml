// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/South_African_Class_5M2

// Notes:
//// TE_STARTING_KN: 160 -- 160 ea
//// WAGON_CAPACITY: =149+52 -- Standing + seating per wiki


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_south_africa_sar_5m2_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 88/2; \
        bitmask(CC_ARMOURED): 88/4; \
        88; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_south_africa_sar_5m2_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 201/2; \
        bitmask(CC_ARMOURED): 201/4; \
        201; \
    }

item(FEAT_TRAINS, item_emu_south_africa_sar_5m2) {
    property {
        name: string(str_emu_south_africa_sar_5m2);
        climates_available: ((param_region_africa || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1958,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 61.47701;
        running_cost_factor: 55.06394;
        speed: 100 km/h;
        power: 2480 hp;
        cargo_capacity: 88;
        weight: 60 ton;
        tractive_effort_coefficient: 0.272;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [NARROW_GAUGE_RAILTYPE_3KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/africa", "flag/ZA", "power/electric/dc", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_south_africa_sar_5m2_purchase;
        cargo_capacity: switch_emu_south_africa_sar_5m2_capacity_engine;
        visual_effect_and_powered: switch_emu_south_africa_sar_5m2_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_south_africa_sar_5m2_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(100/10);
        weight: int(60*1/2);
        cargo_capacity: 201;
        length: 7;
        default: switch_emu_south_africa_sar_5m2_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(31.299961634834794));
        power: int(2480*1/2);
        weight: int(60*3/4);
        cargo_capacity: 201;
        tractive_effort_coefficient: int(0.272*10*60);
        length: 7;
        default: switch_emu_south_africa_sar_5m2_cargo_selection;
    }
}
