// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/New_South_Wales_S_set

// Notes:
//// POWER: 1600 -- 800 ea
//// TE_STARTING_KN: 110 -- 110 ea


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_australia_sydney_trains_s_set_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 112/2; \
        bitmask(CC_ARMOURED): 112/4; \
        112; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_australia_sydney_trains_s_set_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 130/2; \
        bitmask(CC_ARMOURED): 130/4; \
        130; \
    }

item(FEAT_TRAINS, item_emu_australia_sydney_trains_s_set) {
    property {
        name: string(str_emu_australia_sydney_trains_s_set);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1972,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 50.91494;
        running_cost_factor: 45.77565;
        speed: 115 km/h;
        power: 1600 hp;
        cargo_capacity: 112;
        weight: 47 ton;
        tractive_effort_coefficient: 0.239;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -3, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["power/electric/dc", "flag/AU"];

    }
    graphics {
        purchase: spriteset_emu_australia_sydney_trains_s_set_purchase;
        cargo_capacity: switch_emu_australia_sydney_trains_s_set_capacity_engine;
        visual_effect_and_powered: switch_emu_australia_sydney_trains_s_set_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_australia_sydney_trains_s_set_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(115/10);
        weight: int(47*1/2);
        cargo_capacity: 130;
        length: 8;
        default: switch_emu_australia_sydney_trains_s_set_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(26.732999999999997));
        power: int(1600*1/2);
        weight: int(47*3/4);
        cargo_capacity: 130;
        tractive_effort_coefficient: int(0.239*10*47);
        length: 8;
        default: switch_emu_australia_sydney_trains_s_set_cargo_selection;
    }
}
