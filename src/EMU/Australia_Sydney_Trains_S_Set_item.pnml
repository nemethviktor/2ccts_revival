// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_Australia_Sydney_Trains_S_Set_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 112/2; \
        bitmask(CC_ARMOURED): 112/4; \
        112; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_Australia_Sydney_Trains_S_Set_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 112/2; \
        bitmask(CC_ARMOURED): 112/4; \
        112; \
    }

item(FEAT_TRAINS, item_emu_Australia_Sydney_Trains_S_Set) {
    property {
        name: string(str_emu_Australia_Sydney_Trains_S_Set);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1972,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 41.37034;
        running_cost_factor: 34.13105;
        speed: 115 km/h;
        power: 800 hp;
        cargo_capacity: 112;
        weight: 68 ton;
        tractive_effort_coefficient: 0.31;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -3, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_emu_Australia_Sydney_Trains_S_Set_purchase;
        cargo_capacity: switch_emu_Australia_Sydney_Trains_S_Set_capacity_engine;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_Australia_Sydney_Trains_S_Set_reversed;
    }
    livery_override (item_mu_MU_Wagon_Unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(115/10);
        weight: int(68*1/2);
        cargo_capacity: 112;
        length: 8;
        default: switch_emu_Australia_Sydney_Trains_S_Set_cargo_selection;
    }
    livery_override (item_mu_MU_Wagon_Powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(35.40844048511424));
        power: int(800*1/2);
        weight: int(68*3/4);
        cargo_capacity: 112;
        tractive_effort_coefficient: int(0.31*10*68);
        length: 8;
        default: switch_emu_Australia_Sydney_Trains_S_Set_cargo_selection;
    }
}
