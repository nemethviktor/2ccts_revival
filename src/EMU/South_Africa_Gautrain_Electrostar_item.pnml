// Template: TPL_02A

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_south_africa_gautrain_electrostar_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 52/2; \
        bitmask(CC_ARMOURED): 52/4; \
        52; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_south_africa_gautrain_electrostar_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 52/2; \
        bitmask(CC_ARMOURED): 52/4; \
        52; \
    }

item(FEAT_TRAINS, item_emu_south_africa_gautrain_electrostar) {
    property {
        name: string(str_emu_south_africa_gautrain_electrostar);
        climates_available: ((param_region_africa || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2010,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 32.63825;
        running_cost_factor: 27.92693;
        speed: 160 km/h;
        power: 553 hp;
        cargo_capacity: 52;
        weight: 42 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_25KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

badges: ["power/electric"];

    }
    graphics {
        purchase: spriteset_emu_south_africa_gautrain_electrostar_purchase;
        cargo_capacity: switch_emu_south_africa_gautrain_electrostar_capacity_engine;
        visual_effect_and_powered: switch_emu_south_africa_gautrain_electrostar_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_south_africa_gautrain_electrostar_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(160/10);
        weight: int(42*1/2);
        cargo_capacity: 52;
        length: 8;
        default: switch_emu_south_africa_gautrain_electrostar_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(30.951737179547244));
        power: int(553*1/2);
        weight: int(42*3/4);
        cargo_capacity: 52;
        tractive_effort_coefficient: int(0.3*10*42);
        length: 8;
        default: switch_emu_south_africa_gautrain_electrostar_cargo_selection;
    }
}
