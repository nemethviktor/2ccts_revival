// Template: TPL_02G.
// Data from: nan

// Notes:
//// WEB: NA -- from Dutch Train set


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_netherlands_acme_v200e_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 60/2; \
        bitmask(CC_ARMOURED): 60/4; \
        60; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_netherlands_acme_v200e_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 60/2; \
        bitmask(CC_ARMOURED): 60/4; \
        60; \
    }

item(FEAT_TRAINS, item_emu_netherlands_acme_v200e) {
    property {
        name: string(str_emu_netherlands_acme_v200e);
        climates_available: ((param_region_western_europe || 0) && param_concept) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2045,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 67.67547;
        running_cost_factor: 52.07977;
        speed: 220 km/h;
        power: 2250 hp;
        cargo_capacity: 60;
        weight: 150 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_25KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "flag/NL", "power/electric/ac", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_netherlands_acme_v200e_purchase;
        cargo_capacity: switch_emu_netherlands_acme_v200e_capacity_engine;
        visual_effect_and_powered: switch_emu_netherlands_acme_v200e_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_netherlands_acme_v200e_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(220/10);
        weight: int(150*1/2);
        cargo_capacity: 60;
        length: 8;
        default: switch_emu_netherlands_acme_v200e_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(71.74341713409088));
        power: int(2250*1/2);
        weight: int(150*3/4);
        cargo_capacity: 60;
        tractive_effort_coefficient: int(0.3*10*150);
        length: 8;
        default: switch_emu_netherlands_acme_v200e_cargo_selection;
    }
}
