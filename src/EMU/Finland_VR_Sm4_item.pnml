// Template: TPL_02A.
// Data from: https://sv.wikipedia.org/wiki/Sm4

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_finland_vr_sm4_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 92/2; \
        bitmask(CC_ARMOURED): 92/4; \
        92; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_finland_vr_sm4_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 92/2; \
        bitmask(CC_ARMOURED): 92/4; \
        92; \
    }

item(FEAT_TRAINS, item_emu_finland_vr_sm4) {
    property {
        name: string(str_emu_finland_vr_sm4);
        climates_available: ((param_region_northern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1999,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 51.94846;
        running_cost_factor: 45.73714;
        speed: 160 km/h;
        power: 1636 hp;
        cargo_capacity: 92;
        weight: 57 ton;
        tractive_effort_coefficient: 0.18;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [NARROW_GAUGE_RAILTYPE_25KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["power/electric/ac", "flag/FI"];

    }
    graphics {
        purchase: spriteset_emu_finland_vr_sm4_purchase;
        cargo_capacity: switch_emu_finland_vr_sm4_capacity_engine;
        visual_effect_and_powered: switch_emu_finland_vr_sm4_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_finland_vr_sm4_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(160/10);
        weight: int(57*1/2);
        cargo_capacity: 92;
        length: 8;
        default: switch_emu_finland_vr_sm4_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(30.304749683710845));
        power: int(1636*1/2);
        weight: int(57*3/4);
        cargo_capacity: 92;
        tractive_effort_coefficient: int(0.18*10*57);
        length: 8;
        default: switch_emu_finland_vr_sm4_cargo_selection;
    }
}
