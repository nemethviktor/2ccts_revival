// Template: TPL_02E.
// Data from: https://en.wikipedia.org/wiki/PBKA

// Notes:
//// WEIGHT: 68 -- Not 38t; that's a simplified 380 total/10 cars division, but unlikely
//// TE_STARTING_KN: =210/2 -- Gemini says 210 for the total set but unclear otherwise. "optimized for the 3.5% ramps of the LGV"


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_france_thalys_pbka_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_france_thalys_pbka_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 47/2; \
        bitmask(CC_ARMOURED): 47/4; \
        47; \
    }

item(FEAT_TRAINS, item_emu_france_thalys_pbka) {
    property {
        name: string(str_emu_france_thalys_pbka);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1995,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 116.9077;
        running_cost_factor: 109.41398;
        speed: 300 km/h;
        power: 11800 hp;
        cargo_capacity: 0;
        weight: 68 ton;
        tractive_effort_coefficient: 0.157;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_OHLE];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "flag/FR", "power/electric"];

    }
    graphics {
        purchase: spriteset_emu_france_thalys_pbka_purchase;
        cargo_capacity: switch_emu_france_thalys_pbka_capacity_engine;
        visual_effect_and_powered: switch_emu_france_thalys_pbka_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_france_thalys_pbka_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(300/10);
        weight: int(68*1/2);
        cargo_capacity: 47;
        length: 6;
        default: switch_emu_france_thalys_pbka_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(51.58435484285022));
        power: int(11800*1/2);
        weight: int(68*3/4);
        cargo_capacity: 47;
        tractive_effort_coefficient: int(0.157*10*68);
        length: 6;
        default: switch_emu_france_thalys_pbka_cargo_selection;
    }
}
