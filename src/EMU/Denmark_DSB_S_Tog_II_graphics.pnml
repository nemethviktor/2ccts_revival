// Template: TPL_02D

// PURCHASE
spriteset(spriteset_emu_denmark_dsb_s_tog_ii_purchase, "gfx/emu/denmark_dsb_s_tog_ii.png") {template_purchase_dualheaded(1, 128)}


// VEHICLE
/// Front
spriteset(spriteset_emu_denmark_dsb_s_tog_ii_front, "gfx/emu/denmark_dsb_s_tog_ii.png") {template_2cc_engines_general(1, 1)}


// VEHICLE
/// Back
spriteset(spriteset_emu_denmark_dsb_s_tog_ii_back, "gfx/emu/denmark_dsb_s_tog_ii.png") {template_2cc_engines_general(1, 32)}


/// MIDDLEPASS L1
spriteset(spriteset_emu_denmark_dsb_s_tog_ii_middlepass_l1, "gfx/emu/denmark_dsb_s_tog_ii.png") {template_2cc_engines_general(1, 64)}


/// MIDDLEMAIL L1
spriteset(spriteset_emu_denmark_dsb_s_tog_ii_middlemail_l1, "gfx/emu/denmark_dsb_s_tog_ii.png") {template_2cc_engines_general(1, 96)}


/// MIDDLEPASS L2
spriteset(spriteset_emu_denmark_dsb_s_tog_ii_middlepass_l2, "gfx/emu/denmark_dsb_s_tog_ii.png") {template_2cc_engines_general(178, 64)}


/// MIDDLEMAIL L2
spriteset(spriteset_emu_denmark_dsb_s_tog_ii_middlemail_l2, "gfx/emu/denmark_dsb_s_tog_ii.png") {template_2cc_engines_general(178, 96)}


/// Dualheaded (reverse switch)
/// In the context of var[0xC8] (which is the variable for "position in consist"):
/// 0xFE: The very first vehicle in the train (The Engine/Front).
/// 0xFF: The very last vehicle in the train (The Caboose/End).
switch(FEAT_TRAINS, SELF, switch_emu_denmark_dsb_s_tog_ii_reversed, var[0xC8]) {
    0xFE: spriteset_emu_denmark_dsb_s_tog_ii_back;
    0xFF: spriteset_emu_denmark_dsb_s_tog_ii_back;
    spriteset_emu_denmark_dsb_s_tog_ii_front;
}

/// Visual effect, for EMU this is done on the part with the pantograph
random_switch(FEAT_TRAINS, SELF, switch_emu_denmark_dsb_s_tog_ii_visual_effect_and_powered) {
	9: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
	1: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -3, DISABLE_WAGON_POWER);
}

switch(FEAT_TRAINS, SELF, switch_emu_denmark_dsb_s_tog_ii_visual_effect_and_powered_position, [STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
	ID_RANGE_UNIT_WAGONS: switch_emu_denmark_dsb_s_tog_ii_visual_effect_and_powered;
	visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -3, DISABLE_WAGON_POWER);
}

/// Visual effect random switch (middlepass_livery)
random_switch(FEAT_TRAINS, SELF, switch_emu_denmark_dsb_s_tog_ii_middlepass_livery) {
    dependent: switch_emu_denmark_dsb_s_tog_ii_visual_effect_and_powered;
    9: spriteset_emu_denmark_dsb_s_tog_ii_middlepass_l1;
    1: spriteset_emu_denmark_dsb_s_tog_ii_middlepass_l2;
}

/// Visual effect random switch (middlemail_livery)
random_switch(FEAT_TRAINS, SELF, switch_emu_denmark_dsb_s_tog_ii_middlemail_livery) {
    dependent: switch_emu_denmark_dsb_s_tog_ii_visual_effect_and_powered;
    9: spriteset_emu_denmark_dsb_s_tog_ii_middlemail_l1;
    1: spriteset_emu_denmark_dsb_s_tog_ii_middlemail_l2;
}

switch(FEAT_TRAINS, SELF, switch_emu_denmark_dsb_s_tog_ii_middlepass_position, [STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
	ID_RANGE_UNIT_WAGONS: switch_emu_denmark_dsb_s_tog_ii_middlepass_livery;
	spriteset_emu_denmark_dsb_s_tog_ii_middlepass_l2;
}

switch(FEAT_TRAINS, SELF, switch_emu_denmark_dsb_s_tog_ii_middlemail_position, [STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
	ID_RANGE_UNIT_WAGONS: switch_emu_denmark_dsb_s_tog_ii_middlemail_livery;
	spriteset_emu_denmark_dsb_s_tog_ii_middlemail_l2;
}

/// Graphics for the unit wagon based on cargo class
switch(FEAT_TRAINS, SELF, switch_emu_denmark_dsb_s_tog_ii_cargo_selection, cargo_classes){
	bitmask(CC_PASSENGERS): switch_emu_denmark_dsb_s_tog_ii_middlepass_position;
	switch_emu_denmark_dsb_s_tog_ii_middlemail_position;
}