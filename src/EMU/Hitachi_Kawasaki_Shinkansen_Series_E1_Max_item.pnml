// Template: TPL_02D.
// Data from: http://en.wikipedia.org/wiki/E1_Series_Shinkansen

// Notes:
//// TE_STARTING_KN: 80 -- 80kN each


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_hitachi_kawasaki_shinkansen_series_e1_max_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 80/2; \
        bitmask(CC_ARMOURED): 80/4; \
        80; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_hitachi_kawasaki_shinkansen_series_e1_max_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 103/2; \
        bitmask(CC_ARMOURED): 103/4; \
        103; \
    }

item(FEAT_TRAINS, item_emu_hitachi_kawasaki_shinkansen_series_e1_max) {
    property {
        name: string(str_emu_hitachi_kawasaki_shinkansen_series_e1_max);
        climates_available: ((param_region_asia || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1994,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 64.35478;
        running_cost_factor: 57.81324;
        speed: 240 km/h;
        power: 2790 hp;
        cargo_capacity: 80;
        weight: 59 ton;
        tractive_effort_coefficient: 0.138;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_25KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "power/electric/ac", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_hitachi_kawasaki_shinkansen_series_e1_max_purchase;
        cargo_capacity: switch_emu_hitachi_kawasaki_shinkansen_series_e1_max_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_hitachi_kawasaki_shinkansen_series_e1_max_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(240/10);
        weight: int(59*1/2);
        cargo_capacity: 103;
        length: 8;
        default: switch_emu_hitachi_kawasaki_shinkansen_series_e1_max_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(37.451650469652236));
        power: int(2790*1/2);
        weight: int(59*3/4);
        cargo_capacity: 103;
        tractive_effort_coefficient: int(0.138*10*59);
        length: 8;
        default: switch_emu_hitachi_kawasaki_shinkansen_series_e1_max_cargo_selection;
    }
}
