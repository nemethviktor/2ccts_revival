// Template: TPL_02D

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_china_railways_chr380a_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 70/2; \
        bitmask(CC_ARMOURED): 70/4; \
        70; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_china_railways_chr380a_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 70/2; \
        bitmask(CC_ARMOURED): 70/4; \
        70; \
    }

item(FEAT_TRAINS, item_emu_china_railways_chr380a) {
    property {
        name: string(str_emu_china_railways_chr380a);
        climates_available: ((param_region_asia || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2010,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 90.70763;
        running_cost_factor: 85.12753;
        speed: 380 km/h;
        power: 6450 hp;
        cargo_capacity: 70;
        weight: 48 ton;
        tractive_effort_coefficient: 0.14;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_25KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

badges: ["power/electric", "flag/CN"];

    }
    graphics {
        purchase: spriteset_emu_china_railways_chr380a_purchase;
        cargo_capacity: switch_emu_china_railways_chr380a_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_china_railways_chr380a_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(380/10);
        weight: int(48*1/2);
        visual_effect_and_powered: switch_emu_china_railways_chr380a_visual_effect_and_powered_position;
        cargo_capacity: 70;
        length: 8;
        default: switch_emu_china_railways_chr380a_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(52.75389552884909));
        power: int(6450*1/2);
        weight: int(48*3/4);
        visual_effect_and_powered: switch_emu_china_railways_chr380a_visual_effect_and_powered_position;
        cargo_capacity: 70;
        tractive_effort_coefficient: int(0.14*10*48);
        length: 8;
        default: switch_emu_china_railways_chr380a_cargo_selection;
    }
}
