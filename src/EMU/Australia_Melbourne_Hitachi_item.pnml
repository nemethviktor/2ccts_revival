// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/Hitachi_(Australian_train)

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_australia_melbourne_hitachi_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 160/2; \
        bitmask(CC_ARMOURED): 160/4; \
        160; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_australia_melbourne_hitachi_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 160/2; \
        bitmask(CC_ARMOURED): 160/4; \
        160; \
    }

item(FEAT_TRAINS, item_emu_australia_melbourne_hitachi) {
    property {
        name: string(str_emu_australia_melbourne_hitachi);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1973,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 60.23254;
        running_cost_factor: 55.79155;
        speed: 116 km/h;
        power: 2400 hp;
        cargo_capacity: 160;
        weight: 40 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [BROAD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "flag/AU", "power/electric/dc", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_australia_melbourne_hitachi_purchase;
        cargo_capacity: switch_emu_australia_melbourne_hitachi_capacity_engine;
        visual_effect_and_powered: switch_emu_australia_melbourne_hitachi_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_australia_melbourne_hitachi_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(116/10);
        weight: int(40*1/2);
        cargo_capacity: 160;
        length: 8;
        default: switch_emu_australia_melbourne_hitachi_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(28.498980777504027));
        power: int(2400*1/2);
        weight: int(40*3/4);
        cargo_capacity: 160;
        tractive_effort_coefficient: int(0.3*10*40);
        length: 8;
        default: switch_emu_australia_melbourne_hitachi_cargo_selection;
    }
}
