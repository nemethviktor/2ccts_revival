// Template: TPL_02A

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_norway_nsb_bm65_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 50/2; \
        bitmask(CC_ARMOURED): 50/4; \
        50; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_norway_nsb_bm65_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 50/2; \
        bitmask(CC_ARMOURED): 50/4; \
        50; \
    }

item(FEAT_TRAINS, item_emu_norway_nsb_bm65) {
    property {
        name: string(str_emu_norway_nsb_bm65);
        climates_available: ((param_region_northern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1942,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 33.54208;
        running_cost_factor: 29.3858;
        speed: 70 km/h;
        power: 632 hp;
        cargo_capacity: 50;
        weight: 38 ton;
        tractive_effort_coefficient: 0.23;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_15KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_emu_norway_nsb_bm65_purchase;
        cargo_capacity: switch_emu_norway_nsb_bm65_capacity_engine;
        visual_effect_and_powered: switch_emu_norway_nsb_bm65_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_norway_nsb_bm65_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(70/10);
        weight: int(38*1/2);
        cargo_capacity: 50;
        length: 7;
        default: switch_emu_norway_nsb_bm65_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(18.25402557880777));
        power: int(632*1/2);
        weight: int(38*3/4);
        cargo_capacity: 50;
        tractive_effort_coefficient: int(0.23*10*38);
        length: 7;
        default: switch_emu_norway_nsb_bm65_cargo_selection;
    }
}
