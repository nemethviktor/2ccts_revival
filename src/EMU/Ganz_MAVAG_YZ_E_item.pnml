// Template: TPL_02D.
// Data from: https://hu.wikipedia.org/wiki/H%C5%BD_6111_sorozat

// Notes:
//// ENGLISH: Ganz-MAVAG YZ-E -- //www.railfaneurope.net/list/tunisia_sncft.html
//// TE_STARTING_KN: 125 -- 125 ea


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_ganz_mavag_yz_e_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 150/2; \
        bitmask(CC_ARMOURED): 150/4; \
        150; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_ganz_mavag_yz_e_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 150/2; \
        bitmask(CC_ARMOURED): 150/4; \
        150; \
    }

item(FEAT_TRAINS, item_emu_ganz_mavag_yz_e) {
    property {
        name: string(str_emu_ganz_mavag_yz_e);
        climates_available: ((param_region_africa || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1984,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 51.88112;
        running_cost_factor: 46.60961;
        speed: 120 km/h;
        power: 1609 hp;
        cargo_capacity: 150;
        weight: 48 ton;
        tractive_effort_coefficient: 0.264;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [NARROW_GAUGE_RAILTYPE_25KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/africa", "power/electric/ac", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_ganz_mavag_yz_e_purchase;
        cargo_capacity: switch_emu_ganz_mavag_yz_e_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_ganz_mavag_yz_e_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(120/10);
        weight: int(48*1/2);
        cargo_capacity: 150;
        length: 8;
        default: switch_emu_ganz_mavag_yz_e_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(28.77123422402632);
        power: int(1609*1/2);
        weight: int(48*3/4);
        cargo_capacity: 150;
        tractive_effort_coefficient: int(0.264*10*48);
        length: 8;
        default: switch_emu_ganz_mavag_yz_e_cargo_selection;
    }
}
