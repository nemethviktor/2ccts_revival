// Template: TPL_02D.
// Data from: https://ja.wikipedia.org/wiki/%E5%B0%8F%E7%94%B0%E6%80%A510000%E5%BD%A2%E9%9B%BB%E8%BB%8A

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_japan_odakyu_10000_series_romance_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 46/2; \
        bitmask(CC_ARMOURED): 46/4; \
        46; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_japan_odakyu_10000_series_romance_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 44/2; \
        bitmask(CC_ARMOURED): 44/4; \
        44; \
    }

item(FEAT_TRAINS, item_emu_japan_odakyu_10000_series_romance) {
    property {
        name: string(str_emu_japan_odakyu_10000_series_romance);
        climates_available: ((param_region_asia || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1986,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 47.12328;
        running_cost_factor: 43.42259;
        speed: 110 km/h;
        power: 1550 hp;
        cargo_capacity: 46;
        weight: 32 ton;
        tractive_effort_coefficient: 0.131;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [NARROW_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "flag/JP", "power/electric/dc", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_japan_odakyu_10000_series_romance_purchase;
        cargo_capacity: switch_emu_japan_odakyu_10000_series_romance_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_japan_odakyu_10000_series_romance_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(110/10);
        weight: int(32*1/2);
        cargo_capacity: 44;
        length: 8;
        default: switch_emu_japan_odakyu_10000_series_romance_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(19.220703937702144));
        power: int(1550*1/2);
        weight: int(32*3/4);
        cargo_capacity: 44;
        tractive_effort_coefficient: int(0.131*10*32);
        length: 8;
        default: switch_emu_japan_odakyu_10000_series_romance_cargo_selection;
    }
}
