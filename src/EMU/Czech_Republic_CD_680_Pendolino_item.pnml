// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/%C4%8CD_Class_680

// Notes:
//// TE_STARTING_KN: 50 -- 50 per head unit


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_czech_republic_cd_680_pendolino_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 47/2; \
        bitmask(CC_ARMOURED): 47/4; \
        47; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_czech_republic_cd_680_pendolino_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 47/2; \
        bitmask(CC_ARMOURED): 47/4; \
        47; \
    }

item(FEAT_TRAINS, item_emu_czech_republic_cd_680_pendolino) {
    property {
        name: string(str_emu_czech_republic_cd_680_pendolino);
        climates_available: ((param_region_eastern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1999,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 46.45057;
        running_cost_factor: 40.38177;
        speed: 200 km/h;
        power: 1318 hp;
        cargo_capacity: 47;
        weight: 55 ton;
        tractive_effort_coefficient: 0.093;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU, TRAIN_FLAG_TILT);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_OHLE];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/eastern", "flag/CZ", "power/electric", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_czech_republic_cd_680_pendolino_purchase;
        cargo_capacity: switch_emu_czech_republic_cd_680_pendolino_capacity_engine;
        visual_effect_and_powered: switch_emu_czech_republic_cd_680_pendolino_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_czech_republic_cd_680_pendolino_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(200/10);
        weight: int(55*1/2);
        cargo_capacity: 47;
        length: 8;
        default: switch_emu_czech_republic_cd_680_pendolino_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(28.74542705528075));
        power: int(1318*1/2);
        weight: int(55*3/4);
        cargo_capacity: 47;
        tractive_effort_coefficient: int(0.093*10*55);
        length: 8;
        default: switch_emu_czech_republic_cd_680_pendolino_cargo_selection;
    }
}
