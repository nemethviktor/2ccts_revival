// Template: TPL_02D.
// Data from: https://en.wikipedia.org/wiki/100_Series_Shinkansen

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_hitachi_kawasaki_shinkansen_series_100_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 75/2; \
        bitmask(CC_ARMOURED): 75/4; \
        75; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_hitachi_kawasaki_shinkansen_series_100_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 100/2; \
        bitmask(CC_ARMOURED): 100/4; \
        100; \
    }

item(FEAT_TRAINS, item_emu_hitachi_kawasaki_shinkansen_series_100) {
    property {
        name: string(str_emu_hitachi_kawasaki_shinkansen_series_100);
        climates_available: ((param_region_asia || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1985,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 59.43994;
        running_cost_factor: 53.56028;
        speed: 210 km/h;
        power: 2380 hp;
        cargo_capacity: 75;
        weight: 53 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_25KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "power/electric/ac", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_hitachi_kawasaki_shinkansen_series_100_purchase;
        cargo_capacity: switch_emu_hitachi_kawasaki_shinkansen_series_100_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_hitachi_kawasaki_shinkansen_series_100_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(210/10);
        weight: int(53*1/2);
        cargo_capacity: 100;
        length: 8;
        default: switch_emu_hitachi_kawasaki_shinkansen_series_100_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: round(41.778524367060186);
        power: int(2380*1/2);
        weight: int(53*3/4);
        cargo_capacity: 100;
        tractive_effort_coefficient: int(0.3*10*53);
        length: 8;
        default: switch_emu_hitachi_kawasaki_shinkansen_series_100_cargo_selection;
    }
}
