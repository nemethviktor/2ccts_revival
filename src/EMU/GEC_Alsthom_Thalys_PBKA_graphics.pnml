switch(FEAT_TRAINS, SELF, switch_emu_gec_alsthom_thalys_pbka_middlepass_position_back, [STORE_TEMP(1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
	ID_RANGE_UNIT_WAGONS_RAIL: spriteset_emu_gec_alsthom_thalys_pbka_middlepass_part_2_regular;
	spriteset_emu_gec_alsthom_thalys_pbka_middlepass_part_2_back;
}

switch(FEAT_TRAINS, SELF, switch_emu_gec_alsthom_thalys_pbka_middlepass_position_front, [STORE_TEMP(1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
	ID_RANGE_UNIT_WAGONS_RAIL: spriteset_emu_gec_alsthom_thalys_pbka_middlepass_part_2_front;
	spriteset_emu_gec_alsthom_thalys_pbka_middlepass_double;
}

switch(FEAT_TRAINS, SELF, switch_emu_gec_alsthom_thalys_pbka_middlepass_length, [STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
	ID_RANGE_UNIT_WAGONS_RAIL: switch_emu_gec_alsthom_thalys_pbka_middlepass_position_back;
	switch_emu_gec_alsthom_thalys_pbka_middlepass_position_front;
}

switch(FEAT_TRAINS, SELF, switch_emu_gec_alsthom_thalys_pbka_middlemail_position_back, [STORE_TEMP(1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
	ID_RANGE_UNIT_WAGONS_RAIL: spriteset_emu_gec_alsthom_thalys_pbka_middlemail_part_2_regular;
	spriteset_emu_gec_alsthom_thalys_pbka_middlemail_part_2_back;
}

switch(FEAT_TRAINS, SELF, switch_emu_gec_alsthom_thalys_pbka_middlemail_position_front, [STORE_TEMP(1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
	ID_RANGE_UNIT_WAGONS_RAIL: spriteset_emu_gec_alsthom_thalys_pbka_middlemail_part_2_front;
	spriteset_emu_gec_alsthom_thalys_pbka_middlemail_double;
}

switch(FEAT_TRAINS, SELF, switch_emu_gec_alsthom_thalys_pbka_middlemail_length, [STORE_TEMP(-1, 0x10F), var[0x61, 0, 0x0000FFFF, 0xC6]]) {
	ID_RANGE_UNIT_WAGONS_RAIL: switch_emu_gec_alsthom_thalys_pbka_middlemail_position_back;
	switch_emu_gec_alsthom_thalys_pbka_middlemail_position_front;
}

/// Dualheaded (reverse switch)
/// In the context of var[0xC8] (which is the variable for "position in consist"):
/// 0xFE: The very first vehicle in the train (The Engine/Front).
/// 0xFF: The very last vehicle in the train (The Caboose/End).
switch(FEAT_TRAINS, SELF, switch_emu_gec_alsthom_thalys_pbka_reversed, var[0xC8]) {
    0xFE: spriteset_emu_gec_alsthom_thalys_pbka_back;
    0xFF: spriteset_emu_gec_alsthom_thalys_pbka_back;
    spriteset_emu_gec_alsthom_thalys_pbka_front;
}

// Visual effect and power management
// Position-based logic: middle
/// In the context of var[0xC8] (which is the variable for "position in consist"):
/// 0xFE: The very first vehicle in the train (The Engine/Front).
/// 0xFF: The very last vehicle in the train (The Caboose/End).
switch(FEAT_TRAINS, SELF, switch_emu_gec_alsthom_thalys_pbka_visual_effect_and_powered, var[0xC8]) {
    0xFE: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
    0xFF: visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
    visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -3, DISABLE_WAGON_POWER);
}

/// Graphics for the unit wagon based on cargo class
switch(FEAT_TRAINS, SELF, switch_emu_gec_alsthom_thalys_pbka_cargo_selection, cargo_classes){
	bitmask(CC_PASSENGERS): switch_emu_gec_alsthom_thalys_pbka_middlepass_length;
	switch_emu_gec_alsthom_thalys_pbka_middlemail_length;
}