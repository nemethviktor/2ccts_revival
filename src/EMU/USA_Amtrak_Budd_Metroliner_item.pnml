// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/Budd_Metroliner

// Notes:
//// HEAD_CAPACITY: 76 -- coaches had 76 seats
//// WEIGHT: 75 -- 75t each
//// TE_STARTING_KN: =200/2 -- Gemini
//// WAGON_CAPACITY: 76 -- coaches had 76 seats


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_usa_amtrak_budd_metroliner_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 76/2; \
        bitmask(CC_ARMOURED): 76/4; \
        76; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_usa_amtrak_budd_metroliner_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 76/2; \
        bitmask(CC_ARMOURED): 76/4; \
        76; \
    }

item(FEAT_TRAINS, item_emu_usa_amtrak_budd_metroliner) {
    property {
        name: string(str_emu_usa_amtrak_budd_metroliner);
        climates_available: ((param_region_north_america || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1969,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 61.9217;
        running_cost_factor: 53.86678;
        speed: 190 km/h;
        power: 2400 hp;
        cargo_capacity: 76;
        weight: 75 ton;
        tractive_effort_coefficient: 0.136;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_15KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/america/northern", "flag/US", "power/electric/ac", "role/express_passenger"];

    }
    graphics {
        purchase: spriteset_emu_usa_amtrak_budd_metroliner_purchase;
        cargo_capacity: switch_emu_usa_amtrak_budd_metroliner_capacity_engine;
        visual_effect_and_powered: switch_emu_usa_amtrak_budd_metroliner_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_usa_amtrak_budd_metroliner_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(190/10);
        weight: int(75*1/2);
        cargo_capacity: 76;
        length: 8;
        default: switch_emu_usa_amtrak_budd_metroliner_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(34.09898077750403));
        power: int(2400*1/2);
        weight: int(75*3/4);
        cargo_capacity: 76;
        tractive_effort_coefficient: int(0.136*10*75);
        length: 8;
        default: switch_emu_usa_amtrak_budd_metroliner_cargo_selection;
    }
}
