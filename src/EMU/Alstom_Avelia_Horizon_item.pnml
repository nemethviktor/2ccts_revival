// Template: TPL_02E.
// Data from: https://en.wikipedia.org/wiki/Avelia_Horizon

// Notes:
//// POWER: =INT(9000*1.38/8)*2 -- All units are powered but heads only account for this much - this data is from wikipedia but Gemini disagrees. I picked wiki.
//// TE_STARTING_KN: 200 -- DE wiki say 225 total but that's cont.; so this is gemini for starting (game doubles it.)


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_alstom_avelia_horizon_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 80/2; \
        bitmask(CC_ARMOURED): 80/4; \
        80; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_alstom_avelia_horizon_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 100/2; \
        bitmask(CC_ARMOURED): 100/4; \
        100; \
    }

item(FEAT_TRAINS, item_emu_alstom_avelia_horizon) {
    property {
        name: string(str_emu_alstom_avelia_horizon);
        climates_available: ((param_region_southern_europe || param_region_africa) && param_concept) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2015,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 65.99737;
        running_cost_factor: 60.83843;
        speed: 360 km/h;
        power: 3104 hp;
        cargo_capacity: 80;
        weight: 44 ton;
        tractive_effort_coefficient: 0.463;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_OHLE];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/africa", "region/europe/southern", "power/electric", "role/ultra_high_speed__pax_"];

    }
    graphics {
        purchase: spriteset_emu_alstom_avelia_horizon_purchase;
        cargo_capacity: switch_emu_alstom_avelia_horizon_capacity_engine;
        visual_effect_and_powered: switch_emu_alstom_avelia_horizon_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_alstom_avelia_horizon_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(360/10);
        weight: int(44*1/2);
        cargo_capacity: 100;
        length: 7;
        default: switch_emu_alstom_avelia_horizon_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: round(61.94335531087365);
        power: int(3104*1/2);
        weight: int(44*3/4);
        cargo_capacity: 100;
        tractive_effort_coefficient: int(0.463*10*44);
        length: 7;
        default: switch_emu_alstom_avelia_horizon_cargo_selection;
    }
}
