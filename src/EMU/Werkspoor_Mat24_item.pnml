// Template: TPL_02A.
// Data from: https://nl.wikipedia.org/wiki/Mat_%2724

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_werkspoor_mat24_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 44/2; \
        bitmask(CC_ARMOURED): 44/4; \
        44; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_werkspoor_mat24_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 88/2; \
        bitmask(CC_ARMOURED): 88/4; \
        88; \
    }

item(FEAT_TRAINS, item_emu_werkspoor_mat24) {
    property {
        name: string(str_emu_werkspoor_mat24);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1924,1,1);
        model_life: 45;
        vehicle_life: 35;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 39.22695;
        running_cost_factor: 33.32695;
        speed: 100 km/h;
        power: 888 hp;
        cargo_capacity: 44;
        weight: 55 ton;
        tractive_effort_coefficient: 0.111;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "power/electric/dc", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_werkspoor_mat24_purchase;
        cargo_capacity: switch_emu_werkspoor_mat24_capacity_engine;
        visual_effect_and_powered: switch_emu_werkspoor_mat24_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_emu_werkspoor_mat24_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(100/10);
        weight: int(55*1/2);
        cargo_capacity: 88;
        length: 8;
        default: switch_emu_werkspoor_mat24_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: round(19.084932885150266);
        power: int(888*1/2);
        weight: int(55*3/4);
        cargo_capacity: 88;
        tractive_effort_coefficient: int(0.111*10*55);
        length: 8;
        default: switch_emu_werkspoor_mat24_cargo_selection;
    }
}
