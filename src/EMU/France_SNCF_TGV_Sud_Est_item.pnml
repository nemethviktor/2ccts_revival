// Template: TPL_02E

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_france_sncf_tgv_sud_est_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 0/2; \
        bitmask(CC_ARMOURED): 0/4; \
        0; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_france_sncf_tgv_sud_est_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 43/2; \
        bitmask(CC_ARMOURED): 43/4; \
        43; \
    }

item(FEAT_TRAINS, item_emu_france_sncf_tgv_sud_est) {
    property {
        name: string(str_emu_france_sncf_tgv_sud_est);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1981,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 100.51124;
        running_cost_factor: 96.0897;
        speed: 240 km/h;
        power: 9000 hp;
        cargo_capacity: 0;
        weight: 38 ton;
        tractive_effort_coefficient: 0.92;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_OHLE];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;
    }
    graphics {
        purchase: spriteset_emu_france_sncf_tgv_sud_est_purchase;
        cargo_capacity: switch_emu_france_sncf_tgv_sud_est_capacity_engine;
        visual_effect_and_powered: switch_emu_france_sncf_tgv_sud_est_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_france_sncf_tgv_sud_est_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(240/10);
        weight: int(38*1/2);
        cargo_capacity: 43;
        length: 6;
        default: switch_emu_france_sncf_tgv_sud_est_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(68.46143108007837));
        power: int(9000*1/2);
        weight: int(38*3/4);
        cargo_capacity: 43;
        tractive_effort_coefficient: int(0.92*10*38);
        length: 6;
        default: switch_emu_france_sncf_tgv_sud_est_cargo_selection;
    }
}
