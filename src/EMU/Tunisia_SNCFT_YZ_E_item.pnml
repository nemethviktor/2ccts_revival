// Template: TPL_02D.
// Data from: nan

// Notes:
//// WEB: NA -- Can't find much on this
//// TE_STARTING_KN: 125 -- 125 ea


// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_tunisia_sncft_yz_e_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 150/2; \
        bitmask(CC_ARMOURED): 150/4; \
        150; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_tunisia_sncft_yz_e_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 150/2; \
        bitmask(CC_ARMOURED): 150/4; \
        150; \
    }

item(FEAT_TRAINS, item_emu_tunisia_sncft_yz_e) {
    property {
        name: string(str_emu_tunisia_sncft_yz_e);
        climates_available: ((param_region_africa || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1984,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 56.84852;
        running_cost_factor: 51.40077;
        speed: 120 km/h;
        power: 2010 hp;
        cargo_capacity: 150;
        weight: 50 ton;
        tractive_effort_coefficient: 0.255;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [NARROW_GAUGE_RAILTYPE_25KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/africa", "flag/TN", "power/electric/ac", "role/commuter___urban"];

    }
    graphics {
        purchase: spriteset_emu_tunisia_sncft_yz_e_purchase;
        cargo_capacity: switch_emu_tunisia_sncft_yz_e_capacity_engine;
        // no 'visual_effect_and_powered' becuase while it does exist, _visual_effect_and_powered_position is set for livery overrides
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_tunisia_sncft_yz_e_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(120/10);
        weight: int(50*1/2);
        visual_effect_and_powered: switch_emu_tunisia_sncft_yz_e_visual_effect_and_powered_position;
        cargo_capacity: 150;
        length: 8;
        default: switch_emu_tunisia_sncft_yz_e_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(29.23330250161105));
        power: int(2010*1/2);
        weight: int(50*3/4);
        visual_effect_and_powered: switch_emu_tunisia_sncft_yz_e_visual_effect_and_powered_position;
        cargo_capacity: 150;
        tractive_effort_coefficient: int(0.255*10*50);
        length: 8;
        default: switch_emu_tunisia_sncft_yz_e_cargo_selection;
    }
}
