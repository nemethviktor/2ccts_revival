// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/FS_Class_ETR_200

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_italy_fs_etr200_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 52/2; \
        bitmask(CC_ARMOURED): 52/4; \
        52; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_italy_fs_etr200_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 52/2; \
        bitmask(CC_ARMOURED): 52/4; \
        52; \
    }

item(FEAT_TRAINS, item_emu_italy_fs_etr200) {
    property {
        name: string(str_emu_italy_fs_etr200);
        climates_available: ((param_region_southern_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1937,1,1);
        model_life: 45;
        vehicle_life: 25;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 39.20604;
        running_cost_factor: 34.80138;
        speed: 160 km/h;
        power: 938 hp;
        cargo_capacity: 52;
        weight: 38 ton;
        tractive_effort_coefficient: 0.065;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [STANDARD_GAUGE_RAILTYPE_3KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["power/electric/dc", "flag/IT"];

    }
    graphics {
        purchase: spriteset_emu_italy_fs_etr200_purchase;
        cargo_capacity: switch_emu_italy_fs_etr200_capacity_engine;
        visual_effect_and_powered: switch_emu_italy_fs_etr200_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_italy_fs_etr200_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(160/10);
        weight: int(38*1/2);
        cargo_capacity: 52;
        length: 8;
        default: switch_emu_italy_fs_etr200_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(21.59334916176435));
        power: int(938*1/2);
        weight: int(38*3/4);
        cargo_capacity: 52;
        tractive_effort_coefficient: int(0.065*10*38);
        length: 8;
        default: switch_emu_italy_fs_etr200_cargo_selection;
    }
}
