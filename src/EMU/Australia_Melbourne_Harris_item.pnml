// Template: TPL_02A.
// Data from: https://en.wikipedia.org/wiki/Harris_(train)

// Cargo capacity

    switch(FEAT_TRAINS, SELF, switch_emu_australia_melbourne_harris_capacity_engine, cargo_classes) { \
        bitmask(CC_MAIL): 101/2; \
        bitmask(CC_ARMOURED): 101/4; \
        101; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_australia_melbourne_harris_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 100/2; \
        bitmask(CC_ARMOURED): 100/4; \
        100; \
    }

item(FEAT_TRAINS, item_emu_australia_melbourne_harris) {
    property {
        name: string(str_emu_australia_melbourne_harris);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1956,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        cost_factor: 39.05606;
        running_cost_factor: 34.02019;
        speed: 113 km/h;
        power: 808 hp;
        cargo_capacity: 101;
        weight: 46 ton;
        tractive_effort_coefficient: 0.3;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS_ONLY;
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        non_refittable_cargo_classes: 0;
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [BROAD_GAUGE_RAILTYPE_1500V];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "flag/AU", "power/electric/dc", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_australia_melbourne_harris_purchase;
        cargo_capacity: switch_emu_australia_melbourne_harris_capacity_engine;
        visual_effect_and_powered: switch_emu_australia_melbourne_harris_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_australia_melbourne_harris_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: int(113/10);
        weight: int(46*1/2);
        cargo_capacity: 100;
        length: 8;
        default: switch_emu_australia_melbourne_harris_cargo_selection;
    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 16/2 : (param_loadingspeed == 2) ? 16*2 : 16;
        running_cost_factor: (round(27.942546511903082));
        power: int(808*1/2);
        weight: int(46*3/4);
        cargo_capacity: 100;
        tractive_effort_coefficient: int(0.3*10*46);
        length: 8;
        default: switch_emu_australia_melbourne_harris_cargo_selection;
    }
}
