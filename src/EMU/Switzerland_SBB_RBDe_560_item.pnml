    }
    livery_override (item_mu_mu_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: (round(27.97606423203981));
        power: int(2210*1/2);
        weight: int(35*3/4);
        cargo_capacity: 56;
        tractive_effort_coefficient: int(0.265*10*35);
        length: 8;
        default: switch_emu_switzerland_sbb_rbde_560_cargo_selection;
