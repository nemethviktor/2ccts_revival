        bitmask(CC_MAIL): 56/2; \
        bitmask(CC_ARMOURED): 56/4; \
        56; \
    }


    switch(FEAT_TRAINS, SELF, switch_emu_switzerland_sbb_rbde_560_capacity_wagon, cargo_classes) { \
        bitmask(CC_MAIL): 56/2; \
        bitmask(CC_ARMOURED): 56/4; \
        56; \
    }

item(FEAT_TRAINS, item_emu_switzerland_sbb_rbde_560) {
    property {
        name: string(str_emu_switzerland_sbb_rbde_560);
        climates_available: ((param_region_western_europe || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1984,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 55.46651;
        running_cost_factor: 51.48611;
        speed: 140 km/h;
        power: 2210 hp;
        cargo_capacity: 56;
        weight: 35 ton;
        tractive_effort_coefficient: 0.265;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: PASSENGERS;
        refittable_cargo_classes: bitmask(CC_PASSENGERS, CC_MAIL, CC_ARMOURED);
        non_refittable_cargo_classes: 0;
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_15KV];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/europe/western", "flag/CH", "power/electric/ac", "role/commuter_urban"];

    }
    graphics {
        purchase: spriteset_emu_switzerland_sbb_rbde_560_purchase;
        cargo_capacity: switch_emu_switzerland_sbb_rbde_560_capacity_engine;
        visual_effect_and_powered: switch_emu_switzerland_sbb_rbde_560_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_emu_switzerland_sbb_rbde_560_reversed;
    }
    livery_override (item_mu_mu_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        running_cost_factor: int(140/10);
        weight: int(35*1/2);
        cargo_capacity: 56;
        length: 8;
