// Template: TPL_03A

// PURCHASE
spriteset(spriteset_steam_h__k__porter__inc_2_6_0_7100_purchase, "gfx/steam/h__k__porter__inc_2_6_0_7100.png") {template_purchase(1, 96)}


// VEHICLE
/// Engine1
spriteset(spriteset_steam_h__k__porter__inc_2_6_0_7100_engine1, "gfx/steam/h__k__porter__inc_2_6_0_7100.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_steam_h__k__porter__inc_2_6_0_7100_engine2, "gfx/steam/h__k__porter__inc_2_6_0_7100.png") {template_2cc_engines_general(1, 32)}


/// Tender
spriteset(spriteset_steam_h__k__porter__inc_2_6_0_7100_tender, "gfx/steam/h__k__porter__inc_2_6_0_7100.png") {template_2cc_engines_general(1, 64)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_steam_h__k__porter__inc_2_6_0_7100_animation, motion_counter % 2){
	0: spriteset_steam_h__k__porter__inc_2_6_0_7100_engine1;
	spriteset_steam_h__k__porter__inc_2_6_0_7100_engine2;
}
switch(FEAT_TRAINS, SELF, switch_steam_h__k__porter__inc_2_6_0_7100_position, position_in_vehid_chain % 2) {
	0: switch_steam_h__k__porter__inc_2_6_0_7100_animation;
	spriteset_steam_h__k__porter__inc_2_6_0_7100_tender;
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_steam_h__k__porter__inc_2_6_0_7100_visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/// Length
switch(FEAT_TRAINS, SELF, switch_steam_h__k__porter__inc_2_6_0_7100_length, position_in_vehid_chain % 2) {
    0: 5;
	4;
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_steam_h__k__porter__inc_2_6_0_7100_articulated, extra_callback_info1) {
    1: return item_steam_h__k__porter__inc_2_6_0_7100;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
