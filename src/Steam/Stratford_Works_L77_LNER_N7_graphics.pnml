// Template: TPL_03C

// PURCHASE
spriteset(spriteset_steam_stratford_works_l77_lner_n7_purchase, "gfx/steam/stratford_works_l77_lner_n7.png") {template_purchase(1, 96)}


// VEHICLE
/// Engine1
spriteset(spriteset_steam_stratford_works_l77_lner_n7_engine1, "gfx/steam/stratford_works_l77_lner_n7.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_steam_stratford_works_l77_lner_n7_engine2, "gfx/steam/stratford_works_l77_lner_n7.png") {template_2cc_engines_general(1, 32)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_steam_stratford_works_l77_lner_n7_animation, motion_counter % 2){
	0: spriteset_steam_stratford_works_l77_lner_n7_engine1;
	spriteset_steam_stratford_works_l77_lner_n7_engine2;
}