// VEHICLE
/// Engine1
spriteset(spriteset_steam_alco_baldwin_2_8_0_usatc_s160_engine1, "gfx/steam/alco_baldwin_2_8_0_usatc_s160.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_steam_alco_baldwin_2_8_0_usatc_s160_engine2, "gfx/steam/alco_baldwin_2_8_0_usatc_s160.png") {template_2cc_engines_general(1, 32)}


