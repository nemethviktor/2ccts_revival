// Template: TPL_03E

// PURCHASE
spriteset(spriteset_steam_nzr_4_6_4t_wab_purchase, "gfx/steam/nzr_4_6_4t_wab.png") {template_purchase(1, 96)}


// VEHICLE
/// Engine1
spriteset(spriteset_steam_nzr_4_6_4t_wab_engine1, "gfx/steam/nzr_4_6_4t_wab.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_steam_nzr_4_6_4t_wab_engine2, "gfx/steam/nzr_4_6_4t_wab.png") {template_2cc_engines_general(1, 32)}


/// Tender
spriteset(spriteset_steam_nzr_4_6_4t_wab_tender, "gfx/steam/nzr_4_6_4t_wab.png") {template_2cc_engines_general(1, 64)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_steam_nzr_4_6_4t_wab_animation, motion_counter % 2){
	0: spriteset_steam_nzr_4_6_4t_wab_engine1;
	spriteset_steam_nzr_4_6_4t_wab_engine2;
}