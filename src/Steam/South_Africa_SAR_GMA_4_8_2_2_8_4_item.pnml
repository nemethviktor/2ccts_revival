// Notes:
//// TE_STARTING_KN: 430 -- Gemini suggested -> Garratt (like the GMA) is an articulated locomotive. It has two independent engine units under one boiler thus use this rather than 270kN


item(FEAT_TRAINS, item_steam_south_africa_sar_gma_4_8_2_2_8_4) {
    property {
        name: string(str_steam_south_africa_sar_gma_4_8_2_2_8_4);
        climates_available: ((param_region_africa || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1953,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 40/2 : (param_loadingspeed == 2) ? 40*2 : 40;
        cost_factor: 74.61188;
        running_cost_factor: 50.09639;
        speed: 85 km/h;
        power: 2500 hp;
        cargo_capacity: 0;
        weight: 241 ton;
        tractive_effort_coefficient: 0.182;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER;
        track_type: [NARROW_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_STEAM;
        engine_class: ENGINE_CLASS_STEAM;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["power/steam", "flag/ZA"];

    }
    graphics {
        purchase: spriteset_steam_south_africa_sar_gma_4_8_2_2_8_4_purchase;
        visual_effect_and_powered: switch_steam_south_africa_sar_gma_4_8_2_2_8_4_visual_effect;
        length: switch_steam_south_africa_sar_gma_4_8_2_2_8_4_length;
        articulated_part: switch_steam_south_africa_sar_gma_4_8_2_2_8_4_articulated;
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_steam_south_africa_sar_gma_4_8_2_2_8_4_position;
    }
}
