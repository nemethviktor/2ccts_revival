// Template: TPL_03C

// PURCHASE
spriteset(spriteset_steam_chile_anglo_chilean_nitrate_no_97_purchase, "gfx/steam/chile_anglo_chilean_nitrate_no_97.png") {template_purchase(1, 96)}


// VEHICLE
/// Engine1
spriteset(spriteset_steam_chile_anglo_chilean_nitrate_no_97_engine1, "gfx/steam/chile_anglo_chilean_nitrate_no_97.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_steam_chile_anglo_chilean_nitrate_no_97_engine2, "gfx/steam/chile_anglo_chilean_nitrate_no_97.png") {template_2cc_engines_general(1, 32)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_steam_chile_anglo_chilean_nitrate_no_97_animation, motion_counter % 2){
	0: spriteset_steam_chile_anglo_chilean_nitrate_no_97_engine1;
	spriteset_steam_chile_anglo_chilean_nitrate_no_97_engine2;
}