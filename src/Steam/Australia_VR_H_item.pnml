    property {
        name: string(str_steam_australia_vr_h);
        climates_available: ((param_region_oceania || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1941,1,1);
        model_life: 45;
        vehicle_life: 30;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 86.47042;
        running_cost_factor: 60.09447;
        speed: 80 km/h;
        power: 3600 hp;
        cargo_capacity: 0;
        weight: 260 ton;
        tractive_effort_coefficient: 0.096;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [BROAD_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_STEAM;
        engine_class: ENGINE_CLASS_STEAM;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 7;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/oceania", "flag/AU", "power/steam", "role/heavy_freight"];

    }
    graphics {
        purchase: spriteset_steam_australia_vr_h_purchase;
        visual_effect_and_powered: switch_steam_australia_vr_h_visual_effect;
        length: switch_steam_australia_vr_h_length;
        articulated_part: switch_steam_australia_vr_h_articulated;
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_steam_australia_vr_h_position;
    }
