// Template: TPL_03E

// PURCHASE
spriteset(spriteset_steam_south_africa_harbour_board_el_0_4_0_purchase, "gfx/steam/south_africa_harbour_board_el_0_4_0.png") {template_purchase(1, 96)}


// VEHICLE
/// Engine1
spriteset(spriteset_steam_south_africa_harbour_board_el_0_4_0_engine1, "gfx/steam/south_africa_harbour_board_el_0_4_0.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_steam_south_africa_harbour_board_el_0_4_0_engine2, "gfx/steam/south_africa_harbour_board_el_0_4_0.png") {template_2cc_engines_general(1, 32)}


/// Tender
spriteset(spriteset_steam_south_africa_harbour_board_el_0_4_0_tender, "gfx/steam/south_africa_harbour_board_el_0_4_0.png") {template_2cc_engines_general(1, 64)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_steam_south_africa_harbour_board_el_0_4_0_animation, motion_counter % 2){
	0: spriteset_steam_south_africa_harbour_board_el_0_4_0_engine1;
	spriteset_steam_south_africa_harbour_board_el_0_4_0_engine2;
}