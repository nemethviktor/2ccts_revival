/*
* PURCHASE
*/

spriteset(spriteset_steam_Ireland_GS_WR_101_purchase, "gfx/Steam/Ireland_GS_WR_101.png") {
	template_purchase(1, 96)
}

/*
* VEHICLE
*/

//Engine
spriteset(spriteset_steam_Ireland_GS_WR_101_engine1, "gfx/Steam/Ireland_GS_WR_101.png") {
	template_2cc_engines_general(1, 1)
}

spriteset(spriteset_steam_Ireland_GS_WR_101_engine2, "gfx/Steam/Ireland_GS_WR_101.png") {
	template_2cc_engines_general(1, 32)
}

//Tender
spriteset(spriteset_steam_Ireland_GS_WR_101_tender, "gfx/Steam/Ireland_GS_WR_101.png") {
	template_2cc_engines_general(1, 64)
}

//Animation states
switch(FEAT_TRAINS, SELF, switch_steam_Ireland_GS_WR_101_animation, motion_counter % 2){
	0: spriteset_steam_Ireland_GS_WR_101_engine1;
	spriteset_steam_Ireland_GS_WR_101_engine2;
}

switch(FEAT_TRAINS, SELF, switch_steam_Ireland_GS_WR_101_position, position_in_vehid_chain % 2) {
	0: switch_steam_Ireland_GS_WR_101_animation;
	spriteset_steam_Ireland_GS_WR_101_tender;
}

/*
* Visual effect
*/

switch(FEAT_TRAINS, SELF, switch_steam_Ireland_GS_WR_101_visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

switch(FEAT_TRAINS, SELF, switch_steam_Ireland_GS_WR_101_length, position_in_vehid_chain % 2) {
	0: 5;
	3;
}

switch(FEAT_TRAINS, SELF, switch_steam_Ireland_GS_WR_101_articulated, extra_callback_info1) {
	1: return item_steam_Ireland_GS_WR_101;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

//Add defined switches

RUNNINGCOST_ENGINE_SWITCH

PURCHASETEXT_SWITCH