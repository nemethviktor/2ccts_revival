        introduction_date: date(1893,1,1);
        model_life: 45;
        vehicle_life: 36;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 17.31904;
        running_cost_factor: 13.8094;
        speed: 48 km/h;
        power: 186 hp;
        cargo_capacity: 0;
        weight: 32 ton;
        tractive_effort_coefficient: 0.153;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [NARROW_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_STEAM;
        engine_class: ENGINE_CLASS_STEAM;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 5;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/asia", "power/steam", "role/shunting"];

    }
    graphics {
        purchase: spriteset_steam_richard_francis_trevithick_2_4_2t_860_purchase;
        // no 'visual_effect' or 'visual_effect_and_powered'
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_steam_richard_francis_trevithick_2_4_2t_860_animation;
    }
