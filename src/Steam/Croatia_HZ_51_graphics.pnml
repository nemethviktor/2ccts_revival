// Template: TPL_03C

// PURCHASE
spriteset(spriteset_steam_croatia_hz_51_purchase, "gfx/steam/croatia_hz_51.png") {template_purchase(1, 96)}


// VEHICLE
/// Engine1
spriteset(spriteset_steam_croatia_hz_51_engine1, "gfx/steam/croatia_hz_51.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_steam_croatia_hz_51_engine2, "gfx/steam/croatia_hz_51.png") {template_2cc_engines_general(1, 32)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_steam_croatia_hz_51_animation, motion_counter % 2){
	0: spriteset_steam_croatia_hz_51_engine1;
	spriteset_steam_croatia_hz_51_engine2;
}