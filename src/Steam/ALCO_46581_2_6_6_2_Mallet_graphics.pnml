// Template: TPL_03A

// PURCHASE
spriteset(spriteset_steam_alco_46581_2_6_6_2_mallet_purchase, "gfx/steam/alco_46581_2_6_6_2_mallet.png") {template_purchase(1, 96)}


// VEHICLE
/// Engine1
spriteset(spriteset_steam_alco_46581_2_6_6_2_mallet_engine1, "gfx/steam/alco_46581_2_6_6_2_mallet.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_steam_alco_46581_2_6_6_2_mallet_engine2, "gfx/steam/alco_46581_2_6_6_2_mallet.png") {template_2cc_engines_general(1, 32)}


/// Tender
spriteset(spriteset_steam_alco_46581_2_6_6_2_mallet_tender, "gfx/steam/alco_46581_2_6_6_2_mallet.png") {template_2cc_engines_general(1, 64)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_steam_alco_46581_2_6_6_2_mallet_animation, motion_counter % 2){
	0: spriteset_steam_alco_46581_2_6_6_2_mallet_engine1;
	spriteset_steam_alco_46581_2_6_6_2_mallet_engine2;
}
switch(FEAT_TRAINS, SELF, switch_steam_alco_46581_2_6_6_2_mallet_position, position_in_vehid_chain % 2) {
	0: switch_steam_alco_46581_2_6_6_2_mallet_animation;
	spriteset_steam_alco_46581_2_6_6_2_mallet_tender;
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_steam_alco_46581_2_6_6_2_mallet_visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/// Length
switch(FEAT_TRAINS, SELF, switch_steam_alco_46581_2_6_6_2_mallet_length, position_in_vehid_chain % 2) {
    0: 8;
	5;
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_steam_alco_46581_2_6_6_2_mallet_articulated, extra_callback_info1) {
    1: return item_steam_alco_46581_2_6_6_2_mallet;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
