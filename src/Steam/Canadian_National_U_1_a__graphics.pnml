// Template: TPL_03A

// PURCHASE
spriteset(spriteset_steam_canadian_national_u_1_a__purchase, "gfx/steam/canadian_national_u_1_a_.png") {template_purchase(1, 96)}


// VEHICLE
/// Engine1
spriteset(spriteset_steam_canadian_national_u_1_a__engine1, "gfx/steam/canadian_national_u_1_a_.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_steam_canadian_national_u_1_a__engine2, "gfx/steam/canadian_national_u_1_a_.png") {template_2cc_engines_general(1, 32)}


/// Tender
spriteset(spriteset_steam_canadian_national_u_1_a__tender, "gfx/steam/canadian_national_u_1_a_.png") {template_2cc_engines_general(1, 64)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_steam_canadian_national_u_1_a__animation, motion_counter % 2){
	0: spriteset_steam_canadian_national_u_1_a__engine1;
	spriteset_steam_canadian_national_u_1_a__engine2;
}
switch(FEAT_TRAINS, SELF, switch_steam_canadian_national_u_1_a__position, position_in_vehid_chain % 2) {
	0: switch_steam_canadian_national_u_1_a__animation;
	spriteset_steam_canadian_national_u_1_a__tender;
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_steam_canadian_national_u_1_a__visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/// Length
switch(FEAT_TRAINS, SELF, switch_steam_canadian_national_u_1_a__length, position_in_vehid_chain % 2) {
    0: 8;
	6;
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_steam_canadian_national_u_1_a__articulated, extra_callback_info1) {
    1: return item_steam_canadian_national_u_1_a_;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
