// Template: TPL_03C

// PURCHASE
spriteset(spriteset_steam_uk_caledonian_railway_439_purchase, "gfx/steam/uk_caledonian_railway_439.png") {template_purchase(1, 96)}


// VEHICLE
/// Engine1
spriteset(spriteset_steam_uk_caledonian_railway_439_engine1, "gfx/steam/uk_caledonian_railway_439.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_steam_uk_caledonian_railway_439_engine2, "gfx/steam/uk_caledonian_railway_439.png") {template_2cc_engines_general(1, 32)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_steam_uk_caledonian_railway_439_animation, motion_counter % 2){
	0: spriteset_steam_uk_caledonian_railway_439_engine1;
	spriteset_steam_uk_caledonian_railway_439_engine2;
}