        speed: 80 km/h;
        power: 875 hp;
        cargo_capacity: 0;
        weight: 83 ton;
        tractive_effort_coefficient: 0.171;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
