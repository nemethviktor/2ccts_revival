// Template: TPL_03C

// PURCHASE
spriteset(spriteset_steam_australia_nsw_n67_0_6_0t_terrier_purchase, "gfx/steam/australia_nsw_n67_0_6_0t_terrier.png") {template_purchase(1, 96)}


// VEHICLE
/// Engine1
spriteset(spriteset_steam_australia_nsw_n67_0_6_0t_terrier_engine1, "gfx/steam/australia_nsw_n67_0_6_0t_terrier.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_steam_australia_nsw_n67_0_6_0t_terrier_engine2, "gfx/steam/australia_nsw_n67_0_6_0t_terrier.png") {template_2cc_engines_general(1, 32)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_steam_australia_nsw_n67_0_6_0t_terrier_animation, motion_counter % 2){
	0: spriteset_steam_australia_nsw_n67_0_6_0t_terrier_engine1;
	spriteset_steam_australia_nsw_n67_0_6_0t_terrier_engine2;
}