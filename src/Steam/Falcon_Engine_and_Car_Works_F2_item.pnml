    property {
        name: string(str_steam_falcon_engine_and_car_works_f2);
        climates_available: ((param_region_africa || 0) && 1) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(1895,1,1);
        model_life: 45;
        vehicle_life: 40;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 13.22831;
        running_cost_factor: 11.00922;
        speed: 30 km/h;
        power: 120 hp;
        cargo_capacity: 0;
        weight: 20 ton;
        tractive_effort_coefficient: 0.066;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: NONE;
        refittable_cargo_classes: bitmask(NO_CARGO_CLASS);
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [NARROW_GAUGE_RAILTYPE_NONE];
        running_cost_base: RUNNING_COST_STEAM;
        engine_class: ENGINE_CLASS_STEAM;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_STEAM, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 0;
        length: 4;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/africa", "power/steam", "role/shunting"];

    }
    graphics {
        purchase: spriteset_steam_falcon_engine_and_car_works_f2_purchase;
        visual_effect_and_powered: switch_steam_falcon_engine_and_car_works_f2_visual_effect;
        length: switch_steam_falcon_engine_and_car_works_f2_length;
        articulated_part: switch_steam_falcon_engine_and_car_works_f2_articulated;
        can_attach_wagon: switch_can_attach_vehicle;
        default: switch_steam_falcon_engine_and_car_works_f2_position;
    }
}
