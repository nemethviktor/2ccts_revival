// Template: TPL_03E

// PURCHASE
spriteset(spriteset_steam_eritrea_eritrean_railway_r440_purchase, "gfx/steam/eritrea_eritrean_railway_r440.png") {template_purchase(1, 96)}


// VEHICLE
/// Engine1
spriteset(spriteset_steam_eritrea_eritrean_railway_r440_engine1, "gfx/steam/eritrea_eritrean_railway_r440.png") {template_2cc_engines_general(1, 1)}


/// Engine2
spriteset(spriteset_steam_eritrea_eritrean_railway_r440_engine2, "gfx/steam/eritrea_eritrean_railway_r440.png") {template_2cc_engines_general(1, 32)}


/// Tender
spriteset(spriteset_steam_eritrea_eritrean_railway_r440_tender, "gfx/steam/eritrea_eritrean_railway_r440.png") {template_2cc_engines_general(1, 64)}


/// Animation states (animation)
switch(FEAT_TRAINS, SELF, switch_steam_eritrea_eritrean_railway_r440_animation, motion_counter % 2){
	0: spriteset_steam_eritrea_eritrean_railway_r440_engine1;
	spriteset_steam_eritrea_eritrean_railway_r440_engine2;
}