// PURCHASE
spriteset(spriteset_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_purchase, "gfx/steam/beyer__p___co__4_8_2_2_8_4_7550_7552.png") {template_purchase(1, 160)}


/// Front1
spriteset(spriteset_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_front1, "gfx/steam/beyer__p___co__4_8_2_2_8_4_7550_7552.png") {template_2cc_engines_general(1, 1)}


/// Front2
spriteset(spriteset_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_front2, "gfx/steam/beyer__p___co__4_8_2_2_8_4_7550_7552.png") {template_2cc_engines_general(1, 32)}


/// Middle
spriteset(spriteset_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_middle, "gfx/steam/beyer__p___co__4_8_2_2_8_4_7550_7552.png") {template_2cc_engines_general(1, 64)}


/// Back1
spriteset(spriteset_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_back1, "gfx/steam/beyer__p___co__4_8_2_2_8_4_7550_7552.png") {template_2cc_engines_general(1, 96)}


/// Back2
spriteset(spriteset_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_back2, "gfx/steam/beyer__p___co__4_8_2_2_8_4_7550_7552.png") {template_2cc_engines_general(1, 128)}


/// Animation states (animation_front)
switch(FEAT_TRAINS, SELF, switch_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_animation_front, motion_counter % 2){
	0: spriteset_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_front1;
	spriteset_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_front2;
}

/// Animation states (animation_back)
switch(FEAT_TRAINS, SELF, switch_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_animation_back, motion_counter % 2){
	0: spriteset_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_back1;
	spriteset_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_back2;
}
switch(FEAT_TRAINS, SELF, switch_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_position, position_in_vehid_chain % 3) {
	0: switch_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_animation_front;
	1: spriteset_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_middle;
	switch_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_animation_back;
}

/// Visual Effect
switch(FEAT_TRAINS, SELF, switch_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_visual_effect, position_in_vehid_chain % 3) {
	1: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

/// Length
switch(FEAT_TRAINS, SELF, switch_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_length, position_in_vehid_chain % 3) {
    2: 5;
	4;
}

/// Articulated Return
/// extra_callback_info1 is the index of the part being added.
switch(FEAT_TRAINS, SELF, switch_steam_beyer__p___co__4_8_2_2_8_4_7550_7552_articulated, extra_callback_info1) {
    1..2: return item_steam_beyer__p___co__4_8_2_2_8_4_7550_7552;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}
