/*
* PURCHASE
*/

spriteset(spriteset_steam_Albania_HSH_01_purchase, "gfx/Steam/Albania_HSH_01.png") {
	template_purchase(1, 96)
}

/*
* VEHICLE
*/

//Engine
spriteset(spriteset_steam_Albania_HSH_01_engine1, "gfx/Steam/Albania_HSH_01.png") {
	template_2cc_engines_general(1, 1)
}

spriteset(spriteset_steam_Albania_HSH_01_engine2, "gfx/Steam/Albania_HSH_01.png") {
	template_2cc_engines_general(1, 32)
}

//Tender
spriteset(spriteset_steam_Albania_HSH_01_tender, "gfx/Steam/Albania_HSH_01.png") {
	template_2cc_engines_general(1, 64)
}

//Animation states
switch(FEAT_TRAINS, SELF, switch_steam_Albania_HSH_01_animation, motion_counter % 2){
	0: spriteset_steam_Albania_HSH_01_engine1;
	spriteset_steam_Albania_HSH_01_engine2;
}

//Add defined switches

RUNNINGCOSTENGINESWITCH

PURCHASETEXTSWITCH