/*
* PURCHASE
*/

spriteset(spriteset_steam_Denmark_DSB_E_purchase, "gfx/Steam/Denmark_DSB_E.png") {
	template_purchase(1, 96)
}

/*
* VEHICLE
*/

//Engine
spriteset(spriteset_steam_Denmark_DSB_E_engine1, "gfx/Steam/Denmark_DSB_E.png") {
	template_2cc_engines_general(1, 1)
}

spriteset(spriteset_steam_Denmark_DSB_E_engine2, "gfx/Steam/Denmark_DSB_E.png") {
	template_2cc_engines_general(1, 32)
}

//Tender
spriteset(spriteset_steam_Denmark_DSB_E_tender, "gfx/Steam/Denmark_DSB_E.png") {
	template_2cc_engines_general(1, 64)
}

//Animation states
switch(FEAT_TRAINS, SELF, switch_steam_Denmark_DSB_E_animation, motion_counter % 2){
	0: spriteset_steam_Denmark_DSB_E_engine1;
	spriteset_steam_Denmark_DSB_E_engine2;
}

switch(FEAT_TRAINS, SELF, switch_steam_Denmark_DSB_E_position, position_in_vehid_chain % 2) {
	0: switch_steam_Denmark_DSB_E_animation;
	spriteset_steam_Denmark_DSB_E_tender;
}

/*
* Visual effect
*/

switch(FEAT_TRAINS, SELF, switch_steam_Denmark_DSB_E_visual_effect, position_in_vehid_chain % 2) {
	0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
	return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
}

switch(FEAT_TRAINS, SELF, switch_steam_Denmark_DSB_E_length, position_in_vehid_chain % 2) {
	0: 8;
	4;
}

switch(FEAT_TRAINS, SELF, switch_steam_Denmark_DSB_E_articulated, extra_callback_info1) {
	1: return item_steam_Denmark_DSB_E;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

//Add defined switches

RUNNINGCOST_ENGINE_SWITCH

PURCHASETEXT_SWITCH