item(FEAT_TRAINS, item_cargoemu_netherlands_acme_cargodd) {
    property {
        name: string(str_cargoemu_netherlands_acme_cargodd);
        climates_available: (((param_region_africa || (param_region_north_america || param_region_south_america) || param_region_asia || (param_region_northern_europe || param_region_eastern_europe || param_region_southern_europe || param_region_western_europe) || param_region_oceania) || 0) && param_concept) ? ALL_CLIMATES : NO_CLIMATE;
        introduction_date: date(2045,1,1);
        model_life: VEHICLE_NEVER_EXPIRES;
        vehicle_life: 45;
        retire_early: 20;
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        cost_factor: 106.5517;
        running_cost_factor: 90.85798;
        speed: 300 km/h;
        power: 7457 hp;
        cargo_capacity: 60;
        weight: 150 ton;
        tractive_effort_coefficient: 0.075;
        air_drag_coefficient: 0;

        reliability_decay: 20;
        // cargodeftype: CONTAINER;
        refittable_cargo_classes: bitmask(CC_PIECE_GOODS, CC_EXPRESS, CC_REFRIGERATED, CC_POTABLE);
        non_refittable_cargo_classes: 0;
        cargo_allow_refit: [GOOD, PAPR, FOOD, RUBR, FRUT, WATR, TOYS, BATT, SWET, COLA, BUBL, PLST, FZDR, BEER, BDMT, BRCK, CERA, CERE, COPR, DYES, ENSP, FERT, FICR, FISH, FMSP, GLAS, JAVA, MILK, MNSP, PETR, PLAS, RCYC, RFPR, VPTS, WDPR, WOOL, URAN];
        cargo_disallow_refit: [PASS, MAIL, TOUR, COAL, OIL_, LVST, GRAI, WOOD, IORE, STEL, VALU, WHEA, GOLD, MAIZ, CORE, DIAM, SUGR, TOFF, CTCD, AORE, CLAY, CMNT, GRVL, LIME, OLSD, POTA, SAND, SCMT, SGBT, SGCN, SULP, VEHI, YETI, YETY];
        
        cargo_age_period: 185;
        misc_flags: bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU);
        refit_cost: 0;
        ai_special_flag: AI_FLAG_PASSENGER | AI_FLAG_CARGO;
        track_type: [STANDARD_GAUGE_RAILTYPE_OHLE];
        running_cost_base: RUNNING_COST_ELECTRIC;
        engine_class: ENGINE_CLASS_ELECTRIC;
        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 0, DISABLE_WAGON_POWER);

        sprite_id: SPRITE_ID_NEW_TRAIN;
        dual_headed: 1;
        length: 8;
        extra_power_per_wagon: 0;
        bitmask_vehicle_info: 0;

	badges: ["region/africa", "region/asia", "region/america/northern", "region/america/south", "region/europe/southern", "region/europe/western", "region/europe/eastern", "region/europe/northern", "region/oceania", "flag/NL", "power/electric", "role/freight"];

    }
    graphics {
        purchase: spriteset_cargoemu_netherlands_acme_cargodd_purchase;
        visual_effect_and_powered: switch_cargoemu_netherlands_acme_cargodd_visual_effect_and_powered;
        // no 'length'
        // no 'articulated_part'
        can_attach_wagon: switch_can_attach_vehicle;
        // Add calls to defined switches below
        // RUNNINGCOST_ENGINE_SWITCH_CALL // this is actually blank
        // PURCHASETEXT_SWITCH_CALL // this is actually blank
        default: switch_cargoemu_netherlands_acme_cargodd_reversed;
    }
    livery_override (item_mu_mu_cargo_wagon_unpowered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        running_cost_factor: int(300/10);
        weight: int(150*1/2);
        cargo_capacity: 60;
        length: 8;
        default: switch_cargoemu_netherlands_acme_cargodd_middle_livery;
    }
    livery_override (item_mu_mu_cargo_wagon_powered) {
        loading_speed: isUltraSpeed ? 255 : (param_loadingspeed == 0) ? 20/2 : (param_loadingspeed == 2) ? 20*2 : 20;
        running_cost_factor: (round(49.89128677913821));
        power: int(7457*1/2);
        weight: int(150*3/4);
        cargo_capacity: 60;
        tractive_effort_coefficient: int(0.075*10*150);
        length: 8;
        default: switch_cargoemu_netherlands_acme_cargodd_middle_livery;
    }
}
