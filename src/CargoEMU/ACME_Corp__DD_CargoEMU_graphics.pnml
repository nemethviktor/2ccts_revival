// Template: TPL_42C

// PURCHASE
spriteset(spriteset_cargoemu_acme_corp__dd_cargoemu_purchase, "gfx/cargoemu/acme_corp__dd_cargoemu.png") {template_purchase_dualheaded(1, 192)}


// Front

/// FRONT   LIVERY 1   LOADING STATE 1
spriteset(spriteset_cargoemu_acme_corp__dd_cargoemu_front_l1_s1, "gfx/cargoemu/acme_corp__dd_cargoemu.png") {template_2cc_engines_general(1, 1)}


/// FRONT   LIVERY 1   LOADING STATE 2
spriteset(spriteset_cargoemu_acme_corp__dd_cargoemu_front_l1_s2, "gfx/cargoemu/acme_corp__dd_cargoemu.png") {template_2cc_engines_general(178, 1)}


/// FRONT   LIVERY 1   LOADING STATE 3
spriteset(spriteset_cargoemu_acme_corp__dd_cargoemu_front_l1_s3, "gfx/cargoemu/acme_corp__dd_cargoemu.png") {template_2cc_engines_general(356, 1)}


/// LIVERY 1 SPRITEGROUP - FRONT
spritegroup spritegroup_cargoemu_acme_corp__dd_cargoemu_front_l1 {
    loading: [spriteset_cargoemu_acme_corp__dd_cargoemu_front_l1_s1, spriteset_cargoemu_acme_corp__dd_cargoemu_front_l1_s2, spriteset_cargoemu_acme_corp__dd_cargoemu_front_l1_s3];
    loaded: [spriteset_cargoemu_acme_corp__dd_cargoemu_front_l1_s1, spriteset_cargoemu_acme_corp__dd_cargoemu_front_l1_s2, spriteset_cargoemu_acme_corp__dd_cargoemu_front_l1_s3];
}

// Random Livery Selector for front
random_switch(FEAT_TRAINS, SELF, switch_cargoemu_acme_corp__dd_cargoemu_front_livery) {
	10: spritegroup_cargoemu_acme_corp__dd_cargoemu_front_l1;
}

