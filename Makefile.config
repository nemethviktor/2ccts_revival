# Definition of the grfs
REPO_NAME           ?= 2cc Trains Revival

# This is the filename part common to the grf file, main source file and the tar name
BASE_FILENAME       ?= 2ccts_revival

# Documentation files (none in this repo -> 'doc' becomes a no-op)
DOC_FILES =

# ---------------------------------------------------------------------------
# Version info. findversion.sh was replaced by tools/version_info.py, which
# writes custom_tags.txt. Define the five fields the framework expects instead
# of round-tripping them through VERSION_INFO + cut.
# ---------------------------------------------------------------------------
REPO_HASH           ?= $(shell git rev-parse HEAD)
NEWGRF_VERSION      ?= $(shell sed -n 's/^NEWGRF_VERSION[[:space:]]*:\([0-9]*\).*/\1/p' custom_tags.txt)
REPO_MODIFIED       =
REPO_TAGS           =
REPO_VERSION_STRING ?= $(shell git describe --tags --dirty --always | sed 's/-dirty/_dirty/')

# Possible offset to NewGRF version. Increase by one, if a release
# branch is added to the repository
REPO_BRANCH_VERSION ?= 0

# Directory structure
SCRIPT_DIR          ?= scripts

# Uncomment in order to make use of gimp scripting. See the file
# for a description of the format
# GFX_SCRIPT_LIST_FILES      := gfx/png_source_list

# If needed, declare the minimum NML requirements
# REQUIRED_NML_BRANCH  = 0.3
# MIN_NML_REVISION     = 0

# The 'lng' target regenerates custom_tags.txt and would overwrite what
# tools.build wrote. Emptying this keeps the py-generated file; run
# `make lng` explicitly if you ever want it regenerated.
GENERATE_LNG =

# Same invocation as pybuild_deb.sh, minus --quiet so warnings stay visible.
NML_FLAGS ?= -c -t custom_tags.txt